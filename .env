# =============================================================================
# Ambiente para Docker Compose - Render RH (servidor real)
# Edite os valores abaixo antes de rodar: docker compose up -d
# NUNCA commite credenciais reais - use apenas placeholders em commits
# =============================================================================

# --- ECR / Imagens Docker ---
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
IMAGE_TAG=latest

# --- API (.NET) - ConnectionStrings (formato Npgsql) ---
ConnectionStrings__Default=Host=SEU_HOST;Port=5432;Database=bddev;Username=SEU_USER;Password=SEU_PASSWORD
ConnectionStrings__Master=Host=SEU_HOST;Port=5432;Database=dev_render;Username=SEU_USER;Password=SEU_PASSWORD
ConnectionStrings__TenantTemplate=Host=SEU_HOST;Port=5432;Database=dev_render_{0};Username=SEU_USER;Password=SEU_PASSWORD

# --- API - CORS (Web roda no S3/CloudFront) ---
Cors__AllowAny=false
Cors__WebOrigin=https://seu-dominio.cloudfront.net

# --- API - Ambiente ---
ASPNETCORE_ENVIRONMENT=Production

# --- AI (Python) - PostgreSQL ---
DATABASE_URL=postgresql://SEU_USER:SEU_PASSWORD@SEU_HOST:5432/dev_render
TENANT_DATABASE_TEMPLATE=postgresql://SEU_USER:SEU_PASSWORD@SEU_HOST:5432/dev_render_{0}

# --- OpenAI (obrigatório para o serviço AI) ---
OPENAI_API_KEY=sk-...

# --- Web Next (se rodar em container; no S3 é configurado em build) ---
NEXT_PUBLIC_API_URL=http://localhost:5000
LEGACY_ORIGIN=
