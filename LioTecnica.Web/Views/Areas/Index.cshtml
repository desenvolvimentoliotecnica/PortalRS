@model PageSeedViewModel
@{
    ViewData["Title"] = "Portal RH - Liotecnica - Areas";
    ViewData["SidebarSubtitle"] = "Areas";
}

@await Html.PartialAsync("_ModalArea")
@await Html.PartialAsync("_ModalAreaVagas")
@await Html.PartialAsync("_Toast")

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", (string)null)

    <div class="searchbox position-relative d-none d-md-block">
      <i class="bi bi-search"></i>
      <input id="globalSearchArea" class="form-control" placeholder="Buscar area..." />
    </div>

    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-ghost" type="button" id="btnOrgChart" title="Estrutura organizacional">
        <i class="bi bi-diagram-3"></i><span class="d-none d-sm-inline ms-1">Estrutura organizacional</span>
      </button>
      <button class="btn btn-ghost" type="button" id="btnExportArea" title="Exportar areas (CSV)">
        <i class="bi bi-filetype-csv"></i><span class="d-none d-sm-inline ms-1">Exportar</span>
      </button>
      <button class="btn btn-ghost" type="button" id="btnSeedReset" title="Recarregar dados">
        <i class="bi bi-arrow-counterclockwise"></i><span class="d-none d-sm-inline ms-1">Atualizar</span>
      </button>
      <button class="btn btn-brand" type="button" id="btnNewArea">
        <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline ms-1">Nova area</span>
      </button>
      @await Html.PartialAsync("_TopbarUserActions", "RH")
    </div>
}

<section class="content">
  <div class="page-title">
    <div>
      <h4>Areas</h4>
      <div class="subtitle">Gerencie areas usadas em vagas, departamentos e gestores.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge-soft"><i class="bi bi-clock me-1"></i><span id="nowLabel">-</span></span>
      <span class="badge-soft"><i class="bi bi-hdd me-1"></i>API</span>
    </div>
  </div>

  @{
    var kpis = new[]
    {
      new { ColClass = "col-6 col-lg-3", Title = "Areas", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiAreaTotal", Value = "0", PillIcon = "bi-diagram-2", PillText = "total", Hint = "Areas cadastradas." },
      new { ColClass = "col-6 col-lg-3", Title = "Ativas", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiAreaActive", Value = "0", PillIcon = "bi-check2-circle", PillText = "ativo", Hint = "Areas em operacao." },
      new { ColClass = "col-6 col-lg-3", Title = "Vagas abertas", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiAreaOpenRoles", Value = "0", PillIcon = "bi-briefcase", PillText = "abertas", Hint = "Total de vagas abertas." },
      new { ColClass = "col-6 col-lg-3", Title = "Vagas total", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiAreaTotalRoles", Value = "0", PillIcon = "bi-collection", PillText = "vagas", Hint = "Total de vagas cadastradas." }
    };
  }
  @await Html.PartialAsync("_KpiMiniRow", kpis)

  <div class="card-soft p-3 mb-3">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2">
      <div>
        <div class="fw-bold">Lista de areas</div>
        <div class="text-muted small">Clique em uma area para ver vagas relacionadas.</div>
      </div>
      <div class="d-flex flex-wrap gap-2 justify-content-end">
        <div style="min-width:240px;">
          <label class="form-label small mb-1">Buscar</label>
          <div class="input-group">
            <span class="input-group-text" style="background:rgba(255,255,255,.65)"><i class="bi bi-search"></i></span>
            <input class="form-control" id="aSearch" placeholder="nome, codigo...">
          </div>
        </div>
        <div>
          <label class="form-label small mb-1">Status</label>
          <select class="form-select" id="aStatus">
            <option value="all">Todos</option>
            <option value="ativo">Ativo</option>
            <option value="inativo">Inativo</option>
          </select>
        </div>
      </div>
    </div>

    <hr class="my-3 divider">

        <div class="table-responsive">
  <table class="table table-sm align-middle mb-0">
    <thead>
<tr>
          <th>Area</th>
          <th>Area pai</th>
          <th>Dono</th>
          <th>Status</th>
          <th>Vagas</th>
          <th>Descricao</th>
          <th class="text-end">Acoes</th>
        </tr>
    </thead>
    <tbody id="areaTbody"></tbody>
  </table>
</div>

    <div class="d-flex align-items-center justify-content-between mt-2">
      <div class="text-muted small" id="areaHint">-</div>
      <div class="d-flex align-items-center gap-2">
        <span class="pill"><i class="bi bi-table"></i><span id="areaCount">0</span> exibidas</span>
      </div>
    </div>
  </div>

  <template id="tpl-area-row">
    <tr>
      <td>
        <div class="d-flex align-items-center">
          <button type="button" class="btn btn-ghost btn-sm p-0 me-1 area-tree-toggle" data-role="area-toggle" aria-label="Expandir/colapsar" style="width:1.5rem;visibility:hidden;" title="Expandir/colapsar"></button>
          <div class="area-tree-label">
            <div class="fw-semibold" data-role="area-name"></div>
            <div class="text-muted small" data-role="area-code"></div>
          </div>
        </div>
      </td>
      <td data-role="area-parent"></td>
      <td data-role="area-owner"></td>
      <td><span data-role="area-status-host"></span></td>
      <td class="mono" data-role="area-vagas"></td>
      <td data-role="area-desc"></td>
      <td class="text-end">
        <button class="btn btn-ghost btn-sm me-1" type="button" data-act="detail">
          <i class="bi bi-eye"></i>
        </button>
        <button class="btn btn-ghost btn-sm me-1" type="button" data-act="edit">
          <i class="bi bi-pencil"></i>
        </button>
        <button class="btn btn-ghost btn-sm text-danger" type="button" data-act="del">
          <i class="bi bi-trash3"></i>
        </button>
      </td>
    </tr>
  </template>

  <template id="tpl-area-empty-row">
    <tr>
      <td colspan="7" class="text-center text-muted py-3">Nenhuma area encontrada.</td>
    </tr>
  </template>

  <div style="height:14px;"></div>
</section>

<div class="modal fade" id="modalOrgChart" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content" style="border-radius: 18px; border: 1px solid var(--lt-border);">
      <div class="modal-header">
        <div>
          <h5 class="modal-title fw-bold">Estrutura organizacional</h5>
          <div class="text-muted small">Visualize a hierarquia por area ou por donos das areas.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <ul class="nav nav-tabs mb-3" id="orgChartTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-org-area" data-bs-toggle="tab" data-bs-target="#panel-org-area" type="button" role="tab">Por area</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-org-donos" data-bs-toggle="tab" data-bs-target="#panel-org-donos" type="button" role="tab">Por donos</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-org-flow" data-bs-toggle="tab" data-bs-target="#panel-org-flow" type="button" role="tab">Fluxo</button>
          </li>
        </ul>
        <div class="tab-content" id="orgChartTabContent">
          <div class="tab-pane fade show active" id="panel-org-area" role="tabpanel">
            <div id="orgChartContainerArea" class="org-chart-container bg-light rounded p-3" style="min-height: 400px;"></div>
          </div>
          <div class="tab-pane fade" id="panel-org-donos" role="tabpanel">
            <div id="orgChartContainerDonos" class="org-chart-container bg-light rounded p-3" style="min-height: 400px;"></div>
          </div>
          <div class="tab-pane fade" id="panel-org-flow" role="tabpanel">
            <div id="orgChartContainerFlow" class="org-chart-container bg-light rounded p-3" style="min-height: 400px;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

@section Footer {
  @{
    var footerItems = new[]
    {
      new { Icon = "bi-diagram-2", Text = "Areas", Id = "", Class = "" },
      new { Icon = "bi-shield-check", Text = "LGPD", Id = "", Class = "" },
      new { Icon = "", Text = "build: demo", Id = "buildId", Class = "mono muted" }
    };
  }
  @await Html.PartialAsync("_Footer", footerItems)
}

@section Scripts {
  <script>
    window.__managersApiUrl = "@Url.Content("~/api/lookup/managers")";
    window.__funcionariosApiUrl = "@Url.Content("~/api/lookup/funcionarios")";
  </script>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
  <script src="~/js/views/areas.js" asp-append-version="true"></script>
}

