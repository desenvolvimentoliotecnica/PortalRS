@model PageSeedViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject LioTecnica.Web.Infrastructure.Security.PortalTenantContext TenantContext
@{
    ViewData["Title"] = "Portal RH • Devcraft Studio • Entrada (Email/Pasta)";
    ViewData["SidebarSubtitle"] = "Entrada (Email/Pasta)";
}



<!-- MOBILE SIDEBAR OFFCANVAS -->
<!-- TOAST -->
@await Html.PartialAsync("_Toast")

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", (string)null)

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-ghost" type="button" id="btnRefresh" title="Atualizar dados">
            <i class="bi bi-arrow-counterclockwise"></i><span class="d-none d-sm-inline ms-1">Atualizar</span>
        </button>

        <button class="btn btn-ghost" type="button" id="btnExport" title="Exportar (JSON)">
            <i class="bi bi-download"></i><span class="d-none d-sm-inline ms-1">Exportar</span>
        </button>

        <button class="btn btn-ghost" type="button" id="btnImport" title="Importar (JSON)">
            <i class="bi bi-upload"></i><span class="d-none d-sm-inline ms-1">Importar</span>
        </button>

        <button class="btn btn-brand" type="button" id="btnRunSim">
            <i class="bi bi-play-circle"></i><span class="d-none d-sm-inline ms-1">Simular coleta</span>
        </button>

        @await Html.PartialAsync("_TopbarUserActions", "RH")
    </div>
}

<!-- CONTENT -->
<section class="content">
    <div class="page-title">
        <div>
            <h4>Entrada (Email / Pasta)</h4>
            <div class="subtitle">Central de ingestão: e-mails, pastas monitoradas e upload manual • tudo cai na fila de triagem.</div>
        </div>
    </div>

    <!-- KPIs -->
    @{
        var kpis = new[]
        {
        new { ColClass = "col-6 col-lg-3", Title = "Fila de Entrada", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiQueue", Value = "0", PillIcon = "bi-inbox", PillText = "itens", Hint = "Arquivos/e-mails aguardando processamento." },
        new { ColClass = "col-6 col-lg-3", Title = "Processados hoje", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiDone", Value = "0", PillIcon = "bi-check2-circle", PillText = "ok", Hint = "Ingestão completa com texto extraÃ­do." },
        new { ColClass = "col-6 col-lg-3", Title = "Falhas", ValueStyle = "font-size:1.6rem;color:rgba(153,19,34,.95);", ValueId = "kpiFail", Value = "0", PillIcon = "bi-exclamation-triangle", PillText = "atenção", Hint = "PDF corrompido, senha, anexos vazios, etc." },
        new { ColClass = "col-6 col-lg-3", Title = "Integrações", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiConnect", Value = "2", PillIcon = "bi-plug", PillText = "ativas", Hint = "Email IMAP + Pasta (watcher)." }
        };
    }
    @await Html.PartialAsync("_KpiMiniRow", kpis)

    <div class="d-grid gap-3">
        <!-- Upload / Dropzone -->
        <div class="card-soft p-3">
            <div class="d-flex align-items-start justify-content-between gap-2">
                <div>
                    <div class="fw-bold">Upload manual</div>
                    <div class="text-muted small">Arraste PDFs/DOCs aqui (demo salva apenas o nome do arquivo).</div>
                </div>
                <button class="btn btn-ghost btn-sm" id="btnAddUpload">
                    <i class="bi bi-paperclip me-1"></i>Selecionar arquivo
                </button>
            </div>

            <div class="dropzone mt-3" id="dropzone">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-cloud-arrow-up mt-1"></i>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">Solte seus arquivos aqui</div>
                        <div class="text-muted small">Tipos comuns: .pdf, .doc, .docx</div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <span class="chip"><i class="bi bi-file-earmark-pdf"></i>PDF</span>
                            <span class="chip"><i class="bi bi-file-earmark-word"></i>Word</span>
                            <span class="chip"><i class="bi bi-file-earmark-text"></i>TXT</span>
                            <span class="chip"><i class="bi bi-shield-check"></i>LGPD</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Queue -->
        <div class="card-soft p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <div class="fw-bold">Fila de entrada</div>
                    <div class="text-muted small">Selecione um item para ver detalhes e executar ações.</div>
                </div>
                <div class="d-flex gap-2 flex-wrap justify-content-end">
                    <div class="input-group" style="min-width: 240px;">
                        <span class="input-group-text" style="border-color:var(--lt-border); background: rgba(255,255,255,.65);">
                            <i class="bi bi-search"></i>
                        </span>
                        <input class="form-control" id="fSearch" placeholder="Remetente, assunto, arquivo..." style="border-color:var(--lt-border);">
                    </div>
                    <select class="form-select" id="fOrigem" data-enum="origemFilter" style="min-width: 180px; border-color:var(--lt-border);"></select>
                    <select class="form-select" id="fStatus" data-enum="inboxStatusFilter" style="min-width: 180px; border-color:var(--lt-border);"></select>
                </div>
            </div>

            <hr class="my-3" style="border-color: rgba(16,82,144,.14);">

            <lt-list class="d-grid gap-2" id="queueList"></lt-list>
            <div class="text-muted small mt-2" id="queueHint"></div>
        </div>

    </div>

    <div style="height:14px;"></div>
</section>

@section Footer {
    @{
        var footerItems = new[]
        {
            new { Icon = "bi-inbox", Text = "Entrada" },
            new { Icon = "bi-funnel", Text = "Triagem" },
            new { Icon = "bi-shield-check", Text = "LGPD" }
          };
    }
    @await Html.PartialAsync("_Footer", footerItems)
}



<!-- Hidden file input -->
<input type="file" id="filePicker" accept=".pdf,.doc,.docx,.txt" multiple style="display:none;">

<!-- Bootstrap JS (CDN) -->
@section Scripts {

    <script>
        window.__inboxHubUrl = "@((Configuration["Endpoints:RhApi"] ?? string.Empty).TrimEnd('/') + "/hubs/inbox")";
        window.__tenantId = "@(TenantContext.TenantId)";
    </script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/views/entrada-email-pasta.js" asp-append-version="true"></script>
}

<!-- Inbox detail modal -->
<div class="modal fade" id="inboxDetailModal" tabindex="-1" aria-labelledby="inboxDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 18px;">
            <div class="modal-header">
                <div>
                    <div class="small text-muted">Detalhe da entrada</div>
                    <h5 class="modal-title" id="inboxDetailLabel">Inbox</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div id="detailHost"></div>
            </div>
        </div>
    </div>
</div>



<style>
    .suggest-list {
        display: grid;
        gap: 8px;
    }

    .suggest-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 10px;
        border-radius: 12px;
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.08);
        transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
    }

        .suggest-item.is-assigned {
            background: #ecfff1;
            border-color: rgba(18, 140, 78, 0.25);
            box-shadow: 0 10px 24px rgba(18, 140, 78, 0.08);
            animation: suggestFall 420ms cubic-bezier(0.2, 0.8, 0.2, 1.2);
        }

            .suggest-item.is-assigned .badge {
                background: rgba(18, 140, 78, 0.12) !important;
                color: #0f7a45 !important;
            }

            .suggest-item.is-assigned .btn-link-suggested {
                cursor: default;
            }

    @@keyframes suggestFall {
        0% {
            transform: translateY(-6px) scale(0.98);
        }

        60% {
            transform: translateY(4px) scale(1.01);
        }

        100% {
            transform: translateY(0) scale(1);
        }
    }
</style>

