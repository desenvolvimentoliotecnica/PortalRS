@model LioTecnica.Web.ViewModels.Admin.OperationalLogsPageViewModel
@{
    ViewData["Title"] = "Portal RH - Logs Operacionais";
    ViewData["SidebarSubtitle"] = "Logs Operacionais";
}

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", "Tela: Logs Operacionais")

    <div class="searchbox position-relative d-none d-md-block">
        <i class="bi bi-search"></i>
        <input id="globalSearchOpLogs" class="form-control" placeholder="Buscar transacao, rota..." />
    </div>

    <div class="d-flex align-items-center gap-2">
        @await Html.PartialAsync("_TopbarUserMenu", "Admin")
    </div>
}

<section class="content">
    <div class="page-title">
        <div>
            <h4>@Model.Title</h4>
            <div class="subtitle">Logs gerais, warnings e erros do app.</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge-soft"><i class="bi bi-clock me-1"></i><span id="nowLabel">-</span></span>
            <span class="badge-soft"><i class="bi bi-hdd me-1"></i>API</span>
        </div>
    </div>

    <div class="card-soft p-3 mb-3">
        <div class="d-flex flex-wrap align-items-end justify-content-between gap-2">
            <div>
                <div class="fw-bold">Requisicoes monitoradas</div>
                <div class="text-muted small">Clique em uma linha para ver detalhes.</div>
            </div>
            <div class="d-flex flex-wrap gap-2 justify-content-end">
                <div style="min-width:220px;">
                    <label class="form-label small mb-1">Buscar</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background:rgba(255,255,255,.65)"><i class="bi bi-search"></i></span>
                        <input class="form-control" id="opLogsSearch" placeholder="rota, usuario, tx...">
                    </div>
                </div>
                <div>
                    <label class="form-label small mb-1">Nivel</label>
                    <select class="form-select" id="opLogsLevel">
                        <option value="">Todos</option>
                        <option value="warning">Warning</option>
                        <option value="error">Error</option>
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1">De</label>
                    <input class="form-control" type="datetime-local" id="opLogsFrom">
                </div>
                <div>
                    <label class="form-label small mb-1">Ate</label>
                    <input class="form-control" type="datetime-local" id="opLogsTo">
                </div>
                <div>
                    <label class="form-label small mb-1">&nbsp;</label>
                    <button class="btn btn-outline-primary" id="btnApplyFilters"><i class="bi bi-funnel me-1"></i>Aplicar</button>
                </div>
            </div>
        </div>

        <hr class="my-3 divider">

        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0 logs-table">
                <thead>
                    <tr>
                        <th class="fit">Quando</th>
                        <th class="fit">Nivel</th>
                        <th class="fit">Metodo</th>
                        <th>Rota</th>
                        <th class="fit">Usuario</th>
                        <th class="fit text-end">Duracao</th>
                    </tr>
                </thead>
                <tbody id="logsTbody"></tbody>
            </table>
        </div>

        <div class="d-flex align-items-center justify-content-between mt-2">
            <div class="text-muted small" id="logsHint">-</div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" id="logsPrev">Anterior</button>
                <span class="pill">Pag <span id="logsPage">1</span>/<span id="logsPages">1</span></span>
                <button class="btn btn-sm btn-outline-secondary" id="logsNext">Proxima</button>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="modalOperationalDetail" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="text-muted small">Detalhes da requisicao</div>
                    <h5 class="modal-title">Transacao <span class="mono" id="detailTxId">-</span></h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <div class="card-soft p-3 h-100">
                            <div class="fw-bold mb-2">Resumo</div>
                            <div class="small text-muted mono" id="detailRoute">-</div>
                            <div class="small text-muted" id="detailMeta">-</div>
                            <hr class="my-2">
                            <div class="small" id="detailUser">-</div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="card-soft p-3 h-100">
                            <div class="fw-bold mb-2">Erros/Warnings</div>
                            <ul class="list-unstyled mb-0" id="detailExceptions"></ul>
                        </div>
                    </div>
                </div>

                <div class="card-soft p-3 mt-3">
                    <div class="fw-bold mb-2">Log entries</div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="fit">Nivel</th>
                                    <th>Categoria</th>
                                    <th>Mensagem</th>
                                    <th class="fit">Horario</th>
                                </tr>
                            </thead>
                            <tbody id="detailEntries"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/views/admin-operational-logs.js"></script>
}

@section Footer {
    @{
        var footerItems = new[]
        {
            new { Icon = "bi-journal-text", Text = "Logs", Id = "", Class = "" },
            new { Icon = "bi-shield-check", Text = "LGPD", Id = "", Class = "" },
            new { Icon = "", Text = "build: api", Id = "buildId", Class = "mono muted" }
        };
    }
    @await Html.PartialAsync("_Footer", footerItems)
}

<style>
  .logs-table th.fit,
  .logs-table td.fit {
    white-space: nowrap;
    width: 1%;
  }

  .logs-table td.route {
    width: auto;
    max-width: 520px;
  }

  .logs-row-error td {
    color: #b02a37;
  }

  .logs-row-error .logs-method {
    border: 1px solid rgba(176, 42, 55, 0.2);
  }

  .logs-level {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 64px;
    font-weight: 600;
  }

  .logs-level.error { background: #ffe3e3; color: #dc3545; }
  .logs-level.warning { background: #fff4e6; color: #f59f00; }
  .logs-level.info { background: #e8f2ff; color: #0d6efd; }

  .logs-method {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    font-weight: 600;
    letter-spacing: .3px;
  }

  .logs-method.get { background: #0d6efd; color: #f8f9ff; }
  .logs-method.post { background: #198754; color: #f0fff6; }
  .logs-method.put { background: #f59f00; color: #1f1400; }
  .logs-method.patch { background: #d63384; color: #fff0f6; }
  .logs-method.delete { background: #dc3545; color: #fff5f5; }
</style>
