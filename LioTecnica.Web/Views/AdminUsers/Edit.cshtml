@model LioTecnica.Web.ViewModels.Admin.UserEditViewModel
@{
    ViewData["Title"] = Model.IsNew ? "New User" : "Edit User";
}
@section Topbar {
    <div class="d-flex align-items-center justify-content-between w-100">
        <div>
            <div class="h5 mb-0">@ViewData["Title"]</div>
            <div class="text-muted small">User details and roles.</div>
        </div>
        <a class="btn btn-outline-secondary" href="/Admin/Users">Back</a>
    </div>
}

<div class="container-fluid py-3">
    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post" action="@(Model.IsNew ? "/Admin/Users/New" : $"/Admin/Users/Edit/{Model.User.Id}")">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="Email">Email</label>
                        <input class="form-control" id="Email" name="Email" value="@Model.User.Email" />
                        <span class="text-danger small">@Html.ValidationMessage("Email")</span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="FullName">Full name</label>
                        <input class="form-control" id="FullName" name="FullName" value="@Model.User.FullName" />
                        <span class="text-danger small">@Html.ValidationMessage("FullName")</span>
                    </div>
                    @if (Model.IsNew)
                    {
                        <div class="col-md-6">
                            <label class="form-label" for="Password">Senha *</label>
                            <input class="form-control" id="Password" name="Password" type="password" autocomplete="new-password" />
                            <span class="text-muted small">Mínimo 8 caracteres.</span>
                            <span class="text-danger small">@Html.ValidationMessage("Password")</span>
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label" for="IsActive">Status</label>
                        <select class="form-select" id="IsActive" name="IsActive">
                            <option value="true" selected="@(Model.User.IsActive ? "selected" : null)">Active</option>
                            <option value="false" selected="@(!Model.User.IsActive ? "selected" : null)">Inactive</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Roles</label>
                        <div class="row g-2">
                            @foreach (var role in Model.Roles)
                            {
                                var isChecked = Model.User.RoleIds.Contains(role.Id);
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="RoleIds" value="@role.Id" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label">@role.Name</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="FuncionarioId">Funcionário (opcional)</label>
                        <select class="form-select" id="FuncionarioId" name="FuncionarioId">
                            <option value="">— Nenhum —</option>
                            @foreach (var f in Model.Funcionarios.OrderBy(x => x.Name))
                            {
                                <option value="@f.Id" selected="@(Model.User.FuncionarioId == f.Id)">@f.Name — @(f.Email ?? "")</option>
                            }
                        </select>
                        <span class="text-muted small">Vincule o usuário a um funcionário existente. Ao criar usuário, um funcionário é criado automaticamente se não escolher.</span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Unidades de acesso</label>
                        <p class="text-muted small mb-2">Unidades (filiais/escritórios) às quais o usuário tem acesso. Marque as que deseja liberar.</p>
                        @if (Model.Units.Count == 0)
                        {
                            <div class="text-muted small">Nenhuma unidade cadastrada.</div>
                        }
                        else
                        {
                            <div class="table-responsive rounded overflow-hidden border">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">Unidade</th>
                                            <th scope="col">Código</th>
                                            <th scope="col" class="text-center" style="width:100px;">Acesso</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var unit in Model.Units.OrderBy(x => x.Name))
                                        {
                                            var isChecked = Model.User.UnitIds != null && Model.User.UnitIds.Contains(unit.Id);
                                            <tr>
                                                <td class="fw-medium">@unit.Name</td>
                                                <td class="mono text-muted">@(unit.Code ?? "—")</td>
                                                <td class="text-center">
                                                    <input class="form-check-input" type="checkbox" name="UnitIds" value="@unit.Id" @(isChecked ? "checked" : "") title="Liberar acesso a esta unidade" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a class="btn btn-outline-secondary ms-2" href="/Admin/Users">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Footer {
    @await Html.PartialAsync("_Footer", new[] { new { Text = "Users", Class = "muted" } })
}
