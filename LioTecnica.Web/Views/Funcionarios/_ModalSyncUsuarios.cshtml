<div class="modal fade" id="modalSyncUsuarios" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content" style="border-radius: 18px; border: 1px solid var(--lt-border);">
      <div class="modal-header">
        <div>
          <h5 class="modal-title fw-bold">Sincronizar usuários</h5>
          <div class="text-muted small">Lista todos os usuários do tenant. Quem ainda não é funcionário pode ser selecionado para cadastro.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex align-items-center gap-2 mb-3">
          <button class="btn btn-ghost btn-sm" type="button" id="syncSelectAll">
            <i class="bi bi-check2-square me-1"></i>Selecionar todos
          </button>
          <button class="btn btn-ghost btn-sm" type="button" id="syncDeselectAll">
            <i class="bi bi-square me-1"></i>Desmarcar todos
          </button>
        </div>
        <div id="syncUsersListContainer">
          <div id="syncUsersLoading" class="text-center text-muted py-4 d-none">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>Carregando usuários...
          </div>
          <div id="syncUsersEmpty" class="text-center py-4 d-none">
            <div class="mb-2" style="font-size:2rem; opacity:0.7;"><i class="bi bi-people"></i></div>
            <div class="fw-semibold text-body">Nenhum usuário cadastrado</div>
            <div class="text-muted small mt-1">Não há usuários no tenant. Cadastre usuários no tenant primeiro.</div>
          </div>
          <div class="table-responsive d-none" id="syncUsersTableWrap">
            <table class="table table-sm align-middle mb-0">
              <thead>
                <tr>
                  <th style="width:2.5rem;">
                    <input type="checkbox" class="form-check-input" id="syncCheckAll" title="Selecionar todos (apenas quem ainda não é funcionário)">
                  </th>
                  <th>Nome</th>
                  <th>Email</th>
                  <th style="width:140px;">Vínculo</th>
                </tr>
              </thead>
              <tbody id="syncUsersTbody"></tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" type="button" data-bs-dismiss="modal">
          <i class="bi bi-x-lg me-1"></i>Fechar
        </button>
        <button class="btn btn-brand" type="button" id="syncCadastrarSelecionados" disabled>
          <i class="bi bi-person-badge me-1"></i>Cadastrar selecionados como funcionários
        </button>
      </div>
    </div>
  </div>
</div>
