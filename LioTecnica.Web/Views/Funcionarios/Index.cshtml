@model PageSeedViewModel
@{
    ViewData["Title"] = "Portal RH - Liotecnica - Funcionários";
    ViewData["SidebarSubtitle"] = "Funcionários";
}

@await Html.PartialAsync("_ModalFuncionario")
@await Html.PartialAsync("_ModalSyncUsuarios")
@await Html.PartialAsync("_Toast")

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", "Tela: Funcionários")

    <div class="searchbox position-relative d-none d-md-block">
      <i class="bi bi-search"></i>
      <input id="globalSearchFuncionario" class="form-control" placeholder="Buscar funcionário..." />
    </div>

    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-ghost" type="button" id="btnExportFuncionario" title="Exportar funcionários (CSV)">
        <i class="bi bi-filetype-csv"></i><span class="d-none d-sm-inline ms-1">Exportar</span>
      </button>
      <button class="btn btn-ghost" type="button" id="btnSeedReset" title="Recarregar dados">
        <i class="bi bi-arrow-counterclockwise"></i><span class="d-none d-sm-inline ms-1">Atualizar</span>
      </button>
      <button class="btn btn-brand" type="button" id="btnNewFuncionario">
        <i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline ms-1">Novo funcionário</span>
      </button>
      @await Html.PartialAsync("_TopbarUserActions", "RH")
    </div>
}

<section class="content">
  <div class="page-title">
    <div>
      <h4>Funcionários</h4>
      <div class="subtitle">Cadastro de funcionários, áreas e equipes.</div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge-soft"><i class="bi bi-clock me-1"></i><span id="nowLabel">-</span></span>
      <span class="badge-soft"><i class="bi bi-hdd me-1"></i>API</span>
    </div>
  </div>

  @{
    var kpis = new[]
    {
      new { ColClass = "col-6 col-lg-3", Title = "Funcionários", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiFuncionarioTotal", Value = "0", PillIcon = "bi-person-badge", PillText = "total", Hint = "Funcionários cadastrados." },
      new { ColClass = "col-6 col-lg-3", Title = "Ativos", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiFuncionarioActive", Value = "0", PillIcon = "bi-check2-circle", PillText = "ativo", Hint = "Funcionários em operação." },
      new { ColClass = "col-6 col-lg-3", Title = "Headcount", ValueStyle = "font-size:1.6rem;color:var(--lt-primary);", ValueId = "kpiFuncionarioHeadcount", Value = "0", PillIcon = "bi-people", PillText = "pessoas", Hint = "Soma do headcount informado." }
    };
  }
  @await Html.PartialAsync("_KpiMiniRow", kpis)

  <div class="card-soft p-3 mb-3">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2">
      <div>
        <div class="fw-bold">Lista de funcionários</div>
        <div class="text-muted small">Clique em um funcionário para ver detalhes.</div>
      </div>
      <div class="d-flex flex-wrap gap-2 justify-content-end align-items-end">
        <div style="min-width:240px;">
          <label class="form-label small mb-1">Buscar</label>
          <div class="input-group">
            <span class="input-group-text" style="background:rgba(255,255,255,.65)"><i class="bi bi-search"></i></span>
            <input class="form-control" id="gSearch" placeholder="nome, área, email...">
          </div>
        </div>
        <div>
          <label class="form-label small mb-1">Status</label>
          <select class="form-select" id="gStatus">
            <option value="all">Todos</option>
            <option value="ativo">Ativo</option>
            <option value="inativo">Inativo</option>
          </select>
        </div>
        <button class="btn btn-ghost" type="button" id="btnSyncUsers" title="Sincronizar usuários que ainda não são funcionários">
          <i class="bi bi-arrow-repeat me-1"></i>Sincronizar usuários
        </button>
      </div>
    </div>

    <hr class="my-3 divider">

    <div class="table-responsive">
      <table class="table table-sm align-middle mb-0">
        <thead>
          <tr>
            <th>Funcionário</th>
            <th>Área</th>
            <th>Unidade</th>
            <th>Headcount</th>
            <th>Status</th>
            <th class="text-end">Ações</th>
          </tr>
        </thead>
        <tbody id="funcionarioTbody"></tbody>
      </table>
    </div>

    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
      <div class="text-muted small" id="funcionarioHint">-</div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <label class="d-flex align-items-center gap-1 small mb-0">
          <span class="text-muted">Exibir</span>
          <select class="form-select form-select-sm" id="funcionarioPageSize" style="width:auto;">
            <option value="10">10</option>
            <option value="20" selected>20</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
          <span class="text-muted">por página</span>
        </label>
        <span class="pill"><i class="bi bi-table"></i><span id="funcionarioCount">0</span> exibidos</span>
      </div>
    </div>
    <div class="d-flex align-items-center justify-content-center justify-content-md-end mt-2" id="funcionarioPagination"></div>
  </div>

  <template id="tpl-funcionario-row">
    <tr>
      <td>
        <div class="fw-semibold" data-role="funcionario-nome"></div>
        <div class="text-muted small" data-role="funcionario-email"></div>
      </td>
      <td>
        <div class="fw-semibold" data-role="funcionario-area"></div>
        <div class="text-muted small" data-role="funcionario-cargo"></div>
      </td>
      <td data-role="funcionario-unidade"></td>
      <td class="mono" data-role="funcionario-headcount"></td>
      <td><span data-role="funcionario-status-host"></span></td>
      <td class="text-end">
        <button class="btn btn-ghost btn-sm me-1" type="button" data-act="detail" title="Detalhes">
          <i class="bi bi-eye"></i>
        </button>
        <button class="btn btn-ghost btn-sm me-1" type="button" data-act="edit" title="Editar">
          <i class="bi bi-pencil"></i>
        </button>
        <button class="btn btn-ghost btn-sm me-1" type="button" data-act="bloqueio" title="Bloqueio de pessoa">
          <i class="bi bi-person-x"></i>
        </button>
        <button class="btn btn-ghost btn-sm text-danger" type="button" data-act="del" title="Excluir">
          <i class="bi bi-trash3"></i>
        </button>
      </td>
    </tr>
  </template>

  <template id="tpl-funcionario-empty-row">
    <tr>
      <td colspan="6" class="text-center text-muted py-3">Nenhum funcionário encontrado.</td>
    </tr>
  </template>

  <div style="height:14px;"></div>
</section>

@section Footer {
  @{
    var footerItems = new[]
    {
      new { Icon = "bi-person-badge", Text = "Funcionários", Id = "", Class = "" },
      new { Icon = "bi-shield-check", Text = "LGPD", Id = "", Class = "" },
      new { Icon = "", Text = "build: demo", Id = "buildId", Class = "mono muted" }
    };
  }
  @await Html.PartialAsync("_Footer", footerItems)
}

@section Scripts {
  <script src="~/js/views/funcionarios.js" asp-append-version="true"></script>
}
