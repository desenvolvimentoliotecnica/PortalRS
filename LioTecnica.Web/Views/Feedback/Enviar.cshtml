@{
	ViewData["Title"] = "Portal RH • Feedback • Enviar Feedback";
	ViewData["SidebarSubtitle"] = "Feedback";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", "Feedback • Enviar Feedback")
	<div class="d-flex align-items-center gap-2">
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content enviar-feedback-page">
	<div class="page-title">
		<div>
			<h4>Enviar Feedback</h4>
			<div class="subtitle">Selecione um colaborador para enviar um feedback sobre desempenho</div>
		</div>
	</div>

	<div class="card-soft p-4">
		<form id="formEnviar" novalidate>
			<!-- Selecione um colaborador -->
			<div class="mb-4">
				<label class="form-label fw-bold" for="toUserId">Selecione um colaborador</label>
				<select class="form-select" id="toUserId" name="toUserId" required>
					<option value="">Selecione um colaborador</option>
				</select>
			</div>

			<!-- Itens da empresa -->
			<div class="mb-4">
				<label class="form-label fw-bold">Itens da empresa</label>
				<div class="text-muted small mb-2">Atribua um ou mais itens da empresa a esse feedback</div>
				<div class="row g-3" id="companyItemsRow">
					<div class="col-md-6">
						<div class="company-item-card card-soft p-3 text-center">
							<div class="fw-bold">Alinhamento Cultural</div>
							<div class="text-muted small mb-2">Alinhamento com a cultura e valores da empresa</div>
							<div class="star-rating" data-item="Alinhamento Cultural">
								<i class="bi bi-star" data-value="1"></i>
								<i class="bi bi-star" data-value="2"></i>
								<i class="bi bi-star" data-value="3"></i>
								<i class="bi bi-star" data-value="4"></i>
								<i class="bi bi-star" data-value="5"></i>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="company-item-card card-soft p-3 text-center">
							<div class="fw-bold">Foco no Cliente</div>
							<div class="text-muted small mb-2">Esforço e foco em entregar sucesso aos clientes</div>
							<div class="star-rating" data-item="Foco no Cliente">
								<i class="bi bi-star" data-value="1"></i>
								<i class="bi bi-star" data-value="2"></i>
								<i class="bi bi-star" data-value="3"></i>
								<i class="bi bi-star" data-value="4"></i>
								<i class="bi bi-star" data-value="5"></i>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Descreva seu feedback -->
			<div class="mb-4">
				<label class="form-label fw-bold" for="templateSelect">Descreva seu feedback</label>
				<select class="form-select mb-3" id="templateSelect">
					<option value="">Nenhum modelo</option>
					<option value="parar-continuar-comecar">Modelo: parar / continuar / começar</option>
					<option value="sci">Modelo: SCI - Situação/Comportamento/Impacto</option>
					<option value="cnv">Modelo: Comunicação Não Violenta</option>
					<option value="1on1">Modelo: 1 on 1</option>
					<option value="otimas-ideias">Modelo: ótimas ideias</option>
					<option value="boa-reuniao">Modelo: boa reunião</option>
					<option value="presencial">Feedback presencial</option>
				</select>
				<textarea class="form-control" id="content" name="content" rows="8" maxlength="4000" required placeholder="Escreva seu feedback..."></textarea>
				<div class="d-flex justify-content-end mt-1">
					<span class="text-muted small"><span id="charCount">0</span>/4000</span>
				</div>
			</div>

			<!-- Feedback presencial -->
			<div class="mb-4">
				<label class="form-label fw-bold d-block">Feedback presencial</label>
				<div class="form-check">
					<input class="form-check-input" type="checkbox" id="isPresencial" name="isPresencial">
					<label class="form-check-label text-muted" for="isPresencial">
						Esse feedback foi dado presencialmente
					</label>
				</div>
			</div>

			<!-- Anotações Internas -->
			<div class="mb-4">
				<label class="form-label fw-bold" for="internalNotes">Anotações Internas</label>
				<div class="text-muted small mb-2">Essas anotações são suas. São privadas e aparecerão apenas para você.</div>
				<textarea class="form-control" id="internalNotes" name="internalNotes" rows="4" maxlength="4000" placeholder="Suas anotações privadas..."></textarea>
			</div>

			<!-- Botão Enviar -->
			<div class="d-flex justify-content-end">
				<button type="submit" class="btn btn-brand px-4 py-2" id="btnEnviar">
					<i class="bi bi-send me-2"></i>Enviar feedback
				</button>
			</div>
		</form>
	</div>
</section>

<!-- Toast de sucesso -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
	<div id="toastSuccess" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="d-flex">
			<div class="toast-body">
				<i class="bi bi-check-circle me-2"></i>Feedback enviado com sucesso!
			</div>
			<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/views/feedback-enviar.js" asp-append-version="true"></script>
}
