@{
	ViewData["Title"] = "Portal RH • Feedback • Gamificação";
	ViewData["SidebarSubtitle"] = "Feedback";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", (string)null)
	<div class="d-flex align-items-center gap-2">
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content">
	<div class="page-title d-flex flex-wrap align-items-center justify-content-between gap-2">
		<h4>Gamificação</h4>
		<button class="btn btn-ghost" type="button" id="btnRefresh" title="Atualizar">
			<i class="bi bi-arrow-counterclockwise"></i><span class="d-none d-sm-inline ms-1">Atualizar</span>
		</button>
	</div>
	<div class="card-soft p-3 mb-3">
		<h5 class="mb-2">Meu saldo</h5>
		<div id="myBalance" class="display-6 text-primary">—</div>
		<div id="myBalanceUpdated" class="small text-muted"></div>
	</div>
	<div class="card-soft p-3">
		<h5 class="mb-3">Ranking RENDERCOINZ</h5>
		<div id="leaderboardList"></div>
		<div id="leaderboardEmpty" class="text-muted text-center py-4 d-none">Nenhum dado no ranking ainda.</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/views/feedback-gamificacao.js" asp-append-version="true"></script>
}
