@{
	ViewData["Title"] = "Portal RH • Feedback • Gamificação";
	ViewData["SidebarSubtitle"] = "Feedback";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", (string)null)
	<div class="d-flex align-items-center gap-2">
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content">
	<div class="page-title" style="align-items:center">
		<h4 class="m-0">Ranking de Gamificação</h4>
		<div class="d-flex gap-2">
			<a class="btn btn-ghost" href="/Feedback/GamificacaoHistorico" title="Histórico">
				<i class="bi bi-clock-history"></i><span class="d-none d-sm-inline ms-1">Histórico</span>
			</a>
			<button class="btn btn-ghost" type="button" id="btnRefresh" title="Atualizar">
				<i class="bi bi-arrow-counterclockwise"></i><span class="d-none d-sm-inline ms-1">Atualizar</span>
			</button>
		</div>
	</div>

	<div id="gamificationRankingRoot" data-use-mock="true"></div>

	<div class="card-soft p-3 mb-3">
		<div class="fw-bold mb-2">Ação e valor em pontos</div>
		<div class="row g-3">
			<div class="col-12 col-lg-6">
				<div id="rulesLeft" class="d-grid gap-1 small"></div>
			</div>
			<div class="col-12 col-lg-6">
				<div id="rulesRight" class="d-grid gap-1 small"></div>
			</div>
		</div>
	</div>

	<div class="card-soft p-3">
		<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-2">
			<div>
				<div class="fw-bold">Ranking completo</div>
				<div class="text-muted small">
					Confira a pontuação do time abaixo. Para ver seu extrato individual, basta buscar seu nome na lista.
				</div>
			</div>
			<div class="text-end">
				<div class="text-muted small">Total de Feedzcoin</div>
				<div id="rankingTotal" class="fw-bold">—</div>
			</div>
		</div>

		<input id="rankingSearch" class="form-control mb-2" placeholder="Busque pelo nome" />

		<div class="d-flex gap-3 mb-3 small">
			<a href="#" id="tabAll" class="text-decoration-none fw-semibold">Todos</a>
			<a href="#" id="tabColab" class="text-decoration-none text-muted">Colaboradores</a>
			<a href="#" id="tabGestor" class="text-decoration-none text-muted">Gestores</a>
		</div>

		<div id="rankingGrid" class="row g-3"></div>
		<div id="rankingEmpty" class="text-muted text-center py-4 d-none">Nenhum item encontrado.</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/views/feedback-gamificacao.js" asp-append-version="true"></script>
}
