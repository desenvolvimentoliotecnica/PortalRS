@* Tela Desenvolvimento desativada. Controller redireciona para Celebração. *@
@{
	ViewData["Title"] = "Portal RH • Feedback • Feedbacks";
	ViewData["SidebarSubtitle"] = "Feedback";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", "Feedback • Feedbacks")
	<div class="d-flex align-items-center gap-2">
		<button class="btn btn-ghost" type="button" id="btnRefresh" title="Atualizar">Atualizar</button>
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content feedback-dashboard-page">
	<div class="page-title">
		<div>
			<h4>Início</h4>
			<div class="subtitle">Acompanhamento da gestão e do time.</div>
		</div>
	</div>
	<div id="kpiRow" class="dashboard-kpi-row mb-3"></div>
	<div class="grid2 mb-3">
		<div id="leftCol">
			<div id="oneOnOnePanel" class="card-soft p-3 mb-3"></div>
			<div id="moodPanel" class="card-soft p-3 mb-3"></div>
			<div id="teamSummary" class="card-soft p-3 mb-3"></div>
			<div id="quickLinksPanel" class="mb-3"></div>
			<div id="activitiesPanel" class="card-soft p-3 mb-3"></div>
		</div>
		<div id="rightCol">
			<div id="profilePanel" class="card-soft p-3 mb-3"></div>
			<div id="rankingPanel" class="card-soft p-3 mb-3"></div>
		</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/views/feedback-feedbacks.js" asp-append-version="true"></script>
}
