@{
	ViewData["Title"] = "Portal RH • Feedback • Gestão";
	ViewData["SidebarSubtitle"] = "Feedback";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", "Feedback • Gestão")
	<button class="btn btn-ghost" type="button" id="btnRefresh" title="Atualizar">Atualizar</button>
	@await Html.PartialAsync("_TopbarUserActions", "RH")
}

<section class="content">
	<div class="page-title">
		<div>
			<h4>Gestão</h4>
			<div class="subtitle">Planos de desenvolvimento da sua equipe.</div>
		</div>
	</div>
	<div class="card-soft p-3">
		<div id="plansTeamList"></div>
		<div id="plansTeamEmpty" class="text-muted text-center py-4 d-none">Nenhum plano da equipe.</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/views/feedback-gestao.js" asp-append-version="true"></script>
}
