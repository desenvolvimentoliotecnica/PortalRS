@* Tela Desenvolvimento desativada. Controller redireciona para Celebração. *@
@{
	ViewData["Title"] = "Portal RH • Feedback • Meus planos de desenvolvimento";
	ViewData["SidebarSubtitle"] = "Feedback";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", "Feedback • Meus planos")
	<div class="d-flex align-items-center gap-2">
		<button class="btn btn-ghost" type="button" id="btnRefresh" title="Atualizar">Atualizar</button>
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content">
	<div class="page-title">
		<div>
			<h4>Meus planos de desenvolvimento</h4>
			<div class="subtitle">Planos onde você é gestor ou colaborador.</div>
		</div>
	</div>
	<div class="card-soft p-3">
		<div id="plansList"></div>
		<div id="plansEmpty" class="text-muted text-center py-4 d-none">Nenhum plano encontrado.</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/views/feedback-meus-planos.js" asp-append-version="true"></script>
}
