@{
	ViewData["Title"] = "Portal RH • Feedback • Celebração";
	ViewData["SidebarSubtitle"] = "Feedback";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", "Feedback • Celebração")
	<div class="d-flex align-items-center gap-2">
		<button class="btn btn-ghost" type="button" id="btnRefresh" title="Atualizar feed">
			<i class="bi bi-arrow-counterclockwise"></i><span class="d-none d-sm-inline ms-1">Atualizar</span>
		</button>
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content">
	<div class="page-title">
		<div>
			<h4>Celebração</h4>
			<div class="subtitle">Compartilhe conquistas e marque colegas com @@ para celebrar juntos.</div>
		</div>
	</div>

	<div class="card-soft p-3 mb-3">
		<div class="fw-bold mb-2">Nova publicação</div>
		<div class="text-muted small mb-2">Digite @@ e o nome para marcar um colaborador.</div>
		<div class="position-relative">
			<textarea class="form-control" id="postContent" rows="3" placeholder="O que você quer celebrar? Use @@nome para marcar colegas..." maxlength="4000"></textarea>
			<div class="d-flex justify-content-between align-items-center mt-2">
				<span class="text-muted small"><span id="charCount">0</span>/4000</span>
				<button type="button" class="btn btn-brand btn-sm" id="btnPost">Publicar</button>
			</div>
		</div>
		<div id="mentionDropdown" class="list-group position-absolute shadow d-none" style="z-index: 1050; max-height: 200px; overflow-y: auto;"></div>
	</div>

	<div class="card-soft p-3">
		<div class="fw-bold mb-2">Feed</div>
		<div id="feedList"></div>
		<div id="feedEmpty" class="text-muted text-center py-4 d-none">Nenhuma publicação ainda. Seja o primeiro a celebrar!</div>
		<div id="feedLoading" class="text-muted text-center py-4">Carregando...</div>
		<div id="feedLoadMore" class="text-center mt-3 d-none">
			<button type="button" class="btn btn-ghost btn-sm" id="btnLoadMore">Carregar mais</button>
		</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/views/feedback-celebracao.js" asp-append-version="true"></script>
}
