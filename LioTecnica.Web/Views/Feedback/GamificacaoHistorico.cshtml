@{
	ViewData["Title"] = "Portal RH • Feedback • Gamificação • Histórico";
	ViewData["SidebarSubtitle"] = "Feedback";
}

@section Topbar {
	<div class="d-flex align-items-center gap-2">
		<a class="btn btn-ghost" href="/Feedback/Gamificacao" title="Voltar">
			<i class="bi bi-arrow-left"></i><span class="d-none d-sm-inline ms-1">Voltar</span>
		</a>
		@await Html.PartialAsync("_TopbarBrand", (string)null)
	</div>
	<div class="d-flex align-items-center gap-2">
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content">
	<div class="page-title" style="align-items:center">
		<h4 class="m-0">Histórico de ranking</h4>
		<button class="btn btn-ghost" type="button" id="btnRefreshHistory" title="Atualizar">
			<i class="bi bi-arrow-counterclockwise"></i><span class="d-none d-sm-inline ms-1">Atualizar</span>
		</button>
	</div>

	<div id="gamificationHistoryRoot" data-use-mock="true" data-goal="5000"></div>

	<div id="historyGrid" class="row g-3"></div>
	<div id="historyEmpty" class="text-muted text-center py-4 d-none">Nenhum histórico disponível.</div>
</section>

@section Scripts {
	<script src="~/js/views/feedback-gamificacao-historico.js" asp-append-version="true"></script>
}

