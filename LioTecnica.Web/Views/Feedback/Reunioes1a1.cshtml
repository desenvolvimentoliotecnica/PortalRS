@{
	ViewData["Title"] = "Portal RH • Feedback • Reuniões 1:1";
	ViewData["SidebarSubtitle"] = "Feedback";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", "Feedback • Reuniões 1:1")
	<div class="d-flex align-items-center gap-2">
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content reunioes-page">
	<!-- Header -->
	<div class="page-title">
		<div>
			<h4>Reuniões 1:1</h4>
			<div class="subtitle">Crie, acompanhe e finalize reuniões individuais com seus liderados</div>
		</div>
		<div class="d-flex gap-2 flex-wrap">
			<button class="btn btn-ghost" id="btnDesvincular" disabled title="Em breve">
				<i class="bi bi-calendar-x me-1"></i>Desvincular Agenda
			</button>
			<button class="btn btn-brand" id="btnCriarReuniao">
				<i class="bi bi-plus-lg me-1"></i>Criar reunião 1:1
			</button>
		</div>
	</div>

	<!-- Filtros -->
	<div class="card-soft p-3 mb-3">
		<div class="d-flex flex-wrap align-items-end gap-3">
			<div class="flex-grow-1" style="min-width:200px;max-width:300px;">
				<label class="form-label small mb-1" for="filterColaborador">Colaborador</label>
				<input type="search" class="form-control form-control-sm" id="filterColaborador" placeholder="Buscar colaborador com 1:1 existente">
			</div>
			<div>
				<label class="form-label small mb-1" for="filterStatus">Status do Colaborador</label>
				<select class="form-select form-select-sm" id="filterStatus" style="min-width:160px;">
					<option value="">Todos &gt; Ativos</option>
					<option value="atrasada">Atrasada</option>
					<option value="agendada">Agendada</option>
					<option value="finalizada">Finalizada</option>
				</select>
			</div>
			<div>
				<label class="form-label small mb-1" for="filterCategoria">Categoria</label>
				<select class="form-select form-select-sm" id="filterCategoria" style="min-width:130px;">
					<option value="">Todas</option>
					<option value="sem-categoria">Sem Categoria</option>
				</select>
			</div>
			<div>
				<label class="form-label small mb-1" for="filterFrequencia">Frequência</label>
				<select class="form-select form-select-sm" id="filterFrequencia" style="min-width:130px;">
					<option value="">Todas</option>
					<option value="boa">Boa</option>
					<option value="ruim">Ruim</option>
				</select>
			</div>
		</div>
	</div>

	<!-- Tabela principal -->
	<div class="card-soft p-3 mb-3">
		<div class="table-responsive">
			<table class="table table-hover mb-0" id="meetingsTable">
				<thead>
					<tr>
						<th class="sortable" data-sort="name">
							Nome do Colaborador <i class="bi bi-arrow-down-up ms-1 text-muted small"></i>
						</th>
						<th class="sortable" data-sort="last">
							Última Reunião <i class="bi bi-arrow-down-up ms-1 text-muted small"></i>
						</th>
						<th class="sortable" data-sort="next">
							Próxima Reunião <i class="bi bi-arrow-down-up ms-1 text-muted small"></i>
						</th>
						<th class="sortable" data-sort="freq">
							Frequência <i class="bi bi-arrow-down-up ms-1 text-muted small"></i>
						</th>
					</tr>
				</thead>
				<tbody id="meetingsBody"></tbody>
			</table>
		</div>
		<div id="meetingsEmpty" class="text-muted text-center py-4 d-none">
			<i class="bi bi-people fs-2 d-block mb-2" style="opacity:.3;"></i>
			Nenhuma reunião encontrada.
		</div>
		<!-- Paginação -->
		<div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2" id="paginationRow">
			<div class="d-flex align-items-center gap-2">
				<label class="small text-muted mb-0">Itens por página:</label>
				<select class="form-select form-select-sm" id="pageSizeSelect" style="width:75px;">
					<option value="5" selected>5</option>
					<option value="10">10</option>
					<option value="15">15</option>
					<option value="20">20</option>
					<option value="50">50</option>
					<option value="100">100</option>
				</select>
			</div>
			<div class="d-flex align-items-center gap-2">
				<span class="small text-muted" id="pageInfo">1 de 1</span>
				<button class="btn btn-ghost btn-sm" id="btnPrevPage" disabled><i class="bi bi-chevron-left"></i></button>
				<button class="btn btn-ghost btn-sm" id="btnNextPage" disabled><i class="bi bi-chevron-right"></i></button>
			</div>
		</div>
	</div>

	<!-- Em Breve -->
	<div class="card-soft p-3 mb-3">
		<h6 class="fw-bold mb-3"><i class="bi bi-clock me-1"></i>Em Breve</h6>
		<div id="upcomingList"></div>
		<div id="upcomingEmpty" class="text-muted small d-none">Nenhuma reunião futura agendada.</div>
		<div class="text-center mt-2 d-none" id="upcomingMore">
			<button class="btn btn-ghost btn-sm" id="btnShowMoreUpcoming">Mostrar mais reuniões</button>
		</div>
	</div>
</section>

<!-- Modal Criar/Editar Reunião -->
<div class="modal fade" id="modalMeeting" tabindex="-1" aria-labelledby="modalMeetingLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="modalMeetingLabel">Criar reunião 1:1</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" id="meetingId" />
				<div class="mb-3">
					<label for="meetingCollaboratorId" class="form-label">Colaborador</label>
					<select class="form-select" id="meetingCollaboratorId" required>
						<option value="">Selecione...</option>
					</select>
				</div>
				<div class="mb-3">
					<label for="meetingDate" class="form-label">Data da reunião</label>
					<input type="datetime-local" class="form-control" id="meetingDate" required />
				</div>
				<div class="mb-3">
					<label for="meetingEndTime" class="form-label">Horário de término</label>
					<input type="time" class="form-control" id="meetingEndTime" />
				</div>
				<div class="mb-3">
					<label for="meetingSubject" class="form-label">Assunto / Categoria (opcional)</label>
					<input type="text" class="form-control" id="meetingSubject" maxlength="200" />
				</div>
				<div class="mb-3">
					<label for="meetingNotes" class="form-label">Notas / Resumo</label>
					<textarea class="form-control" id="meetingNotes" rows="4" maxlength="4000"></textarea>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
				<button type="button" class="btn btn-brand" id="btnSaveMeeting">Salvar</button>
			</div>
		</div>
	</div>
</div>

<!-- Toast sucesso -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
	<div id="toastSuccess" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="d-flex">
			<div class="toast-body">
				<i class="bi bi-check-circle me-2"></i><span id="toastMsg">Reunião salva com sucesso!</span>
			</div>
			<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/views/feedback-reunioes1a1.js" asp-append-version="true"></script>
}
