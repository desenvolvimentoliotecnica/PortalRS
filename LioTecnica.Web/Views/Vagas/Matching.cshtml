@{
    var vagaId = (Guid)ViewBag.VagaId;

    var vagaTitulo = ViewBag.VagaTitulo as string ?? "Vaga";

    ViewData["Title"] = "Portal RH • Matching • " + vagaTitulo;

    ViewData["SidebarSubtitle"] = "Vagas • Matching";
}

@await Html.PartialAsync("_Toast")

@section Topbar {
    <div class="d-flex align-items-center gap-2">
        <a href="@Url.Action("Index", "Vagas")" class="btn btn-ghost p-2" title="Voltar para Vagas" aria-label="Voltar para Vagas">
            <i class="bi bi-arrow-left"></i>
        </a>
        @await Html.PartialAsync("_TopbarBrand", (string)null)
    </div>

    <div class="d-flex align-items-center gap-2 ms-auto">
        @await Html.PartialAsync("_TopbarUserActions", "RH")
    </div>
}

<section class="content">
    <div class="page-title d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <h4>Matching: @vagaTitulo</h4>
        </div>
        <div class="d-flex flex-nowrap align-items-center gap-2 d-none" id="matchingPageTitleActions">
            <button type="button" class="btn btn-ghost" id="btnEditMatchingFiltros" title="Editar filtros de matching por IA">
                <i class="bi bi-pencil me-1"></i>Editar filtros de matching por IA
            </button>
            <button type="button" class="btn btn-ghost d-none" id="btnRevertMatchingFiltros" title="Reverter para filtros da criação">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reverter para filtros da criação
            </button>
        </div>
    </div>

    <!-- Bloco ocultado pelo JS quando __vagaMatchingId está definido -->
    <div id="matchingVagaSelectorWrap">
        <div class="card-soft p-3 mb-3">
            <div class="d-flex flex-wrap align-items-end gap-3">
                <div class="flex-grow-1" style="min-width: 140px;">
                    <p class="mini-title mb-0 small text-uppercase text-muted">Filtros</p>
                    <div class="small fw-semibold mt-1">Vaga e candidatos</div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="input-group input-group-sm" style="width: 200px;">
                        <span class="input-group-text py-1 px-2"
                            style="border-color:var(--lt-border); background: rgba(255,255,255,.7); font-size: 0.875rem;">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input class="form-control form-control-sm py-1" id="fSearch" placeholder="Nome, email..."
                            style="border-color:var(--lt-border); font-size: 0.875rem;">
                    </div>
                    <select class="form-select form-select-sm py-1" id="fVaga"
                        style="width: 200px; border-color:var(--lt-border); font-size: 0.875rem;"></select>
                    <select class="form-select form-select-sm py-1" id="fStatus" data-enum="candidatoStatusFilter"
                        style="width: 160px; border-color:var(--lt-border); font-size: 0.875rem;"></select>
                    <select class="form-select form-select-sm py-1" id="fSort" data-enum="matchingSort"
                        data-selected="score_desc"
                        style="width: 160px; border-color:var(--lt-border); font-size: 0.875rem;"></select>
                </div>
            </div>
        </div>

        <div class="card-soft p-3 mb-3">
            <div class="fw-bold mb-2">Vagas disponíveis</div>
            <div class="text-muted small mb-2">Clique em uma vaga para ver o ranking de candidatos.</div>
            <div id="vagaList" class="d-flex flex-wrap gap-2"></div>
        </div>
    </div>

    <div class="card-soft p-3 mb-3">
        <div id="vagaHeader" class="d-none d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div class="fw-bold">Candidatos</div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge rounded-pill bg-primary" style="font-size:0.8rem;"><i class="bi bi-people me-1"></i><span id="listCount">0</span></span>
                <span class="badge rounded-pill bg-success" style="font-size:0.8rem;"><i class="bi bi-check2-circle me-1"></i><span id="cardInside">0</span></span>
                <span class="badge rounded-pill bg-warning text-dark" style="font-size:0.8rem;"><i class="bi bi-exclamation-triangle me-1"></i><span id="cardFail">0</span></span>
                <span class="badge rounded-pill" style="font-size:0.8rem; background: rgba(16,82,144,.12); color: var(--lt-primary);"><span id="cardAvg">0%</span> média</span>
            </div>
        </div>

        <div class="table-responsive">
            <lt-list class="matching-grid w-100" id="candList"></lt-list>
        </div>
    </div>

    <div class="detail-panel d-none" id="detailHost">
        <div class="empty">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-info-circle mt-1"></i>
                <div>
                    <div class="fw-bold">Selecione um candidato</div>
                    <div class="small mt-1">A tela exibirá score, requisitos encontrados/faltando e explicação do cálculo.</div>
                </div>
            </div>
        </div>
    </div>

    <div style="height:14px;"></div>
</section>

<!-- Templates (mesmos IDs que matching.js usa) -->
<template id="tpl-matching-tag">
    <span class="status-tag">
        <i class="bi" data-role="icon"></i>
        <span data-role="text"></span>
    </span>
</template>
<template id="tpl-matching-empty">
    <div class="text-muted small">Nenhum candidato com os filtros atuais.</div>
</template>
<template id="tpl-matching-select-vaga">
    <div class="text-muted small py-4 text-center">
        <i class="bi bi-funnel d-block mb-2" style="font-size:2rem;"></i>
        Selecione uma vaga no filtro acima para ver o ranking de candidatos por pontos.
    </div>
</template>
<template id="tpl-matching-ranking-row">
    <tr class="ranking-row" data-id="">
        <td>
            <div class="avatar avatar-sm" data-role="rank-initials"></div>
        </td>
        <td><span class="fw-semibold" data-role="rank-name"></span></td>
        <td><span class="text-muted small" data-role="rank-email"></span></td>
        <td><span class="badge rank-match-badge" data-role="rank-match"></span></td>
        <td class="text-end">
            <button type="button" class="btn btn-ghost btn-sm" data-role="rank-open">
                <i class="bi bi-box-arrow-up-right me-1"></i>Abrir
            </button>
        </td>
        <td class="text-end">
            <div class="score-circle" data-role="rank-score-circle" style="--score: 0">
                <span class="score-circle-value" data-role="rank-score"></span>
            </div>
        </td>
    </tr>
</template>
<template id="tpl-matching-item">
    <div class="item">
        <div class="d-flex align-items-start justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <div class="avatar" data-role="item-initials"></div>
                <div>
                    <div class="fw-bold" data-role="item-name"></div>
                    <div class="text-muted small" data-role="item-email"></div>
                </div>
            </div>
            <div class="text-end">
                <div class="pill mono" data-role="item-vaga-code"></div>
                <div class="text-muted small mt-1" data-role="item-vaga-title"></div>
            </div>
        </div>
        <div class="mt-2">
            <div class="d-flex align-items-center gap-2">
                <div class="progress flex-grow-1">
                    <div class="progress-bar" data-role="item-progress"></div>
                </div>
                <div class="fw-bold" style="min-width:52px;text-align:right;" data-role="item-score"></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2" data-role="item-tags"></div>
        </div>
    </div>
</template>
<template id="tpl-matching-detail-empty">
    <div class="empty">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-info-circle mt-1"></i>
            <div>
                <div class="fw-bold">Selecione um candidato</div>
                <div class="small mt-1">A tela exibira score, requisitos e explicacao do calculo.</div>
            </div>
        </div>
    </div>
</template>
<template id="tpl-matching-detail-novaga">
    <div class="empty">
        <div class="fw-bold">Sem vaga vinculada</div>
        <div class="small mt-1">Vincule a vaga ao candidato para calcular o matching.</div>
    </div>
</template>
<template id="tpl-matching-detail">
    <div class="card-soft p-3">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
            <div class="d-flex align-items-center gap-2">
                <div class="avatar" style="width:52px;height:52px;border-radius:16px;" data-role="detail-initials">
                </div>
                <div>
                    <div class="fw-bold" style="font-size:1.05rem;" data-role="detail-name"></div>
                    <div class="text-muted small" data-role="detail-email"></div>
                    <div class="text-muted small"><i class="bi bi-clock-history me-1"></i>Atualizado: <span
                            data-role="detail-updated"></span></div>
                </div>
            </div>
            <div class="text-end">
                <div data-role="detail-match-tag"></div>
                <div class="text-muted small mt-1">Minimo: <span class="mono fw-semibold" data-role="detail-thr"></span>
                </div>
                <div class="text-muted small">
                    <i class="bi me-1" data-role="detail-cache-icon"></i><span data-role="detail-cache-text"></span>
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="pill"><i class="bi bi-briefcase"></i><span data-role="detail-vaga-title"></span></span>
            <span class="pill mono"><span data-role="detail-vaga-code"></span></span>
            <span class="pill"><i class="bi bi-collection me-1"></i>Requisitos: <strong class="ms-1"
                    data-role="detail-req-count"></strong></span>
            <span class="pill"><i class="bi bi-check2-circle me-1"></i>Encontrados: <strong class="ms-1"
                    data-role="detail-hit-count"></strong></span>
            <span class="pill"><i class="bi bi-exclamation-triangle me-1"></i>Obrig. faltando: <strong class="ms-1"
                    data-role="detail-miss-count"></strong></span>
        </div>
        <div class="mb-2">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-bold">Score</div>
                    <div class="text-muted small">baseado em pesos e palavras-chave</div>
                </div>
                <div class="fw-bold" style="font-size:1.35rem;color:var(--lt-primary);" data-role="detail-score"></div>
            </div>
            <div class="progress mt-2">
                <div class="progress-bar" data-role="detail-score-bar"></div>
            </div>
        </div>
        <div class="row g-2 mt-3">
            <div class="col-12 col-lg-6">
                <div class="fw-bold mb-2">Requisitos (detalhado)</div>
                <lt-list class="d-grid gap-2" id="reqList"></lt-list>
            </div>
            <div class="col-12 col-lg-6">
                <div class="fw-bold mb-2">Explicacao do calculo</div>
                <div class="card-soft p-3" style="box-shadow:none;">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-info-circle mt-1"></i>
                        <div class="text-muted small">
                            <div><span class="mono">score = (peso_encontrado / peso_total) * 100</span></div>
                            <div class="mt-1">Penalidade: <span class="mono">-15 pontos</span> por obrigatorio faltando
                                (max. <span class="mono">-40</span>).</div>
                            <div class="mt-1">Critério: <span class="mono">score &gt;= threshold</span> =&gt; "Dentro".
                            </div>
                        </div>
                    </div>
                    <hr class="my-3" style="border-color: rgba(16,82,144,.14);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="text-muted small">Peso encontrado</div>
                        <div class="fw-bold mono"><span data-role="detail-hitPeso"></span>/<span
                                data-role="detail-totalPeso"></span></div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-1">
                        <div class="text-muted small">Penalidade (obrigatorios)</div>
                        <div class="fw-bold mono" data-role="detail-penalty"></div>
                    </div>
                    <div class="alert alert-primary mt-3 mb-0"
                        style="border-radius:14px; border-color: rgba(16,82,144,.25); background: rgba(173,200,220,.22); color: var(--lt-primary);">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-lightning-charge mt-1"></i>
                            <div>
                                <div class="fw-semibold">Acao rapida</div>
                                <div class="small">Recalcule o match apos atualizar o texto do CV ou requisitos da vaga.
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <button class="btn btn-brand btn-sm" type="button" id="btnRecalcOne">
                                        <i class="bi bi-arrow-repeat me-1"></i>Recalcular este candidato
                                    </button>
                                    <button class="btn btn-ghost btn-sm" type="button" id="btnClearCacheOne">
                                        <i class="bi bi-eraser me-1"></i>Limpar cache deste
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3" id="detailResumoWrap">
                        <div class="fw-bold">Resumo profissional</div>
                        <div class="text-muted small mt-1" id="detailResumoProfissional"></div>
                    </div>
                    <div class="mt-3" id="detailDocumentosWrap">
                        <div class="fw-bold">Documentos</div>
                        <div class="text-muted small mt-1" id="detailDocumentosList"></div>
                    </div>
                    <div class="mt-3">
                        <div class="fw-bold">Trecho do CV (texto)</div>
                        <div class="text-muted small">No MVP, o texto vem do parser (PDF/Word) e e usado para matching.
                        </div>
                        <textarea class="form-control mt-2" rows="8" id="cvTextArea"
                            style="border-color:var(--lt-border);"></textarea>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button class="btn btn-ghost btn-sm" type="button" id="btnSaveCvText">
                                <i class="bi bi-save me-1"></i>Salvar texto do CV
                            </button>
                            <button class="btn btn-ghost btn-sm" type="button" id="btnClearCacheVaga">
                                <i class="bi bi-trash3 me-1"></i>Limpar cache da vaga
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>
<template id="tpl-matching-req-row">
    <div class="req-row">
        <div class="d-flex align-items-start justify-content-between gap-2">
            <div>
                <div class="fw-semibold"><i class="bi me-1" data-role="req-icon"></i><span data-role="req-term"></span>
                </div>
                <div class="text-muted small">
                    Peso: <span class="mono" data-role="req-weight"></span>
                    <span class="mx-1">&bull;</span>
                    <span data-role="req-obrig"></span>
                </div>
                <div class="text-muted small mt-1" data-role="req-syn-wrap">Sinonimos: <span data-role="req-syn"></span>
                </div>
            </div>
            <div data-role="req-tag-host"></div>
        </div>
    </div>
</template>

<!-- Modal: detalhes do candidato -->
<div class="modal fade" id="modalMatchingDetail" tabindex="-1" aria-hidden="true" data-bs-backdrop="static"
    data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="fw-bold">Detalhes do candidato</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body" id="detailModalBody"></div>
        </div>
    </div>
</div>

<!-- Modal: editar filtros de matching da vaga -->
<div class="modal fade" id="modalEditMatchingFiltros" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="fw-bold">Filtros de matching (IA)</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-12">
                        <div class="fw-semibold">Regras de matching por IA</div>
                        <div class="text-muted small">Preencha os critérios do candidato ideal. Esses dados serão usados
                            como contexto para o matching (e para a IA).</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">Modalidade</label>
                        <select class="form-select form-select-sm" id="vagaMatchingModalidade"
                            style="border-color:var(--lt-border);"></select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">Senioridade</label>
                        <select class="form-select form-select-sm" id="vagaMatchingSenioridade"
                            style="border-color:var(--lt-border);"></select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">Escolaridade</label>
                        <select class="form-select form-select-sm" id="vagaMatchingEscolaridade"
                            style="border-color:var(--lt-border);"></select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">Formação (área)</label>
                        <select class="form-select form-select-sm" id="vagaMatchingFormacaoArea"
                            style="border-color:var(--lt-border);"></select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">Cidade</label>
                        <input type="text" class="form-control form-control-sm" id="vagaMatchingCidade"
                            placeholder="Ex.: São Paulo" style="border-color:var(--lt-border);">
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">UF</label>
                        <select class="form-select form-select-sm" id="vagaMatchingUF"
                            style="border-color:var(--lt-border);"></select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">Tempo de experiência</label>
                        <select class="form-select form-select-sm" id="vagaMatchingExp"
                            style="border-color:var(--lt-border);"></select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">Sexo</label>
                        <select class="form-select form-select-sm" id="vagaMatchingSexo"
                            style="border-color:var(--lt-border);"></select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small">PCD</label>
                        <select class="form-select form-select-sm" id="vagaMatchingPcd"
                            style="border-color:var(--lt-border);"></select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small">Idade min.</label>
                        <input type="number" class="form-control form-control-sm" id="vagaMatchingIdadeMin" min="14"
                            max="100" placeholder="-" style="border-color:var(--lt-border);">
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small">Idade max.</label>
                        <input type="number" class="form-control form-control-sm" id="vagaMatchingIdadeMax" min="14"
                            max="100" placeholder="-" style="border-color:var(--lt-border);">
                    </div>
                    <div class="col-12 col-md-4 d-flex align-items-end gap-2 flex-wrap pb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="vagaMatchingRequerCnh">
                            <label class="form-check-label small" for="vagaMatchingRequerCnh">Requer CNH</label>
                        </div>
                        <div class="vagaMatchingCnhCategoriaWrap" style="display:none;">
                            <label class="form-label small me-1 mb-0">Categoria</label>
                            <select class="form-select form-select-sm" id="vagaMatchingCnhCategoria"
                                style="border-color:var(--lt-border); width:auto;"></select>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Habilidades desejadas</label>
                        <input type="text" class="form-control form-control-sm" id="vagaMatchingHabilidades"
                            placeholder="Ex.: .NET, SQL, APIs REST (separadas por vírgula)"
                            style="border-color:var(--lt-border);">
                    </div>
                    <div class="col-12">
                        <label class="form-label small text-muted">Observações adicionais (opcional)</label>
                        <textarea class="form-control form-control-sm" id="vagaMatchingObs" rows="2"
                            placeholder="Outros critérios em texto livre"
                            style="border-color:var(--lt-border);"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-brand" id="btnSaveMatchingFiltros">
                    <i class="bi bi-save me-1"></i>Salvar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.__vagasApiUrl = "@Url.Content("~/api/vagas")";
        window.__candidatosApiUrl = "@Url.Content("~/api/candidatos")";
        window.__vagaMatchingId = "@vagaId";
        window.__vagaMatchingTitulo = @Html.Raw(Json.Serialize(vagaTitulo));
    </script>
    <script src="~/js/views/matching.js" asp-append-version="true"></script>
}
