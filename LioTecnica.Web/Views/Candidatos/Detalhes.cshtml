@{
	ViewData["Title"] = "Portal RH • Detalhes do candidato";
	ViewData["SidebarSubtitle"] = "Candidatos • Detalhes";
	var candidatoId = ViewBag.CandidatoId as Guid? ?? Guid.Empty;
	var vagaId = ViewBag.VagaId as Guid?;
}

@await Html.PartialAsync("_Toast")

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", (string)null)
	<a href="@Url.Action("Index", "Candidatos")" class="btn btn-ghost" title="Voltar para Candidatos">
		<i class="bi bi-arrow-left"></i><span class="d-none d-sm-inline ms-1">Voltar</span>
	</a>
	<div class="d-flex align-items-center gap-2 ms-auto">
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content">
	<div class="page-title">
		<div>
			<h4>Detalhes do candidato</h4>
			<div class="subtitle">Match, histórico e status.</div>
		</div>
	</div>

	<div class="card-soft p-3" style="border-radius: 18px; border: 1px solid var(--lt-border);">
		<div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
			<div class="d-flex align-items-center gap-3">
				<div id="detailInitials" class="avatar rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:56px;height:56px;background:var(--lt-primary);color:#fff;font-size:1.1rem;">—</div>
				<div>
					<h5 class="fw-bold mb-0" id="detailName">—</h5>
					<div class="text-muted small"><a href="#" id="detailEmail" class="text-decoration-none">—</a></div>
					<div class="text-muted small mt-1">
						<i class="bi bi-clock-history me-1"></i>Atualizado: <span id="detailUpdated">—</span>
					</div>
				</div>
			</div>
			<div class="text-end">
				<div id="detailStatusHost" class="mb-1"></div>
				<div class="d-flex flex-wrap gap-2 justify-content-end">
					<span class="badge-soft" id="detailVagaWrap" style="display:none;"><i class="bi bi-briefcase me-1"></i><span id="detailVagaTitle">—</span></span>
					<span class="badge-soft" id="detailThrWrap" style="display:none;"><i class="bi bi-stars me-1"></i>Match min.: <strong id="detailThr">—</strong></span>
				</div>
				<div class="text-muted small mt-1"><i class="bi bi-person-badge me-1"></i>Recrutador: <span id="detailRecruiter">—</span></div>
			</div>
		</div>

		<ul class="nav nav-pills gap-2 mb-3" style="background: rgba(173,200,220,.16); padding: .35rem; border-radius: 999px; border: 1px solid rgba(16,82,144,.14);">
			<li class="nav-item">
				<button class="nav-link active rounded-pill" data-bs-toggle="pill" data-bs-target="#tabResumo" type="button">
					<i class="bi bi-card-text me-1"></i>Resumo
				</button>
			</li>
			<li class="nav-item">
				<button class="nav-link rounded-pill" data-bs-toggle="pill" data-bs-target="#tabCV" type="button">
					<i class="bi bi-file-earmark-text me-1"></i>Texto do CV
				</button>
			</li>
			<li class="nav-item">
				<button class="nav-link rounded-pill" data-bs-toggle="pill" data-bs-target="#tabDocs" type="button">
					<i class="bi bi-paperclip me-1"></i>Documentos
				</button>
			</li>
			<li class="nav-item">
				<button class="nav-link rounded-pill" data-bs-toggle="pill" data-bs-target="#tabMatch" type="button">
					<i class="bi bi-stars me-1"></i>Match
				</button>
			</li>
		</ul>

		<div class="tab-content">
			<div class="tab-pane fade show active" id="tabResumo" role="tabpanel">
				<div class="fw-semibold mb-1">Resumo profissional</div>
				<div class="text-muted small mb-3" id="detailResumo">—</div>
				<div class="fw-semibold mb-1">Observações</div>
				<div class="text-muted small" id="detailObs">—</div>
			</div>

			<div class="tab-pane fade" id="tabCV" role="tabpanel">
				<div class="fw-semibold mb-1">Texto do CV (para simulação no MVP)</div>
				<div class="text-muted small mb-2">Texto usado para matching.</div>
				<textarea class="form-control" id="detailCvText" rows="12" readonly style="border-color:var(--lt-border);"></textarea>
			</div>

			<div class="tab-pane fade" id="tabDocs" role="tabpanel">
				<div class="fw-semibold mb-1">Documentos</div>
				<div class="text-muted small mb-2">Currículos e anexos do candidato.</div>
				<div id="detailDocList"></div>
			</div>

			<div class="tab-pane fade" id="tabMatch" role="tabpanel">
				<div id="matchContent" class="d-none">
					<div class="d-flex align-items-center justify-content-between mb-2">
						<div>
							<div class="fw-bold">Score</div>
							<div class="text-muted small">baseado em pesos e palavras-chave</div>
						</div>
						<div class="fw-bold" style="font-size:1.35rem;color:var(--lt-primary);" id="matchScore">—</div>
					</div>
					<div class="progress mb-2">
						<div class="progress-bar" id="matchProgress" style="width:0%;"></div>
					</div>
					<div class="text-muted small mb-3">
						Match mínimo: <strong id="matchThr">—</strong>
						<span class="mx-1">&bull;</span> Encontrados: <strong id="matchHitsCount">—</strong>
						<span class="mx-1">&bull;</span> Obrig. faltando: <strong id="matchMissCount">—</strong>
					</div>
					<div class="fw-semibold mb-1">Requisitos (detalhado)</div>
					<div id="matchReqList" class="d-grid gap-2"></div>
				</div>
				<div id="matchNoVaga" class="alert alert-warning mb-0 d-none" style="border-radius:14px;">
					Selecione uma vaga no contexto (ex.: abrindo pelo Matching) para ver o score.
				</div>
			</div>
		</div>
	</div>
</section>

@section Scripts {
	<script>
		window.__candidatoDetalhesId = "@candidatoId";
		window.__candidatoDetalhesVagaId = @(vagaId.HasValue ? "\"" + vagaId.Value + "\"" : "null");
		window.__candidatosApiUrl = "@Url.Content("~/api/candidatos")";
		window.__vagasApiUrl = "@Url.Content("~/api/vagas")";
	</script>
	<script src="~/js/views/candidatos-detalhes.js" asp-append-version="true"></script>
}
