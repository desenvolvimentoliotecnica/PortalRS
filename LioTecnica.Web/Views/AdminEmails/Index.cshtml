@{
    ViewData["Title"] = "Emails";
    ViewData["SidebarSubtitle"] = "Admin";
}

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", "Tela: Emails")

    <div class="searchbox position-relative d-none d-md-block">
        <i class="bi bi-search"></i>
        <input id="emailsSearchTop" class="form-control" placeholder="Buscar assunto, destinatario..." />
    </div>

    <div class="d-flex align-items-center gap-2">
        @await Html.PartialAsync("_TopbarUserActions", "Admin")
    </div>
}

<section class="content">
    <div class="container-fluid pb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div>
                <h1 class="h4 mb-1">Fila de Emails</h1>
                <div class="text-muted">Acompanhe envios, tentativas e falhas.</div>
            </div>
            <div class="d-flex gap-2">
                <button id="emailsRefresh" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-clockwise me-1"></i>Atualizar
                </button>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card-soft p-3 d-flex align-items-center gap-3 h-100">
                    <div class="kpi-icon bg-primary-subtle text-primary">
                        <i class="bi bi-inbox"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total na fila</div>
                        <div id="kpiTotal" class="h5 mb-0">0</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card-soft p-3 d-flex align-items-center gap-3 h-100">
                    <div class="kpi-icon bg-warning-subtle text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Em processamento</div>
                        <div id="kpiQueued" class="h5 mb-0">0</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card-soft p-3 d-flex align-items-center gap-3 h-100">
                    <div class="kpi-icon bg-danger-subtle text-danger">
                        <i class="bi bi-x-octagon"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Falhas</div>
                        <div id="kpiFailed" class="h5 mb-0">0</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card-soft p-3 d-flex align-items-center gap-3 h-100">
                    <div class="kpi-icon bg-success-subtle text-success">
                        <i class="bi bi-send-check"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Enviados hoje</div>
                        <div id="kpiSentToday" class="h5 mb-0">0</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-soft p-3 mb-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <div>
                    <p class="mini-title mb-1">Lista</p>
                    <div class="fw-bold">Emails monitorados</div>
                    Use a lista abaixo para acompanhar fila, falhas e reprocessar.
                </div>
            </div>

            <div class="row g-2 align-items-end">
                <div class="col-12 col-lg-3">
                    <label class="form-label small text-muted">Buscar</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text" style="border-color:var(--lt-border); background: rgba(255,255,255,.65);">
                            <i class="bi bi-search"></i>
                        </span>
                        <input id="emailsSearch" class="form-control" placeholder="assunto, destinatario..." style="border-color:var(--lt-border);" />
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small text-muted">Escopo</label>
                    <select id="emailsScope" class="form-select form-select-sm" style="border-color:var(--lt-border);">
                        <option value="mine">Minha caixa</option>
                        <option value="system">Caixa do sistema</option>
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small text-muted">Status</label>
                    <select id="emailsStatus" class="form-select form-select-sm" style="border-color:var(--lt-border);">
                        <option value="">Todos</option>
                        <option value="Queued">Em fila</option>
                        <option value="InProgress">Enviando</option>
                        <option value="Sent">Enviado</option>
                        <option value="Failed">Falha</option>
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label small text-muted">Pagina</label>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-secondary" id="emailsPrev">Anterior</button>
                        <span class="pill">Pag <span id="emailsPage">1</span>/<span id="emailsPages">1</span></span>
                        <button class="btn btn-sm btn-outline-secondary" id="emailsNext">Proxima</button>
                    </div>
                </div>
                <div class="col-6 col-lg-3 text-lg-end">
                    <div class="text-muted small" id="emailsHint">-</div>
                </div>
            </div>
        </div>

        <div class="card-soft p-3">
            <div class="table-responsive">
                <table class="table align-middle mb-0 emails-table">
                    <thead>
                        <tr>
                            <th class="fit text-uppercase small text-muted text-center">Quando</th>
                            <th class="fit text-uppercase small text-muted text-center">Status</th>
                            <th class="text-uppercase small text-muted text-center">Assunto</th>
                            <th class="fit text-uppercase small text-muted text-center">Para</th>
                            <th class="fit text-uppercase small text-muted text-center">Tentativas</th>
                            <th class="fit text-uppercase small text-muted text-center">Origem</th>
                            <th class="fit text-uppercase small text-muted text-center">Usuario</th>
                            <th class="fit text-uppercase small text-muted text-center">Acoes</th>
                        </tr>
                    </thead>
                    <tbody id="emailsTbody"></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="emailDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="text-muted small">Detalhes do email</div>
                    <h5 id="emailDetailTitle" class="modal-title">-</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap gap-3 mb-3 small text-muted">
                    <div><span class="fw-semibold">Para:</span> <span id="emailDetailTo">-</span></div>
                    <div><span class="fw-semibold">Status:</span> <span id="emailDetailStatus">-</span></div>
                    <div><span class="fw-semibold">Tentativas:</span> <span id="emailDetailAttempts">-</span></div>
                    <div><span class="fw-semibold">Origem:</span> <span id="emailDetailSource">-</span></div>
                </div>
                <div class="mb-3">
                    <div class="fw-semibold mb-2">Conteudo</div>
                    <div id="emailDetailBody" class="border rounded p-3 bg-light small"></div>
                </div>
                <div>
                    <div class="fw-semibold mb-2">Historico de tentativas</div>
                    <div id="emailDetailHistory" class="small text-muted">-</div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="emailRetryBtn" type="button" class="btn btn-outline-danger">
                    <i class="bi bi-arrow-repeat me-1"></i>Reprocessar
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/views/admin-emails.js" asp-append-version="true"></script>
}

@section Footer {
    @{
        var footerItems = new[]
        {
            new { Icon = "bi-envelope", Text = "Emails", Id = "", Class = "" },
            new { Icon = "bi-shield-check", Text = "LGPD", Id = "", Class = "" },
            new { Icon = "", Text = "build: web", Id = "buildId", Class = "mono muted" }
        };
    }
    @await Html.PartialAsync("_Footer", footerItems)
}

<style>
  .emails-table th.fit,
  .emails-table td.fit {
    width: 1%;
    white-space: nowrap;
  }
  .emails-table td,
  .emails-table th {
    vertical-align: middle;
  }
  .emails-table tbody td {
    text-align: center;
  }
  .emails-table tbody td.col-subject,
  .emails-table tbody td.col-to {
    text-align: left;
  }
  .emails-table thead {
    display: table-header-group;
  }
  .emails-table thead th {
    background: rgba(173,200,220,.18);
    color: #6b7280;
    font-weight: 600;
    letter-spacing: .04em;
  }
  .emails-table tbody tr {
    cursor: pointer;
    transition: background 120ms ease;
  }
  .emails-table tbody tr:hover {
    background: #f1f5f9;
  }
  .emails-table tbody tr.is-selected {
    background: #e2e8f0;
  }
  .emails-table tbody tr:hover > td {
    background: #f1f5f9 !important;
  }
  .emails-table tbody tr.is-selected > td {
    background: #e2e8f0 !important;
  }
  .kpi-icon {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
  }
  .email-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .email-status.queued { background: #e7f5ff; color: #1971c2; }
  .email-status.sending { background: #fff3bf; color: #9a6b01; }
  .email-status.sent { background: #d3f9d8; color: #2b8a3e; }
  .email-status.failed { background: #ffe3e3; color: #c92a2a; }
  .email-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .email-chip.origin-portal { background: #e7f5ff; color: #1971c2; }
  .email-chip.origin-sistema { background: #e6fcf5; color: #0ca678; }
  .email-chip.origin-triagem { background: #fff4e6; color: #f08c00; }
  .email-chip.origin-agenda { background: #f3f0ff; color: #7048e8; }
  .email-chip.origin-outro { background: #f1f3f5; color: #495057; }
  .email-chip.attempts-low { background: #e6fcf5; color: #0ca678; }
  .email-chip.attempts-mid { background: #fff4e6; color: #f08c00; }
  .email-chip.attempts-high { background: #ffe3e3; color: #c92a2a; }
  .email-action {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
  }
</style>

