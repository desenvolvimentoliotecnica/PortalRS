@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", "Caixa de entrada de notificacoes")

    <div class="d-flex align-items-center gap-2">
        @await Html.PartialAsync("_TopbarUserActions", "RH")
    </div>
}

<section class="content">
    <div class="page-title">
        <div>
            <h4>Notificacoes</h4>
            <div class="subtitle">Central de avisos e comunicacoes do portal</div>
        </div>
    </div>

    <div class="card-soft p-3">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="fw-bold">Caixa de entrada</div>
            <div class="d-flex gap-2">
                <button class="btn btn-ghost btn-sm" type="button" id="btnTestNotification">
                    <i class="bi bi-bell me-1"></i>Testar notificacao
                </button>
                <button class="btn btn-ghost btn-sm" type="button" id="btnMarkAllRead">
                    <i class="bi bi-check2-all me-1"></i>Marcar tudo como lido
                </button>
                <button class="btn btn-brand btn-sm" type="button">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
            </div>
        </div>

        <div class="d-flex flex-column gap-2" data-role="notif-page-list"></div>
    </div>
</section>

<div class="modal fade" id="notifReceiptsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 18px; border: 1px solid var(--lt-border);">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold">Visualizacoes e leituras</h5>
                    <div class="text-muted small">Usuarios que viram / leram</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="notifReceiptsList" class="d-flex flex-column gap-2"></div>
            </div>
        </div>
    </div>
</div>

@section Footer {
    @await Html.PartialAsync("_Footer", new[] { new { Icon = "bi-bell", Text = "Notificacoes em tempo real" } })
}

@section Scripts {
    <script>
        (() => {
            const btn = document.getElementById("btnTestNotification");
            if (!btn) return;
            btn.addEventListener("click", async () => {
                try {
                    const res = await fetch("/Notifications/_api/send", {
                        method: "POST",
                        headers: { "Accept": "application/json", "X-LT-Silent": "1" },
                        credentials: "same-origin"
                    });
                    if (!res.ok) throw new Error(`status ${res.status}`);
                    if (window.toast) window.toast("Notificacao enviada.");
                } catch (err) {
                    console.error(err);
                    if (window.toast) window.toast("Falha ao enviar notificacao.");
                }
            });
        })();
    </script>
}
