@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", "Caixa de entrada de notificacoes")

    <div class="d-flex align-items-center gap-2">
        @await Html.PartialAsync("_TopbarUserActions", "RH")
    </div>
}

<section class="content">
    <div class="page-title">
        <div>
            <h4>Notificacoes</h4>
            <div class="subtitle">Central de avisos e comunicacoes do portal</div>
        </div>
    </div>

    <div class="card-soft p-3">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="fw-bold">Caixa de entrada</div>
            <div class="d-flex gap-2">
                <button class="btn btn-ghost btn-sm" type="button">
                    <i class="bi bi-check2-all me-1"></i>Marcar tudo como lido
                </button>
                <button class="btn btn-brand btn-sm" type="button">
                    <i class="bi bi-funnel me-1"></i>Filtrar
                </button>
            </div>
        </div>

        <div class="d-flex flex-column gap-2" data-role="notif-page-list"></div>
    </div>
</section>

@section Footer {
    @await Html.PartialAsync("_Footer", new[] { new { Icon = "bi-bell", Text = "Notificacoes em tempo real" } })
}
