@{
    ViewData["Title"] = "Templates de Email";
    ViewData["SidebarSubtitle"] = "Admin";
}

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", "Tela: Templates de Email")

    <div class="searchbox position-relative d-none d-md-block">
        <i class="bi bi-search"></i>
        <input id="tplSearchTop" class="form-control" placeholder="Buscar template..." />
    </div>

    <div class="d-flex align-items-center gap-2">
        @await Html.PartialAsync("_TopbarUserActions", "Admin")
    </div>
}

<section class="content">
<div class="container-fluid pb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1">Templates de Email</h1>
            <div class="text-muted">Gerencie os templates e versoes.</div>
        </div>
        <div class="d-flex gap-2">
            <button id="btnNewTemplate" class="btn btn-brand">
                <i class="bi bi-plus-lg me-1"></i>Novo template
            </button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card-soft p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="fw-semibold">Templates</div>
                    <div class="text-muted small" id="tplCount">0</div>
                </div>
                <div class="input-group input-group-sm mb-3">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input id="tplSearch" class="form-control" type="search" placeholder="Buscar por nome..." />
                </div>
                <div id="tplList" class="list-group list-group-flush small"></div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card-soft p-3 h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div>
                        <div class="text-muted small">Selecionado</div>
                        <div id="tplName" class="fw-semibold">Nenhum</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button id="btnActivate" class="btn btn-outline-success btn-sm" disabled>
                            <i class="bi bi-check2-circle me-1"></i>Ativar
                        </button>
                        <button id="btnSave" class="btn btn-primary btn-sm" disabled>
                            <i class="bi bi-save me-1"></i>Salvar nova versao
                        </button>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Assunto</label>
                        <input id="tplSubject" class="form-control" type="text" placeholder="Assunto do email" />
                    </div>
                    <div class="col-12">
                        <label class="form-label d-flex align-items-center gap-2">
                            <span>Corpo (HTML)</span>
                            <span class="badge bg-light text-dark border">Tokens: {{Nome}}, {{VagaTitulo}}, {{PortalAccessKey}}</span>
                        </label>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button class="btn btn-outline-secondary btn-sm" type="button" data-cmd="bold"><b>B</b></button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" data-cmd="italic"><i>I</i></button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" data-cmd="underline"><u>U</u></button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" data-cmd="insertUnorderedList"><i class="bi bi-list-ul"></i></button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" data-cmd="createLink"><i class="bi bi-link-45deg"></i></button>
                        </div>
                        <div id="tplEditor" class="form-control" contenteditable="true" style="min-height: 260px;"></div>
                        <div class="form-text">Edite o HTML e use os tokens entre chaves.</div>
                    </div>
                </div>

                <div class="border-top pt-3 mt-3 text-muted small">
                    <span id="tplMeta">Versao: -</span>
                </div>
            </div>
        </div>
    </div>
</div>
</section>

@section Scripts {
    @if (ViewData["OwnerConfigApiBase"] != null)
    {
        <script>window.__ownerConfigApiBase = "@ViewData["OwnerConfigApiBase"]";</script>
    }
    <script src="~/js/views/admin-email-templates.js?v=@DateTimeOffset.UtcNow.ToUnixTimeSeconds()"></script>
}

@section Footer {
    @{
        var footerItems = new[]
        {
            new { Icon = "bi-envelope-paper", Text = "Email", Id = "", Class = "" },
            new { Icon = "bi-shield-check", Text = "LGPD", Id = "", Class = "" },
            new { Icon = "", Text = "build: web", Id = "buildId", Class = "mono muted" }
        };
    }
    @await Html.PartialAsync("_Footer", footerItems)
}

