@{
	ViewData["Title"] = "Portal RH • Gestão • Resumo de Atividades";
	ViewData["SidebarSubtitle"] = "Gestão";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", (string)null)

	<div class="d-flex align-items-center gap-2">
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content">
	<div class="page-title d-flex flex-wrap align-items-center justify-content-between gap-2">
		<h4 class="mb-0">Resumo de Atividades</h4>
		<div class="d-flex flex-nowrap align-items-center gap-2">
			<select class="form-select form-select-sm page-title-select" id="filtroPeriodo">
				<option value="7">Últimos 7 dias</option>
				<option value="30" selected>Últimos 30 dias</option>
				<option value="90">Últimos 90 dias</option>
			</select>
			<select class="form-select form-select-sm page-title-select" id="filtroTipo">
				<option value="">Todas as atividades</option>
				<option value="feedback">Feedbacks</option>
				<option value="plano">Planos / Metas</option>
				<option value="1a1">Reuniões 1:1</option>
				<option value="humor">Humor</option>
			</select>
			<button class="btn btn-ghost" type="button" title="Atualizar">
				<i class="bi bi-arrow-counterclockwise"></i><span class="d-none d-sm-inline ms-1">Atualizar</span>
			</button>
		</div>
	</div>

	<div class="card-soft p-3 mb-3">
		<div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
			<div>
				<div class="fw-bold">Filtros</div>
				<div class="text-muted small">Período e tipo de atividade alteram a lista abaixo.</div>
			</div>
		</div>
	</div>

	<div class="card-soft p-3">
		<div class="fw-bold mb-2">Timeline</div>
		<div class="text-muted small mb-3">Atividades ordenadas da mais recente para a mais antiga.</div>

		<div class="timeline-placeholder border-start border-2 ps-3 py-4" id="timelineAtividades">
			<div class="text-muted small">
				<i class="bi bi-activity me-1"></i>
				Nenhuma atividade no período. Conecte à API de resumo de atividades para exibir a timeline.
			</div>
		</div>

		<div class="mt-3 text-muted small">
			<i class="bi bi-info-circle me-1"></i>
			Exemplo de itens: feedback enviado/recebido, meta concluída, reunião 1:1 realizada, resposta de humor.
		</div>
	</div>
</section>
