@{
	ViewData["Title"] = "Portal RH • Gestão • Humor";
	ViewData["SidebarSubtitle"] = "Gestão";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", (string)null)

	<div class="d-flex align-items-center gap-2">
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content">
	<div class="page-title d-flex flex-wrap align-items-center justify-content-between gap-2">
		<div>
			<h4>Humor</h4>
		</div>
		<div class="d-flex flex-nowrap align-items-center gap-2">
			<select class="form-select form-select-sm page-title-select" id="filtroPeriodo">
				<option value="7">Últimos 7 dias</option>
				<option value="30" selected>Últimos 30 dias</option>
				<option value="90">Últimos 90 dias</option>
			</select>
			<button class="btn btn-ghost" type="button" title="Atualizar">
				<i class="bi bi-arrow-counterclockwise"></i><span class="d-none d-sm-inline ms-1">Atualizar</span>
			</button>
		</div>
	</div>

	<div class="row g-3">
		<div class="col-12 col-lg-4">
			<div class="card-soft p-3">
				<div class="fw-bold mb-2">Média geral</div>
				<div class="text-muted small mb-2">Índice de humor no período selecionado.</div>
				<div class="display-6 fw-bold text-primary" id="mediaHumor">—</div>
				<div class="progress mt-2" style="height: 8px;">
					<div class="progress-bar" id="barraHumor" role="progressbar" style="width: 0%"></div>
				</div>
			</div>
		</div>
		<div class="col-12 col-lg-8">
			<div class="card-soft p-3">
				<div class="fw-bold mb-2">Evolução</div>
				<div class="text-muted small">Gráfico de evolução do humor (será preenchido pela API).</div>
				<div class="mt-3 p-4 border rounded bg-light text-muted text-center" id="placeholderGrafico">
					<i class="bi bi-graph-up"></i> Área para gráfico de evolução
				</div>
			</div>
		</div>
	</div>

	<div class="card-soft p-3 mt-3">
		<div class="fw-bold mb-2">Por colaborador</div>
		<div class="text-muted small mb-3">Última resposta de humor por pessoa da equipe.</div>
		<div class="table-responsive">
			<table class="table table-sm align-middle mb-0" id="tabelaHumor">
				<thead>
					<tr>
						<th>Colaborador</th>
						<th>Última resposta</th>
						<th>Valor</th>
						<th>Comentário</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td colspan="4" class="text-center text-muted py-4">
							Nenhum dado de humor no período. Conecte à API de humor para exibir as respostas.
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</section>
