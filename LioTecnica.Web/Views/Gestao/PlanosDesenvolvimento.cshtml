@{
	ViewData["Title"] = "Portal RH • Gestão • Planos de Desenvolvimento";
	ViewData["SidebarSubtitle"] = "Gestão";
}

@section Topbar {
	@await Html.PartialAsync("_TopbarBrand", "Gestão • Planos de Desenvolvimento")

	<div class="d-flex align-items-center gap-2">
		<button class="btn btn-ghost" type="button" id="btnFiltro" title="Filtros">
			<i class="bi bi-sliders"></i><span class="d-none d-sm-inline ms-1">Filtros</span>
		</button>
		<button class="btn btn-brand" type="button" id="btnNovoPlano" title="Novo plano">
			<i class="bi bi-plus-lg"></i><span class="d-none d-sm-inline ms-1">Novo plano</span>
		</button>
		@await Html.PartialAsync("_TopbarUserActions", "RH")
	</div>
}

<section class="content">
	<div class="page-title">
		<div>
			<h4>Gestão dos Planos de Desenvolvimento</h4>
			<div class="subtitle">Crie e acompanhe planos de desenvolvimento e metas dos seus colaboradores.</div>
		</div>
	</div>

	<div class="card-soft p-3 mb-3">
		<div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
			<div>
				<div class="fw-bold">Planos da equipe</div>
				<div class="text-muted small">Lista de planos de desenvolvimento por colaborador.</div>
			</div>
			<div class="d-flex gap-2">
				<select class="form-select form-select-sm" id="filtroColaborador" style="min-width: 200px;">
					<option value="">Todos os colaboradores</option>
				</select>
				<select class="form-select form-select-sm" id="filtroStatus" style="min-width: 140px;">
					<option value="">Todos</option>
					<option value="ativo">Em andamento</option>
					<option value="concluido">Concluídos</option>
				</select>
			</div>
		</div>
	</div>

	<div class="card-soft p-3">
		<div class="table-responsive">
			<table class="table table-sm align-middle table-hover mb-0" id="tabelaPlanos">
				<thead>
					<tr>
						<th>Colaborador</th>
						<th>Plano</th>
						<th>Metas</th>
						<th>Status</th>
						<th>Última atualização</th>
						<th class="text-end">Ações</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td colspan="6" class="text-center text-muted py-4">
							Nenhum plano cadastrado. Use <strong>Novo plano</strong> para criar um plano de desenvolvimento.
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<div class="text-muted small mt-2">
		<i class="bi bi-info-circle me-1"></i>
		Conecte à API de planos de desenvolvimento para listar e editar planos.
	</div>
</section>
