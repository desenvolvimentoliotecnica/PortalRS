@using System.Security.Claims
@inject IConfiguration Configuration
<!doctype html>
<html lang="pt-br">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@ViewData["Title"]</title>

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/initials-badges.css" asp-append-version="true" />
</head>
<body>

	<!-- MOBILE SIDEBAR OFFCANVAS -->
	@await Html.PartialAsync("_OffcanvasSidebar")
	@await Html.PartialAsync("_ModalNotifications")
	@await Html.PartialAsync("_ResetDbModal")

	<div class="app-shell">
		<!-- DESKTOP SIDEBAR -->
		<aside class="sidebar d-none d-lg-block">
			<div class="sidebar-inner">
				<div class="brand">
					<span id="logoDesktop" class="logo-initials" aria-label="LT">LT</span>
					<div class="title">
						<strong>Portal RH</strong>
						<span>@ViewHelpers.SidebarSubtitle(ViewData)</span>
					</div>
				</div>

				<div class="sidebar-scroll">
					@{
						var layoutTenantId = User?.FindFirst("tenant")?.Value ?? string.Empty;

						var isInTenantContext = !string.IsNullOrEmpty(layoutTenantId) && !string.Equals(layoutTenantId, "owner", StringComparison.OrdinalIgnoreCase);

						var hasOwnerCookie = !string.IsNullOrWhiteSpace(Context.Request.Cookies["OwnerAccessToken"]);

						var isOwnerContext = User?.Identity?.IsAuthenticated == true && (User.IsInRole("Owner") || hasOwnerCookie) && !isInTenantContext;
					}
					@if (isOwnerContext)

					{
						@await Component.InvokeAsync("OwnerMenu", new { linkClass = "nav-link" })
					}

					else

					{
						@await Component.InvokeAsync("MainMenu", new { linkClass = "nav-link" })
					}
				</div>

				<div class="sidebar-footer">
					<div class="d-flex align-items-center justify-content-between gap-2">
						<div class="small" style="opacity:.92;">
							<div class="fw-semibold">Ambiente</div>
							<div class="opacity-75">DEV • Postgres</div>
						</div>
						<span class="pill"><i class="bi bi-shield-check"></i>LGPD</span>
					</div>
				</div>
			</div>
		</aside>

		<!-- MAIN -->
		<main class="main">
			<header class="topbar">
				<div class="topbar-inner">
					@RenderSection("Topbar", required: true)
				</div>
			</header>

			@RenderBody()

			@if (IsSectionDefined("Footer"))
			{
					<footer class="footer">
					@RenderSection("Footer", required: false)
					</footer>
			}
		</main>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	@{
		var accessToken = User?.FindFirst("access_token")?.Value ?? string.Empty;

		var tenantId = User?.FindFirst("tenant")?.Value ?? string.Empty;
	}
	<script>
		window.__enumData = {};
		window.__enumDataLoaded = false;
		window.__enumsUrl = "@Url.Content("~/api/lookup/enums")";
		window.__healthUrl = "@Url.Content("~/api/health")";
		window.__notificationsUrl = "@Url.Content("~/Notifications/_api/list")";
		window.__tenantId = "@tenantId";
		window.__apiAccessToken = "@accessToken";
		window.__notificationsHubUrl = "@((Configuration["Endpoints:RhApi"] ?? string.Empty).TrimEnd('/') + "/hubs/notifications")";
		window.__isAdmin = "@(User?.IsInRole("Admin") == true ? "1" : "0")";
	</script>
	<script src="~/lib/signalr/signalr.min.js"></script>
	<script src="~/js/utils.js" asp-append-version="true"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@RenderSection("Scripts", required: false)
</body>
</html>
