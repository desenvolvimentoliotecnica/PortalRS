@model (IReadOnlyList<LioTecnica.Web.Infrastructure.ApiClients.AllowedTenantItemDto> Tenants, string? CurrentTenantId)
@{
    var current = (Model.CurrentTenantId ?? string.Empty).Trim();
    var isInTenantContext = !string.IsNullOrEmpty(current) && !string.Equals(current, "owner", StringComparison.OrdinalIgnoreCase);
}
@if (isInTenantContext)
{
    <form method="post" action="/Account/SwitchTenant" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="tenantId" value="owner" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-arrow-left me-1"></i>Sair do tenant
        </button>
    </form>
}
