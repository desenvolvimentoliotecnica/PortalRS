@model (string ModuleKey, string Label, IReadOnlyList<LioTecnica.Web.ViewModels.Admin.MenuForCurrentUserViewModel> Items, bool Expanded)
@using LioTecnica.Web.Helpers
@{
    var linkClass = ViewData["LinkClass"]?.ToString() ?? "nav-link";
    var tenantId = ViewData["TenantId"]?.ToString();
    var uid = ViewData["ModuleUid"]?.ToString() ?? Guid.NewGuid().ToString("N")[..8];
    var collapseId = $"menu-module-{Model.ModuleKey}-{uid}";
    var collapseClass = Model.Expanded ? "collapse show" : "collapse";
    var ariaExpanded = Model.Expanded ? "true" : "false";

    var roots = Model.Items.Where(x => !x.ParentId.HasValue).OrderBy(x => x.Order).ToList();
    var childrenByParentId = Model.Items.Where(x => x.ParentId.HasValue).GroupBy(x => x.ParentId!.Value).ToDictionary(g => g.Key, g => g.OrderBy(x => x.Order).ToList());
}
<div class="sidebar-module nav-module mt-2">
    <button type="button"
            class="nav-section nav-section-toggle d-flex align-items-center justify-content-between w-100 border-0 rounded-2 text-start"
            data-bs-toggle="collapse"
            data-bs-target="#@collapseId"
            aria-expanded="@ariaExpanded"
            aria-controls="@collapseId"
            id="@(collapseId)-trigger">
        <span>@Model.Label</span>
        <span class="nav-module-chevron" aria-hidden="true">
            <i class="bi bi-chevron-right nav-chevron-collapsed"></i>
            <i class="bi bi-chevron-down nav-chevron-expanded"></i>
        </span>
    </button>
    <div class="@collapseClass nav-module-body" id="@collapseId" aria-labelledby="@(collapseId)-trigger">
        <div class="nav-group">
            @* Always expose an "Início" shortcut for Feedback module (links to /Feedback/Feedbacks) *@
            <div class="nav-item mt-1">
                <a class="@(linkClass) d-flex align-items-center" href="/Feedback/Feedbacks">
                    <i class="bi bi-house me-2"></i>Início
                </a>
            </div>
            @foreach (var menu in roots)
            {
                var children = childrenByParentId.TryGetValue(menu.Id, out var c) ? c : null;
                var isParentWithChildren = children != null && children.Count > 0;
                if (isParentWithChildren)
                {
                    var subUid = Guid.NewGuid().ToString("N")[..6];
                    var subCollapseId = $"menu-sub-{Model.ModuleKey}-{menu.Id:N}-{subUid}";
                    var hasActiveChild = children!.Any(m => string.Equals((ViewContext.HttpContext.Request.Path.Value ?? "").TrimEnd('/'), (m.Route ?? "").TrimEnd('/'), StringComparison.OrdinalIgnoreCase));
                    var subCollapseClass = hasActiveChild ? "collapse show" : "collapse";
                    <div class="nav-item-sub mt-1">
                        <button type="button"
                                class="nav-link nav-section-toggle d-flex align-items-center w-100 border-0 rounded-2 text-start bg-transparent"
                                data-bs-toggle="collapse"
                                data-bs-target="#@subCollapseId"
                                aria-expanded="@(hasActiveChild ? "true" : "false")"
                                aria-controls="@subCollapseId">
                            <i class="bi @menu.Icon me-2"></i>
                            <span class="nav-sub-label">@menu.DisplayName</span>
                            <span class="nav-sub-chevron" aria-hidden="true">
                                <i class="bi bi-chevron-right nav-chevron-collapsed"></i>
                                <i class="bi bi-chevron-down nav-chevron-expanded"></i>
                            </span>
                        </button>
                        <div class="@subCollapseClass nav-group ps-3" id="@subCollapseId">
                            @foreach (var child in children!)
                            {
                                ViewData["LinkClass"] = linkClass;
                                ViewData["TenantId"] = tenantId;
                                @await Html.PartialAsync("_MenuItem", child)
                            }
                        </div>
                    </div>
                }
                else
                {
                    ViewData["LinkClass"] = linkClass;
                    ViewData["TenantId"] = tenantId;
                    @await Html.PartialAsync("_MenuItem", menu)
                }
            }
        </div>
    </div>
</div>
