@model (string ModuleKey, string Label, IReadOnlyList<LioTecnica.Web.ViewModels.Admin.MenuForCurrentUserViewModel> Items, bool Expanded)
@{
    var linkClass = ViewData["LinkClass"]?.ToString() ?? "nav-link";
    var tenantId = ViewData["TenantId"]?.ToString();
    var uid = ViewData["ModuleUid"]?.ToString() ?? Guid.NewGuid().ToString("N")[..8];
    var collapseId = $"menu-module-{Model.ModuleKey}-{uid}";
    var collapseClass = Model.Expanded ? "collapse show" : "collapse";
    var ariaExpanded = Model.Expanded ? "true" : "false";
}
<div class="sidebar-module nav-module mt-2">
    <button type="button"
            class="nav-section nav-section-toggle d-flex align-items-center justify-content-between w-100 border-0 rounded-2 text-start"
            data-bs-toggle="collapse"
            data-bs-target="#@collapseId"
            aria-expanded="@ariaExpanded"
            aria-controls="@collapseId"
            id="@(collapseId)-trigger">
        <span>@Model.Label</span>
        <span class="nav-module-chevron" aria-hidden="true">
            <i class="bi bi-chevron-right nav-chevron-collapsed"></i>
            <i class="bi bi-chevron-down nav-chevron-expanded"></i>
        </span>
    </button>
    <div class="@collapseClass nav-module-body" id="@collapseId" aria-labelledby="@(collapseId)-trigger">
        <div class="nav-group">
            @foreach (var menu in Model.Items.OrderBy(x => x.Order))
            {
                ViewData["LinkClass"] = linkClass;
                ViewData["TenantId"] = tenantId;
                @await Html.PartialAsync("_MenuItem", menu)
            }
        </div>
    </div>
</div>
