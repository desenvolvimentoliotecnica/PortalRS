@model LioTecnica.Web.ViewModels.Admin.MenuForCurrentUserViewModel
@using LioTecnica.Web.Helpers
@{
    var linkClass = ViewData["LinkClass"]?.ToString() ?? "nav-link";
    var tenantId = ViewData["TenantId"]?.ToString();
    var openInNewTab = Model.OpenInNewTab;
    var target = openInNewTab ? "_blank" : null;
    var rel = openInNewTab ? "noopener" : null;
    var href = Model.Route;
    if (!string.IsNullOrWhiteSpace(tenantId) && string.Equals(Model.Route, "/PortalVagas", StringComparison.OrdinalIgnoreCase))
    {
        href = $"{Model.Route}?tenantId={tenantId}";
    }
}
<a class="@linkClass nav-child @ViewHelpers.NavActiveByPath(ViewContext, Model.Route)" href="@href" target="@target" rel="@rel">
    <i class="bi @Model.Icon"></i>@Model.DisplayName
</a>
