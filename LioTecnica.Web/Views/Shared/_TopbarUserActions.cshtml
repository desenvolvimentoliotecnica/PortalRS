@model string
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T

<div class="dropdown">
    <button class="btn btn-ghost dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-bell me-1"></i><span class="d-none d-sm-inline">@T["UserMenu_Notifications"]</span>
        <span class="badge text-bg-danger ms-1 notif-badge" data-role="notif-count">3</span>
    </button>

    <div class="dropdown-menu dropdown-menu-end p-0 notif-dropdown">
        <div class="px-3 py-2 border-bottom">
            <div class="fw-semibold">@T["UserMenu_Notifications"]</div>
            <div class="text-muted small">Ultimas atualizacoes</div>
        </div>

        <div class="list-group list-group-flush">
            <a class="list-group-item list-group-item-action notif-item" href="/Notificacoes">
                <div class="d-flex justify-content-between">
                    <div class="fw-semibold"><i class="bi bi-person-plus me-1"></i>Novo candidato</div>
                    <span class="text-muted small">Agora</span>
                </div>
                <div class="small text-muted">Vaga: Analista de Dados (BI)</div>
            </a>
            <a class="list-group-item list-group-item-action notif-item" href="/Notificacoes">
                <div class="d-flex justify-content-between">
                    <div class="fw-semibold"><i class="bi bi-calendar-event me-1"></i>Entrevista agendada</div>
                    <span class="text-muted small">Hoje</span>
                </div>
                <div class="small text-muted">Mariana Souza - 14:00</div>
            </a>
            <a class="list-group-item list-group-item-action notif-item" href="/Notificacoes">
                <div class="d-flex justify-content-between">
                    <div class="fw-semibold"><i class="bi bi-exclamation-triangle me-1"></i>SLA de triagem</div>
                    <span class="text-muted small">2h</span>
                </div>
                <div class="small text-muted">Supervisor de Qualidade</div>
            </a>
        </div>

        <div class="p-2 border-top d-flex gap-2">
            <a class="btn btn-ghost btn-sm w-100" href="/Notificacoes">
                <i class="bi bi-inbox me-1"></i>Ver todas
            </a>
        </div>
    </div>
</div>

@await Html.PartialAsync("_TopbarUserMenu", Model)

