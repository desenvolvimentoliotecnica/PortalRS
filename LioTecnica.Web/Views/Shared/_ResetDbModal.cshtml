@inject IConfiguration Config
<!-- Modal: Reset Database (DEV) -->
<div class="modal fade" id="resetDbModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-database-exclamation me-2"></i>Resetar base (DEV)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar" id="resetDbClose"></button>
            </div>

            <div class="modal-body">
                <div class="alert alert-danger small mb-3">
                    <strong>Atenção:</strong> isso pode apagar dados e recriar o schema, rodar migrations e re-seedar.
                    Use apenas em <strong>Development</strong>.
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="resetDbReset" checked>
                    <label class="form-check-label" for="resetDbReset">
                        Resetar banco (drop schema + migrations)
                    </label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="resetDbClean">
                    <label class="form-check-label" for="resetDbClean">
                        Limpar base (apenas dados, mantém schema)
                    </label>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="resetDbReseed" checked>
                    <label class="form-check-label" for="resetDbReseed">
                        Fazer seed
                    </label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="resetDbConfirm">
                    <label class="form-check-label" for="resetDbConfirm">
                        Eu entendo que esta ação apaga dados do banco
                    </label>
                </div>

                <div id="resetDbStatus" class="small text-muted mt-2 d-none"></div>
<div id="resetDbLog" class="small text-muted mt-2 d-none" style="max-height: 160px; overflow: auto;"></div>
<div class="progress d-none mt-2" id="resetDbProgress">
    <div class="progress-bar" id="resetDbProgressBar" role="progressbar" style="width: 0%"></div>
</div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" id="resetDbCancel">
                    Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="btnResetDb">
                    <span class="spinner-border spinner-border-sm me-2 d-none" id="resetDbSpinner" role="status" aria-hidden="true"></span>
                    Executar
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/signalr/signalr.min.js"></script>
<script>
    (function () {
        const apiBase = '@(Config["Endpoints:RhApi"]?.TrimEnd('/') ?? string.Empty)';
        const tenantId = '@(User?.FindFirst("tenant")?.Value ?? string.Empty)';
        const btn = document.getElementById('btnResetDb');
        const confirmChk = document.getElementById('resetDbConfirm');
        const resetChk = document.getElementById('resetDbReset');
        const cleanChk = document.getElementById('resetDbClean');
        const reseedChk = document.getElementById('resetDbReseed');
        const spinner = document.getElementById('resetDbSpinner');
        const status = document.getElementById('resetDbStatus');
        const closeBtn = document.getElementById('resetDbClose');
        const cancelBtn = document.getElementById('resetDbCancel');
        const progress = document.getElementById('resetDbProgress');
        const progressBar = document.getElementById('resetDbProgressBar');
        const log = document.getElementById('resetDbLog');
        let connection = null;

        function setBusy(isBusy) {
            btn.disabled = isBusy;
            resetChk.disabled = isBusy;
            cleanChk.disabled = isBusy;
            reseedChk.disabled = isBusy;
            confirmChk.disabled = isBusy;
            if (closeBtn) closeBtn.disabled = isBusy;
            if (cancelBtn) cancelBtn.disabled = isBusy;
            spinner.classList.toggle('d-none', !isBusy);
        }

        function setStatus(text, isError) {
            status.classList.remove('d-none');
            status.classList.toggle('text-danger', !!isError);
            status.classList.toggle('text-muted', !isError);
            status.textContent = text;
        }

        function setProgress(percent) {
            if (percent == null) return;
            progress.classList.remove('d-none');
            progressBar.style.width = percent + '%';
            progressBar.textContent = percent + '%';
            progressBar.setAttribute('aria-valuenow', percent);
        }

        function appendLog(text) {
            log.classList.remove('d-none');
            const line = document.createElement('div');
            line.textContent = text;
            log.appendChild(line);
            log.scrollTop = log.scrollHeight;
        }

        async function ensureConnection() {
            if (!window.signalR || !apiBase || !tenantId) return null;
            if (connection && connection.state === signalR.HubConnectionState.Connected)
                return connection;

            connection = new signalR.HubConnectionBuilder()
                .withUrl(apiBase + '/hubs/ops-reset?tenantId=' + encodeURIComponent(tenantId))
                .withAutomaticReconnect()
                .build();

            connection.on('resetProgress', message => {
                if (!message) return;
                if (message.message) appendLog(message.message);
                if (typeof message.percent === 'number') setProgress(message.percent);
                if (message.stage === 'done') setStatus('Conclu?do. Recarregando...', false);
            });

            await connection.start();
            return connection;
        }

        // Fecha o dropdown caso ele esteja aberto (evita ficar "travado" visualmente)
        function closeAnyOpenDropdown() {
            const open = document.querySelector('.dropdown-menu.show');
            if (!open) return;
            const toggle = open.closest('.dropdown')?.querySelector('[data-bs-toggle="dropdown"]');
            if (!toggle) return;
            try { bootstrap.Dropdown.getOrCreateInstance(toggle).hide(); } catch {}
        }

        // Quando o modal abrir, fecha dropdown
        const modalEl = document.getElementById('resetDbModal');
        modalEl?.addEventListener('show.bs.modal', closeAnyOpenDropdown);

        btn?.addEventListener('click', async () => {
            if (!resetChk.checked && !cleanChk.checked) {
                setStatus('Selecione Resetar banco ou Limpar base.', true);
                return;
            }
            if (!confirmChk.checked) {
                setStatus('Marque a confirmação antes de continuar.', true);
                return;
            }

            setBusy(true);
            setStatus('Executando... aguarde.', false);
            progress.classList.add('d-none');
            log.classList.add('d-none');
            log.innerHTML = '';

            try {
                const hub = await ensureConnection();
                const connectionId = hub?.connectionId || null;

                const resp = await fetch('/ops/reset-database', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-LT-Silent': '1' },
                    body: JSON.stringify({
                        reset: resetChk.checked,
                        clean: cleanChk.checked,
                        reseed: reseedChk.checked,
                        connectionId: connectionId
                    })
                });

                if (!resp.ok) {
                    const txt = await resp.text();
                    throw new Error(txt || ('HTTP ' + resp.status));
                }

                setStatus('Conclu?do. Recarregando...', false);
                setTimeout(() => location.reload(), 800);
            } catch (e) {
                setStatus('Falha ao resetar: ' + (e?.message || e), true);
                setBusy(false);
            }
        });
    })();
</script>

