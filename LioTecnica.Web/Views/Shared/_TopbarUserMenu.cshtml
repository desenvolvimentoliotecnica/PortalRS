@model string
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T

@{
    var label = string.IsNullOrWhiteSpace(Model) ? T["UserMenu_DefaultLabel"].Value : Model;

    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name; // pt-BR / en-US
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="dropdown">
    <button class="btn btn-ghost dropdown-toggle" data-bs-toggle="dropdown">
        <i class="bi bi-person-circle me-1"></i><span class="d-none d-sm-inline">@label</span>
    </button>

    <ul class="dropdown-menu dropdown-menu-end">
        @if (User?.IsInRole("Owner") == true)
        {
            var currentTenant = User.FindFirst("tenant")?.Value?.Trim();
            var isInTenantContext = !string.IsNullOrEmpty(currentTenant) && !string.Equals(currentTenant, "owner", StringComparison.OrdinalIgnoreCase);
            if (isInTenantContext)
            {
                <li>
                    <form action="/Account/SwitchTenant" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tenantId" value="owner" />
                        <button type="submit" class="dropdown-item">
                            <i class="bi bi-building me-2"></i>Voltar à área Owner
                        </button>
                    </form>
                </li>
                <li><hr class="dropdown-divider"></li>
            }
        }
        <li>
            <a class="dropdown-item" href="#">
                <i class="bi bi-person-gear me-2"></i>@T["UserMenu_Profile"]
            </a>
        </li>
        <li>
            <a class="dropdown-item" href="/PortalVagas" target="_blank" rel="noopener">
                <i class="bi bi-globe2 me-2"></i>Portal de Vagas
            </a>
        </li>

        <!-- DEV OPS -->
        <li>
            <a class="dropdown-item text-warning" href="#" data-bs-toggle="modal" data-bs-target="#resetDbModal">
                <i class="bi bi-exclamation-triangle me-2"></i>Resetar base (DEV)
            </a>
        </li>
        <li><hr class="dropdown-divider"></li>

        <!-- Language -->
        <li class="px-2">
            <div class="small text-muted px-2 pt-1">@T["UserMenu_Language"]</div>

            <form asp-controller="Culture" asp-action="Set" method="post" class="px-2 pb-2">
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <select class="form-select form-select-sm mt-1" name="culture" onchange="this.form.submit()">
                    <option value="pt-BR" selected="@(currentCulture.StartsWith("pt", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        Português (Brasil)
                    </option>
                    <option value="en-US" selected="@(currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                        English (US)
                    </option>
                </select>
            </form>
        </li>

        <li><hr class="dropdown-divider"></li>

        <li>
            <form action="/Account/Logout" method="post" class="m-0">
                <button type="submit" class="dropdown-item text-danger">
                    <i class="bi bi-box-arrow-right me-2"></i>@T["UserMenu_Logout"]
                </button>
            </form>
        </li>

    </ul>
</div>
