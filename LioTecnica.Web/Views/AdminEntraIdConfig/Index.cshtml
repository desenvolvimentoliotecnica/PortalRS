@{
    ViewData["Title"] = "Configuracao Entra ID";
    ViewData["SidebarSubtitle"] = "Admin";
}

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", "Tela: Configuracao Entra ID")

    <div class="d-flex align-items-center gap-2">
        @await Html.PartialAsync("_TopbarUserMenu", "Admin")
    </div>
}

<section class="content">
    <div class="container-fluid pb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div>
                <h1 class="h4 mb-1">Login Microsoft (Entra ID)</h1>
                <div class="text-muted">Configure a autenticacao corporativa do portal.</div>
            </div>
            <div class="d-flex gap-2">
                <button id="btnSaveConfig" class="btn btn-brand">
                    <i class="bi bi-save me-1"></i>Salvar
                </button>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-7">
                <div class="card-soft p-3 h-100">
                    <div class="row g-2">
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="entraEnabled">
                                <label class="form-check-label" for="entraEnabled">Ativar login com Microsoft</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Tenant ID (Entra)</label>
                            <input id="entraTenantId" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Client ID</label>
                            <input id="entraClientId" class="form-control" placeholder="App (client) ID" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Client Secret</label>
                            <input id="entraClientSecret" type="password" class="form-control" placeholder="********" />
                            <div id="entraHasSecret" class="form-text text-muted"></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Callback Path</label>
                            <input id="entraCallbackPath" class="form-control" placeholder="/signin-entra" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card-soft p-3 h-100">
                    <p class="mini-title mb-1">Dicas de configuracao</p>
                    <ul class="text-muted small mb-0">
                        <li>App Registration: single-tenant no Entra ID.</li>
                        <li>Redirect URI: https://SEU_HOST/signin-entra</li>
                        <li>Permissao OpenID: openid, profile, email.</li>
                        <li>Reinicie o portal web apos salvar para aplicar.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/views/admin-entra-config.js" asp-append-version="true"></script>
}

@section Footer {
    @{
        var footerItems = new[]
        {
            new { Icon = "bi-microsoft", Text = "Entra ID", Id = "", Class = "" },
            new { Icon = "bi-gear", Text = "Config", Id = "", Class = "" },
            new { Icon = "", Text = "build: web", Id = "buildId", Class = "mono muted" }
        };
    }
    @await Html.PartialAsync("_Footer", footerItems)
}
