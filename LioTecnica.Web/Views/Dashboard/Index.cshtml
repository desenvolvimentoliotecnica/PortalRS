@model PageSeedViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer T

@{
    ViewData["Title"] = T["Page_Title"].Value;                 // "Portal RH • Devcraft Studio"
    ViewData["SidebarSubtitle"] = T["Sidebar_Subtitle"].Value; // "Recrutamento & Match"
}

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", T["Topbar_Brand"].Value)

    <div class="searchbox position-relative d-none d-md-block">
        <i class="bi bi-search"></i>
        <input id="globalSearch" class="form-control" placeholder="@T["GlobalSearch_Placeholder"]" />
    </div>

    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-ghost" type="button" data-bs-toggle="offcanvas" data-bs-target="#drawerFilters">
            <i class="bi bi-sliders"></i>
            <span class="d-none d-sm-inline ms-1">@T["Btn_Filters"]</span>
        </button>

        <button class="btn btn-brand" type="button" data-bs-toggle="offcanvas" data-bs-target="#drawerQuick">
            <i class="bi bi-plus-lg"></i>
            <span class="d-none d-sm-inline ms-1">@T["Btn_Actions"]</span>
        </button>

        @await Html.PartialAsync("_TopbarUserMenu", "RH")
    </div>
}

<!-- CONTENT -->
<section class="content">
    <div class="page-title">
        <div>
            <h4 id="pageH4">@T["H4_Dashboard"]</h4>
            <div class="subtitle" id="pageSub">@T["Page_Subtitle"]</div>
        </div>
    </div>

    <!-- KPIs -->
    @{
        var kpis = new[]
        {
        new { ColClass = "col-12 col-md-6 col-xl-3", Label = T["Kpi_OpenJobs"].Value,        ValueId = "kpiVagas",     Value = "0",  Hint = T["Kpi_OpenJobs_Hint"].Value, Icon = "bi-briefcase",       ModalTarget = "#modalVagasAbertas" },
        new { ColClass = "col-12 col-md-6 col-xl-3", Label = T["Kpi_CVsToday"].Value,       ValueId = "kpiCvsHoje",   Value = "37", Hint = T["Kpi_CVsToday_Hint"].Value,  Icon = "bi-inbox",           ModalTarget = "" },
        new { ColClass = "col-12 col-md-6 col-xl-3", Label = T["Kpi_PendingMatch"].Value,   ValueId = "kpiPendentes", Value = "9",  Hint = T["Kpi_PendingMatch_Hint"].Value,Icon = "bi-hourglass-split", ModalTarget = "" },
        new { ColClass = "col-12 col-md-6 col-xl-3", Label = T["Kpi_Approved7d"].Value,     ValueId = "kpiAprovados", Value = "18", Hint = T["Kpi_Approved7d_Hint"].Value,  Icon = "bi-patch-check",     ModalTarget = "" }
        };
    }
    @await Html.PartialAsync("_KpiCardRow", kpis)

    <!-- CHART + FUNIL -->
    <div class="row g-3 mt-1">
        <div class="col-12 col-xl-7">
            <div class="card-soft p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <div class="fw-bold">@T["Card_Resume_Title"]</div>
                        <div class="text-muted small">@T["Card_Resume_Subtitle_14d"]</div>
                    </div>
                    <span class="badge-soft"><i class="bi bi-graph-up me-1"></i>@T["Badge_Trend"]</span>
                </div>
                <canvas id="chartRecebidos" height="110"></canvas>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card-soft p-3 h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div>
                        <div class="fw-bold">@T["Card_Funnel_Title"]</div>
                        <div class="text-muted small">@T["Card_Funnel_Subtitle"]</div>
                    </div>
                    <button class="btn btn-ghost btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#drawerFilters" title="@T["Btn_Filters"]">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>

                <div class="d-flex flex-column gap-3 mt-2">
                    <div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">@T["Funnel_Received"]</span><span class="fw-semibold" id="funnelRecebidos">0</span>
                        </div>
                        <div class="progress"><div class="progress-bar" id="funnelRecebidosBar" style="width: 0%"></div></div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">@T["Funnel_Screening"]</span><span class="fw-semibold" id="funnelTriagem">0</span>
                        </div>
                        <div class="progress"><div class="progress-bar" id="funnelTriagemBar" style="width: 0%"></div></div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">@T["Funnel_Interview"]</span><span class="fw-semibold" id="funnelEntrevista">0</span>
                        </div>
                        <div class="progress"><div class="progress-bar" id="funnelEntrevistaBar" style="width: 0%"></div></div>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between small">
                            <span class="text-muted">@T["Funnel_Approved"]</span><span class="fw-semibold" id="funnelAprovados">0</span>
                        </div>
                        <div class="progress"><div class="progress-bar" id="funnelAprovadosBar" style="width: 0%"></div></div>
                    </div>
                </div>

                <div class="mt-3 small text-muted">
                    @T["Funnel_Tip"]
                </div>
            </div>
        </div>
    </div>

    <!-- TABELA: MELHORES MATCHES -->
    <div class="card-soft p-3 mt-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <div>
                <div class="fw-bold">@T["Card_TopMatches_Title"]</div>
                <div class="text-muted small">@T["Card_TopMatches_Subtitle"]</div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-ghost btn-sm" type="button"><i class="bi bi-download me-1"></i>@T["Btn_Export"]</button>
                <button class="btn btn-brand btn-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#drawerQuick">
                    <i class="bi bi-plus-lg me-1"></i>@T["Btn_NewJob"]
                </button>
            </div>
        </div>

        <div class="table-responsive">
  <table class="table align-middle mb-0">
    <thead>
<tr>
                    <th style="min-width: 220px;">@T["Tbl_Job"]</th>
                    <th style="min-width: 200px;">@T["Tbl_Candidate"]</th>
                    <th style="min-width: 170px;">@T["Tbl_Source"]</th>
                    <th style="min-width: 240px;">@T["Tbl_Match"]</th>
                    <th style="min-width: 170px;">@T["Tbl_Stage"]</th>
                    <th class="text-end" style="min-width: 150px;">@T["Tbl_Actions"]</th>
                </tr>
    </thead>
    <tbody id="tblBody"></tbody>
  </table>
</div>
    </div>

    <div style="height: 14px;"></div>
</section>

<div class="modal fade" id="modalVagasAbertas" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 18px; border: 1px solid var(--lt-border);">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-2">
                    <div>
                        <h5 class="modal-title fw-bold">@T["Modal_OpenJobs_Title"]</h5>
                        <div class="text-muted small">@T["Modal_OpenJobs_Subtitle"]</div>
                    </div>
                    <span class="badge-soft" id="openVagaCount">0</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
  <table class="table align-middle mb-0">
    <thead>
<tr>
                            <th style="min-width: 120px;">@T["Tbl_Code"]</th>
                            <th style="min-width: 240px;">@T["Tbl_Job"]</th>
                            <th style="min-width: 160px;">@T["Tbl_Area"]</th>
                            <th style="min-width: 150px;">@T["Tbl_Mode"]</th>
                            <th style="min-width: 160px;">@T["Tbl_Location"]</th>
                            <th class="text-end" style="min-width: 140px;">@T["Tbl_Updated"]</th>
                            <th class="text-end" style="min-width: 120px;">@T["Tbl_Actions"]</th>
                        </tr>
    </thead>
    <tbody id="tblVagasAbertas"></tbody>
  </table>
</div>
            </div>
        </div>
    </div>
</div>

<template id="tpl-vaga-aberta-row">
    <tr>
        <td class="mono" data-role="vaga-code"></td>
        <td>
            <div class="fw-semibold" data-role="vaga-title"></div>
            <div class="text-muted small" data-role="vaga-desc"></div>
        </td>
        <td data-role="vaga-area"></td>
        <td data-role="vaga-modalidade"></td>
        <td data-role="vaga-local"></td>
        <td class="text-end mono" data-role="vaga-updated"></td>
        <td class="text-end">
            <button class="btn btn-ghost btn-sm" type="button" data-act="open-vaga">
                <i class="bi bi-box-arrow-up-right me-1"></i>@T["Btn_ViewJob"]
            </button>
        </td>
    </tr>
</template>

<template id="tpl-vaga-aberta-empty-row">
    <tr>
        <td colspan="7" class="text-center text-muted py-3">@T["Empty_OpenJobs"]</td>
    </tr>
</template>

@section Footer {
    @{
        var footerItems = new[]
        {
            new { Icon = "bi-database",         Text = T["Footer_Postgres"].Value },
            new { Icon = "bi-file-earmark-text",Text = T["Footer_PdfDocx"].Value },
            new { Icon = "bi-shield-lock",      Text = T["Footer_SecurityLgpd"].Value }
        };
    }
    @await Html.PartialAsync("_Footer", footerItems)
}

<!-- RIGHT DRAWER: FILTERS -->
@await Html.PartialAsync("_OffcanvasFilters")

<!-- RIGHT DRAWER: QUICK ACTIONS -->
@await Html.PartialAsync("_OffcanvasQuick")

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        // Strings para o JS (dashboard.js)
        window.__i18n = {
            // genéricas
            apiFail: "@T["ApiFail"]",
            quickAreaSelect: "@T["QuickAreaSelect"]",
            chartLabel_CVsReceived: "@T["ChartLabel_CVsReceived"]",
            labelCode: "@T["LabelCode"]",
            labelId: "@T["LabelId"]",
            originEmail: "@T["OriginEmail"]",
            matchInfo: "@T["MatchInfo"]",
            stageScreening: "@T["StageScreening"]",
            btnViewJob: "@T["Btn_ViewJob"]",
            emptyTable: "@T["EmptyTable"]",
            toastDashboardLoadFail: "@T["ToastDashboardLoadFail"]",
            alertCreateJob: "@T["AlertCreateJob"]",

            // menu / títulos
            menu_dashboard_title: "@T["Menu_Dashboard_Title"]",
            menu_dashboard_sub: "@T["Menu_Dashboard_Sub"]",
            menu_vagas_title: "@T["Menu_Vagas_Title"]",
            menu_vagas_sub: "@T["Menu_Vagas_Sub"]",
            menu_candidatos_title: "@T["Menu_Candidatos_Title"]",
            menu_candidatos_sub: "@T["Menu_Candidatos_Sub"]",
            menu_triagem_title: "@T["Menu_Triagem_Title"]",
            menu_triagem_sub: "@T["Menu_Triagem_Sub"]",
            menu_matching_title: "@T["Menu_Matching_Title"]",
            menu_matching_sub: "@T["Menu_Matching_Sub"]",
            menu_entrada_title: "@T["Menu_Entrada_Title"]",
            menu_entrada_sub: "@T["Menu_Entrada_Sub"]",
            menu_rm_title: "@T["Menu_RM_Title"]",
            menu_rm_sub: "@T["Menu_RM_Sub"]",
            menu_relatorios_title: "@T["Menu_Relatorios_Title"]",
            menu_relatorios_sub: "@T["Menu_Relatorios_Sub"]",
            menu_usuarios_title: "@T["Menu_Usuarios_Title"]",
            menu_usuarios_sub: "@T["Menu_Usuarios_Sub"]",
            menu_config_title: "@T["Menu_Config_Title"]",
            menu_config_sub: "@T["Menu_Config_Sub"]",

            // extras usados no JS para fallback do dashboard
            pageH4: "@T["H4_Dashboard"]",
            pageSub: "@T["Page_Subtitle"]",
            badgeTrend: "@T["Badge_Trend"]",

            funnelReceived: "@T["Funnel_Received"]",
            funnelScreening: "@T["Funnel_Screening"]",
            funnelInterview: "@T["Funnel_Interview"]",
            funnelApproved: "@T["Funnel_Approved"]",

            emptyOpenJobs: "@T["Empty_OpenJobs"]"
        };
    </script>

    <script src="~/js/views/dashboard.js" asp-append-version="true"></script>
}
