<div class="tab-pane fade" id="tabEdu" role="tabpanel" aria-labelledby="edu-tab">

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
              <div class="fw-bold" style="font-size:1.1rem;">Formação & Educação</div>
              <div class="text-muted small">Cadastre sua escolaridade, cursos e histórico acadêmico (salvo neste navegador).</div>
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-sm btn-outline-secondary profile-back-to-cards">
                <i class="bi bi-arrow-left me-1"></i> Voltar &agrave;s se&ccedil;&otilde;es
              </button>
              <button class="d-none btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="seedEducation()">
                <i class="fas fa-magic me-1"></i> Inserir exemplos
              </button>
              <button class="btn btn-sm btn-outline-danger fw-bold" type="button" onclick="resetEducation()">
                <i class="fas fa-eraser me-1"></i> Limpar
              </button>
            </div>
          </div>

          <!-- Escolaridade (Resumo) -->
          <div class="border rounded p-3 mb-3" style="border-radius:14px;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
              <div class="fw-bold"><i class="fas fa-school me-1"></i> Escolaridade</div>
              <div class="small text-muted">Defina seu nível principal e informação rápida.</div>
            </div>

            <div class="row g-2 mt-2">
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Nível</label>
                <select id="eduLevel" class="form-select form-select-sm" onchange="saveEducationSummary()">
                  <option value="">Selecionar</option>
                  <option value="Ensino Fundamental">Ensino Fundamental</option>
                  <option value="Ensino Médio">Ensino Médio</option>
                  <option value="Técnico">Técnico</option>
                  <option value="Superior">Superior</option>
                  <option value="Pós-graduação">Pós-graduação</option>
                  <option value="Mestrado">Mestrado</option>
                  <option value="Doutorado">Doutorado</option>
                </select>
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Área principal</label>
                <input id="eduMainArea" class="form-control form-control-sm" placeholder="Ex.: Logística, Química, RH"
                       onchange="saveEducationSummary()">
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Situação</label>
                <select id="eduMainStatus" class="form-select form-select-sm" onchange="saveEducationSummary()">
                  <option value="">Selecionar</option>
                  <option value="Concluído">Concluído</option>
                  <option value="Cursando">Cursando</option>
                  <option value="Trancado">Trancado</option>
                  <option value="A iniciar">A iniciar</option>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label small text-muted mb-1">Destaques (opcional)</label>
                <input id="eduHighlights" class="form-control form-control-sm"
                       placeholder="Ex.: TCC sobre Supply Chain • Bolsa • Prêmios"
                       onchange="saveEducationSummary()">
              </div>
            </div>
          </div>

          <!-- Lista de formações -->
          <div class="border rounded p-3" style="border-radius:14px;">
            <div class="d-flex justify-content-between align-items-center gap-2">
              <div class="fw-bold"><i class="fas fa-university me-1"></i> Cursos / Graduações</div>
              <div class="d-flex gap-2">
                <button class="btn btn-sm btn-primary fw-bold" type="button" onclick="openEducationModal()">
                  <i class="fas fa-plus me-1"></i> Adicionar
                </button>
              </div>
            </div>

            <div class="mt-3" id="eduList"></div>
            <div class="text-muted small mt-2" id="eduEmpty" style="display:none;">
              Nenhuma formação adicionada ainda.
            </div>
          </div>

        </div>

        <!-- Modal: Educação -->
        <div class="modal fade" id="eduEditModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px;">
              <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-graduation-cap me-1"></i> Formação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
              </div>

              <div class="modal-body">
                <input type="hidden" id="eduId">

                <div class="row g-2">
                  <div class="col-12">
                    <label class="form-label small text-muted mb-1">Curso / Formação</label>
                    <input id="eduCourse" class="form-control form-control-sm" placeholder="Ex.: Técnico em Logística, Engenharia, Administração">
                  </div>

                  <div class="col-12 col-md-6">
                    <label class="form-label small text-muted mb-1">Instituição</label>
                    <input id="eduInstitution" class="form-control form-control-sm" placeholder="Ex.: SENAI, USP, Anhanguera">
                  </div>

                  <div class="col-12 col-md-6">
                    <label class="form-label small text-muted mb-1">Tipo</label>
                    <select id="eduType" class="form-select form-select-sm">
                      <option value="Curso">Curso</option>
                      <option value="Técnico">Técnico</option>
                      <option value="Graduação">Graduação</option>
                      <option value="Pós-graduação">Pós-graduação</option>
                      <option value="Mestrado">Mestrado</option>
                      <option value="Doutorado">Doutorado</option>
                      <option value="Certificação">Certificação</option>
                    </select>
                  </div>

                  <div class="col-12 col-md-6">
                    <label class="form-label small text-muted mb-1">Status</label>
                    <select id="eduStatus" class="form-select form-select-sm">
                      <option value="Concluído">Concluído</option>
                      <option value="Cursando">Cursando</option>
                      <option value="Trancado">Trancado</option>
                      <option value="A iniciar">A iniciar</option>
                    </select>
                  </div>

                  <div class="col-12 col-md-3">
                    <label class="form-label small text-muted mb-1">Início</label>
                    <input id="eduStart" class="form-control form-control-sm" placeholder="Ex.: 2022">
                  </div>

                  <div class="col-12 col-md-3">
                    <label class="form-label small text-muted mb-1">Fim/Prev.</label>
                    <input id="eduEnd" class="form-control form-control-sm" placeholder="Ex.: 2026">
                  </div>

                  <div class="col-12">
                    <label class="form-label small text-muted mb-1">Observações (opcional)</label>
                    <textarea id="eduNotes" class="form-control form-control-sm" rows="3"
                              placeholder="Ex.: TCC em Supply Chain • CRA 8,2 • Bolsa"></textarea>
                  </div>

                  <div class="col-12">
                    <label class="form-label small text-muted mb-1">Link (opcional)</label>
                    <input id="eduLink" class="form-control form-control-sm" placeholder="https://... (comprovante, histórico, etc.)">
                  </div>
                </div>
              </div>

              <div class="modal-footer">
                <button id="eduCancelBtn" class="btn btn-outline-secondary fw-bold" type="button" data-bs-dismiss="modal">Cancelar</button>
                <button id="eduSaveBtn" class="btn btn-primary fw-bold" type="button" onclick="saveEducationItem()">
                  <i class="fas fa-save me-1"></i> Salvar
                </button>
              </div>
            </div>
          </div>
        </div>


        
