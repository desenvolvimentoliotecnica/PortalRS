<div class="tab-pane fade" id="tabDocs" role="tabpanel" aria-labelledby="docs-tab">

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
              <div class="fw-bold" style="font-size:1.1rem;">Documentos & Anexos</div>
              <div class="text-muted small">
                Adicione links e registros de documentos (MVP: salvo neste navegador). Upload é simulado (nome do arquivo).
              </div>
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-sm btn-outline-secondary profile-back-to-cards">
                <i class="bi bi-arrow-left me-1"></i> Voltar &agrave;s se&ccedil;&otilde;es
              </button>
              <button class="d-none btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="seedDocuments()">
                <i class="fas fa-magic me-1"></i> Inserir exemplos
              </button>
              <button class="d-none btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="downloadDocumentsSummary()">
                <i class="fas fa-download me-1"></i> Baixar resumo
              </button>
              <button class="btn btn-sm btn-outline-danger fw-bold" type="button" onclick="resetDocuments()">
                <i class="fas fa-eraser me-1"></i> Limpar
              </button>
            </div>
          </div>

          <!-- Ações rápidas -->
          <div class="border rounded p-3 mb-3" style="border-radius:14px;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
              <div class="fw-bold"><i class="fas fa-folder-open me-1"></i> Itens anexados</div>
              <div class="d-flex gap-2">
                <button class="btn btn-sm btn-primary fw-bold" type="button" onclick="openDocModal()">
                  <i class="fas fa-plus me-1"></i> Adicionar
                </button>
              </div>
            </div>

            <div class="row g-2 mt-2">
              <div class="col-12 col-md-6">
                <div class="input-group input-group-sm">
                  <span class="input-group-text"><i class="fas fa-search"></i></span>
                  <input id="docsSearch" class="form-control" placeholder="Buscar por nome/tipo..."
                         oninput="renderDocuments()">
                </div>
              </div>
              <div class="col-12 col-md-3">
                <select id="docsFilterType" class="form-select form-select-sm" onchange="renderDocuments()">
                  <option value="">Filtrar por tipo (todos)</option>
                  <option value="Currículo">Currículo</option>
                  <option value="Certificado">Certificado</option>
                  <option value="Diploma/Declaração">Diploma/Declaração</option>
                  <option value="Portfólio">Portfólio</option>
                  <option value="Carteira/Registro">Carteira/Registro</option>
                  <option value="Outros">Outros</option>
                </select>
              </div>
              <div class="col-12 col-md-3">
                <select id="docsSort" class="form-select form-select-sm" onchange="renderDocuments()">
                  <option value="new">Mais recentes</option>
                  <option value="old">Mais antigos</option>
                  <option value="name">Nome (A–Z)</option>
                  <option value="type">Tipo</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Lista -->
          <div id="docsList" class="row g-2"></div>
          <div id="docsEmpty" class="text-muted small mt-2" style="display:none;">
            Nenhum documento anexado ainda.
          </div>

        </div>

        <!-- Modal: Documento/Anexo -->
        <div class="modal fade" id="docEditModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px;">
              <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-paperclip me-1"></i> Documento / Anexo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
              </div>

              <div class="modal-body">
                <input type="hidden" id="docId">

                <div class="row g-2">
                  <div class="col-12 col-md-5">
                    <label class="form-label small text-muted mb-1">Tipo</label>
                    <select id="docType" class="form-select form-select-sm">
                      <option value="Currículo">Currículo</option>
                      <option value="Certificado">Certificado</option>
                      <option value="Diploma/Declaração">Diploma/Declaração</option>
                      <option value="Portfólio">Portfólio</option>
                      <option value="Carteira/Registro">Carteira/Registro</option>
                      <option value="Outros">Outros</option>
                    </select>
                  </div>

                  <div class="col-12 col-md-7">
                    <label class="form-label small text-muted mb-1">Nome</label>
                    <input id="docName" class="form-control form-control-sm" placeholder="Ex.: Currículo 2026 - João Silva">
                  </div>

                  <div class="col-12">
                    <label class="form-label small text-muted mb-1">Link (opcional)</label>
                    <input id="docLink" class="form-control form-control-sm" placeholder="https://drive.google.com/...">
                  </div>

                  <div class="col-12 col-md-6">
                    <label class="form-label small text-muted mb-1">Arquivo (simulado)</label>
                    <input id="docFile" type="file" class="form-control form-control-sm" onchange="handleDocFileChange(this)">
                    <div class="small text-muted mt-1">No MVP, salvamos apenas o nome do arquivo.</div>
                  </div>

                  <div class="col-12 col-md-6">
                    <label class="form-label small text-muted mb-1">Data (opcional)</label>
                    <input id="docDate" class="form-control form-control-sm" placeholder="Ex.: 01/2026">
                  </div>

                  <div class="col-12">
                    <label class="form-label small text-muted mb-1">Observações (opcional)</label>
                    <textarea id="docNotes" class="form-control form-control-sm" rows="3"
                              placeholder="Ex.: Certificação válida até 2027 • Emissão SENAI"></textarea>
                  </div>

                  <div class="col-12">
                    <div class="border rounded p-2" style="border-radius:12px;background:#f8f9fa;">
                      <div class="small text-muted">Arquivo selecionado:</div>
                      <div class="fw-bold" id="docFileName">—</div>
                    </div>
                  </div>

                </div>
              </div>

              <div class="modal-footer">
                <button class="btn btn-outline-secondary fw-bold" type="button" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary fw-bold" type="button" onclick="saveDocumentItem()">
                  <i class="fas fa-save me-1"></i> Salvar
                </button>
              </div>
            </div>
          </div>
        </div>

        
