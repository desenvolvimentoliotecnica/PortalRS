<div class="tab-pane fade show active" id="tabProfile" role="tabpanel" aria-labelledby="profile-tab">
                          <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                            <div class="fw-bold" style="font-size:1.1rem;">Perfil</div>
                            <div class="d-flex align-items-center gap-2">
                              <button type="button" class="btn btn-sm btn-outline-secondary profile-back-to-cards">
                                <i class="bi bi-arrow-left me-1"></i> Voltar &agrave;s se&ccedil;&otilde;es
                              </button>
                            </div>
                          </div>

                      
                      <div class="row g-3 align-items-start mx-0">
  <div class="col-12 col-lg-8">
    <h6 class="text-primary fw-bold mb-3 border-bottom pb-2"><i class="fas fa-user-edit me-2"></i>Dados pessoais</h6>
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label small fw-bold">Nome completo</label>
        <input id="profileDetailNameInput" type="text" class="form-control" value="" />
      </div>
      <div class="col-md-6">
        <label class="form-label small fw-bold">E-mail</label>
        <input id="profileDetailEmailInput" type="email" class="form-control" value="" readonly style="background-color:#e9ecef;" />
      </div>
      <div class="col-md-6">
        <label class="form-label small fw-bold">Telefone / WhatsApp</label>
        <input id="profileDetailPhoneInput" type="text" class="form-control" value="" />
      </div>
      <div class="col-md-6">
        <label class="form-label small fw-bold">LinkedIn (URL)</label>
        <input id="profileLinkedin" type="text" class="form-control" value="" />
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-4">
    <div class="profile-avatar-card text-center">
      <div class="profile-avatar mx-auto mb-2" title="Alterar foto">
        <img id="profileAvatarImg" alt="Foto do usu&aacute;rio" style="display:none;">
        <span id="profileAvatarFallback">U</span>
      </div>
      <div class="fw-semibold" id="profileAvatarName"></div>
      <div class="text-muted small mb-3" id="profileAvatarRole"></div>
      <div class="text-muted small mb-2">Progresso do perfil</div>
      <div class="progress profile-avatar-progress mb-2">
        <div class="progress-bar bg-success" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
      </div>
      <div class="text-end small fw-semibold text-success mb-3">0%</div>
      <label class="btn btn-outline-primary w-100" for="profileAvatarInput">
        <i class="bi bi-camera me-1"></i> Alterar foto
      </label>
      <input id="profileAvatarInput" type="file" accept="image/*" class="d-none">
    </div>
  </div>
</div>

<h6 class="text-primary fw-bold mb-3 border-bottom pb-2 mt-4"><i class="fas fa-user-edit me-2"></i>Resumo profissional</h6>
<div class="mb-4">
  <textarea id="profileResumo" class="form-control" rows="3"></textarea>
</div>

<h6 class="text-primary fw-bold mb-3 border-bottom pb-2"><i class="fas fa-file-pdf me-2"></i>Meu curr&iacute;culo</h6>
<div class="cv-card mb-4">
  <div class="d-flex align-items-center">
    <i class="fas fa-file-pdf text-danger fa-2x me-3"></i>
    <div>
      <div class="fw-bold text-dark" id="cvFileName"></div>
      <small class="text-muted" id="cvFileDate"></small>
    </div>
  </div>

  <div>
    <input type="file" id="cvFileInput" class="d-none" accept=".pdf,.doc,.docx" />
    <button class="btn btn-sm btn-outline-primary fw-bold" onclick="document.getElementById('cvFileInput').click()">
      <i class="fas fa-upload me-1"></i> Alterar Arquivo
    </button>
  </div>
</div>

                        </div>

