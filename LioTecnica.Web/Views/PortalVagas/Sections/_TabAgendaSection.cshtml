<div class="tab-pane fade" id="tabAgenda" role="tabpanel" aria-labelledby="agenda-tab">

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
              <div class="fw-bold" style="font-size:1.1rem;">Disponibilidade & Agenda</div>
              <div class="text-muted small">
                Configure seus melhores horários para entrevistas e seus bloqueios. (MVP: salvo neste navegador)
              </div>
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-sm btn-outline-secondary profile-back-to-cards">
                <i class="bi bi-arrow-left me-1"></i> Voltar &agrave;s se&ccedil;&otilde;es
              </button>
              <button class="d-none btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="seedAgenda()">
                <i class="fas fa-magic me-1"></i> Inserir exemplo
              </button>
              <button class="d-none btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="downloadAgendaSummary()">
                <i class="fas fa-download me-1"></i> Baixar resumo
              </button>
              <button class="btn btn-sm btn-outline-danger fw-bold" type="button" onclick="resetAgenda()">
                <i class="fas fa-eraser me-1"></i> Limpar
              </button>
            </div>
          </div>

          <!-- Preferências rápidas -->
          <div class="border rounded p-3 mb-3" style="border-radius:14px;">
            <div class="fw-bold mb-2"><i class="fas fa-sliders-h me-1"></i> Preferências gerais</div>

            <div class="row g-2">
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Formato preferido de entrevista</label>
                <select id="agInterviewMode" class="form-select form-select-sm" onchange="saveAgenda()">
                  <option value="">Selecionar</option>
                  <option value="Online">Online</option>
                  <option value="Presencial">Presencial</option>
                  <option value="Híbrido">Híbrido</option>
                  <option value="Indiferente">Indiferente</option>
                </select>
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Data de início disponível</label>
                <input id="agStartDate" class="form-control form-control-sm" placeholder="Ex.: Imediato / 10/02/2026"
                       oninput="saveAgendaDebounced()">
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Aviso prévio (se aplicável)</label>
                <select id="agNotice" class="form-select form-select-sm" onchange="saveAgenda()">
                  <option value="">Selecionar</option>
                  <option value="Sem aviso">Sem aviso</option>
                  <option value="7 dias">7 dias</option>
                  <option value="15 dias">15 dias</option>
                  <option value="30 dias">30 dias</option>
                  <option value="A combinar">A combinar</option>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label small text-muted mb-1">Observações (opcional)</label>
                <input id="agNotes" class="form-control form-control-sm"
                       placeholder="Ex.: prefiro entrevistas entre 9h e 11h, com confirmação por WhatsApp"
                       oninput="saveAgendaDebounced()">
              </div>
            </div>
          </div>

          <!-- Dias da semana -->
          <div class="border rounded p-3 mb-3" style="border-radius:14px;">
            <div class="fw-bold mb-2"><i class="fas fa-calendar-week me-1"></i> Dias preferidos</div>
            <div class="text-muted small mb-2">Selecione os dias em que você costuma estar disponível.</div>

            <div class="d-flex flex-wrap gap-2">
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agDayMon" onchange="saveAgenda()">
                <label class="form-check-label" for="agDayMon">Seg</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agDayTue" onchange="saveAgenda()">
                <label class="form-check-label" for="agDayTue">Ter</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agDayWed" onchange="saveAgenda()">
                <label class="form-check-label" for="agDayWed">Qua</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agDayThu" onchange="saveAgenda()">
                <label class="form-check-label" for="agDayThu">Qui</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agDayFri" onchange="saveAgenda()">
                <label class="form-check-label" for="agDayFri">Sex</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agDaySat" onchange="saveAgenda()">
                <label class="form-check-label" for="agDaySat">Sáb</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agDaySun" onchange="saveAgenda()">
                <label class="form-check-label" for="agDaySun">Dom</label>
              </div>
            </div>

            <hr class="my-3">

            <div class="fw-bold mb-2"><i class="far fa-clock me-1"></i> Períodos do dia</div>
            <div class="d-flex flex-wrap gap-2">
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agTimeMorning" onchange="saveAgenda()">
                <label class="form-check-label" for="agTimeMorning">Manhã</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agTimeAfternoon" onchange="saveAgenda()">
                <label class="form-check-label" for="agTimeAfternoon">Tarde</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" id="agTimeEvening" onchange="saveAgenda()">
                <label class="form-check-label" for="agTimeEvening">Noite</label>
              </div>
            </div>

            <div class="row g-2 mt-2">
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted mb-1">Horário preferido (opcional)</label>
                <input id="agPreferredHours" class="form-control form-control-sm" placeholder="Ex.: 09:00–11:00"
                       oninput="saveAgendaDebounced()">
              </div>
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted mb-1">Fuso horário</label>
                <select id="agTimezone" class="form-select form-select-sm" onchange="saveAgenda()">
                  <option value="America/Sao_Paulo">America/Sao_Paulo (Brasília)</option>
                  <option value="UTC">UTC</option>
                  <option value="America/New_York">America/New_York</option>
                  <option value="Europe/Lisbon">Europe/Lisbon</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Bloqueios -->
          <div class="border rounded p-3" style="border-radius:14px;">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
              <div>
                <div class="fw-bold"><i class="fas fa-ban me-1"></i> Bloqueios (indisponibilidades)</div>
                <div class="text-muted small">Use para datas/horários em que você não pode fazer entrevista.</div>
              </div>
              <button class="btn btn-sm btn-primary fw-bold" type="button" onclick="openBlockModal()">
                <i class="fas fa-plus me-1"></i> Adicionar bloqueio
              </button>
            </div>

            <div class="row g-2 mt-2">
              <div class="col-12 col-md-6">
                <div class="input-group input-group-sm">
                  <span class="input-group-text"><i class="fas fa-search"></i></span>
                  <input id="agBlocksSearch" class="form-control" placeholder="Buscar bloqueio..."
                         oninput="renderAgendaBlocks()">
                </div>
              </div>
              <div class="col-12 col-md-3">
                <select id="agBlocksSort" class="form-select form-select-sm" onchange="renderAgendaBlocks()">
                  <option value="new">Mais recentes</option>
                  <option value="old">Mais antigos</option>
                  <option value="date">Por data (asc)</option>
                </select>
              </div>
              <div class="col-12 col-md-3">
                <select id="agBlocksTypeFilter" class="form-select form-select-sm" onchange="renderAgendaBlocks()">
                  <option value="">Tipo (todos)</option>
                  <option value="Entrevista">Entrevista</option>
                  <option value="Compromisso">Compromisso</option>
                  <option value="Viagem">Viagem</option>
                  <option value="Saúde">Saúde</option>
                  <option value="Outro">Outro</option>
                </select>
              </div>
            </div>

            <div id="agBlocksList" class="row g-2 mt-2"></div>
            <div id="agBlocksEmpty" class="text-muted small mt-2" style="display:none;">
              Nenhum bloqueio cadastrado.
            </div>
          </div>

        </div>

        <!-- Modal: Bloqueio de agenda -->
        <div class="modal fade" id="agendaBlockModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:16px;">
              <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-ban me-1"></i> Bloqueio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
              </div>

              <div class="modal-body">
                <input type="hidden" id="agBlockId">

                <div class="row g-2">
                  <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">Tipo</label>
                    <select id="agBlockType" class="form-select form-select-sm">
                      <option value="Compromisso">Compromisso</option>
                      <option value="Entrevista">Entrevista</option>
                      <option value="Viagem">Viagem</option>
                      <option value="Saúde">Saúde</option>
                      <option value="Outro">Outro</option>
                    </select>
                  </div>

                  <div class="col-12 col-md-8">
                    <label class="form-label small text-muted mb-1">Título</label>
                    <input id="agBlockTitle" class="form-control form-control-sm" placeholder="Ex.: consulta médica / prova / viagem">
                  </div>

                  <div class="col-12 col-md-6">
                    <label class="form-label small text-muted mb-1">Data</label>
                    <input id="agBlockDate" class="form-control form-control-sm" placeholder="Ex.: 28/01/2026">
                  </div>

                  <div class="col-12 col-md-6">
                    <label class="form-label small text-muted mb-1">Horário (opcional)</label>
                    <input id="agBlockHours" class="form-control form-control-sm" placeholder="Ex.: 14:00–16:00">
                  </div>

                  <div class="col-12">
                    <label class="form-label small text-muted mb-1">Observações (opcional)</label>
                    <textarea id="agBlockNotes" class="form-control form-control-sm" rows="3"
                              placeholder="Ex.: sem disponibilidade neste período"></textarea>
                  </div>
                </div>

              </div>

              <div class="modal-footer">
                <button class="btn btn-outline-secondary fw-bold" type="button" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary fw-bold" type="button" onclick="saveAgendaBlock()">
                  <i class="fas fa-save me-1"></i> Salvar
                </button>
              </div>
            </div>
          </div>
        </div>

        
