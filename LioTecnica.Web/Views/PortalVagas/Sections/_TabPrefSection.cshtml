<div class="tab-pane fade" id="tabPref" role="tabpanel" aria-labelledby="pref-tab">

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
              <div class="fw-bold" style="font-size:1.1rem;">Preferências de Vaga / Objetivos</div>
              <div class="text-muted small">Defina seus objetivos e critérios para facilitar o matching. (MVP: salvo neste navegador)</div>
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-sm btn-outline-secondary profile-back-to-cards">
                <i class="bi bi-arrow-left me-1"></i> Voltar &agrave;s se&ccedil;&otilde;es
              </button>
              <button class="d-none btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="seedPreferences()">
                <i class="fas fa-magic me-1"></i> Inserir exemplo
              </button>
              <button class="btn btn-sm btn-outline-danger fw-bold" type="button" onclick="resetPreferences()">
                <i class="fas fa-eraser me-1"></i> Limpar
              </button>
            </div>
          </div>

          <!-- Objetivo principal -->
          <div class="border rounded p-3 mb-3" style="border-radius:14px;">
            <div class="fw-bold mb-2"><i class="fas fa-crosshairs me-1"></i> Objetivo principal</div>

            <div class="row g-2">
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted mb-1">Cargo alvo</label>
                <input id="prefRole" class="form-control form-control-sm" placeholder="Ex.: Analista de Qualidade Jr"
                       oninput="savePreferencesDebounced()">
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Senioridade</label>
                <select id="prefSeniority" class="form-select form-select-sm" onchange="savePreferences()">
                  <option value="">Selecionar</option>
                  <option value="Estágio">Estágio</option>
                  <option value="Júnior">Júnior</option>
                  <option value="Pleno">Pleno</option>
                  <option value="Sênior">Sênior</option>
                  <option value="Especialista">Especialista</option>
                  <option value="Coordenação">Coordenação</option>
                  <option value="Gerência">Gerência</option>
                </select>
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Início disponível</label>
                <select id="prefStart" class="form-select form-select-sm" onchange="savePreferences()">
                  <option value="">Selecionar</option>
                  <option value="Imediato">Imediato</option>
                  <option value="15 dias">Em 15 dias</option>
                  <option value="30 dias">Em 30 dias</option>
                  <option value="60 dias">Em 60 dias</option>
                  <option value="A combinar">A combinar</option>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label small text-muted mb-1">Resumo (em 1–2 frases)</label>
                <textarea id="prefSummary" class="form-control form-control-sm" rows="3"
                          placeholder="Ex.: Busco atuar em qualidade, com foco em melhoria contínua e auditorias, contribuindo com padronização e indicadores."
                          oninput="savePreferencesDebounced()"></textarea>
              </div>
            </div>
          </div>

          <!-- Áreas e modelo de trabalho -->
          <div class="border rounded p-3 mb-3" style="border-radius:14px;">
            <div class="fw-bold mb-2"><i class="fas fa-layer-group me-1"></i> Áreas e modelo de trabalho</div>

            <div class="row g-2">
              <div class="col-12 col-md-6">
                <label class="form-label small text-muted mb-1">Áreas de interesse</label>
                <input id="prefAreas" class="form-control form-control-sm"
                       placeholder="Ex.: Qualidade, Produção, Logística (separe por vírgula)"
                       oninput="savePreferencesDebounced()">
                <div class="small text-muted mt-1">Dica: use vírgulas para facilitar o matching.</div>
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Modelo</label>
                <select id="prefWorkMode" class="form-select form-select-sm" onchange="savePreferences()">
                  <option value="">Selecionar</option>
                  <option value="Presencial">Presencial</option>
                  <option value="Híbrido">Híbrido</option>
                  <option value="Remoto">Remoto</option>
                  <option value="Indiferente">Indiferente</option>
                </select>
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Jornada</label>
                <select id="prefShift" class="form-select form-select-sm" onchange="savePreferences()">
                  <option value="">Selecionar</option>
                  <option value="Comercial">Comercial</option>
                  <option value="Turnos">Turnos</option>
                  <option value="Noturno">Noturno</option>
                  <option value="Escala">Escala</option>
                  <option value="Indiferente">Indiferente</option>
                </select>
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Tipo de contrato</label>
                <select id="prefContract" class="form-select form-select-sm" onchange="savePreferences()">
                  <option value="">Selecionar</option>
                  <option value="CLT">CLT</option>
                  <option value="PJ">PJ</option>
                  <option value="Temporário">Temporário</option>
                  <option value="Aprendiz">Aprendiz</option>
                  <option value="Estágio">Estágio</option>
                  <option value="Indiferente">Indiferente</option>
                </select>
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Viagens a trabalho</label>
                <select id="prefTravel" class="form-select form-select-sm" onchange="savePreferences()">
                  <option value="">Selecionar</option>
                  <option value="Sim">Sim</option>
                  <option value="Não">Não</option>
                  <option value="Eventual">Eventual</option>
                </select>
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Mudança (mobilidade)</label>
                <select id="prefRelocation" class="form-select form-select-sm" onchange="savePreferences()">
                  <option value="">Selecionar</option>
                  <option value="Sim">Sim</option>
                  <option value="Não">Não</option>
                  <option value="Depende">Depende</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Localidade e distância -->
          <div class="border rounded p-3 mb-3" style="border-radius:14px;">
            <div class="fw-bold mb-2"><i class="fas fa-map-marked-alt me-1"></i> Localidade e distância</div>

            <div class="row g-2 align-items-end">
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Cidade/Região preferida</label>
                <input id="prefCity" class="form-control form-control-sm" placeholder="Ex.: Embu das Artes / SP"
                       oninput="savePreferencesDebounced()">
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Distância máxima (km)</label>
                <input id="prefMaxDistance" type="number" min="0" step="1"
                       class="form-control form-control-sm" placeholder="Ex.: 25"
                       oninput="savePreferencesDebounced()">
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Observações de deslocamento</label>
                <input id="prefCommuteNotes" class="form-control form-control-sm" placeholder="Ex.: acesso fácil a metrô/ônibus"
                       oninput="savePreferencesDebounced()">
              </div>
            </div>
          </div>

          <!-- Pretensão e benefícios -->
          <div class="border rounded p-3" style="border-radius:14px;">
            <div class="fw-bold mb-2"><i class="fas fa-wallet me-1"></i> Pretensão e benefícios</div>

            <div class="row g-2">
              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Pretensão (R$)</label>
                <input id="prefSalary" class="form-control form-control-sm" placeholder="Ex.: 3500"
                       oninput="savePreferencesDebounced()">
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Negociável?</label>
                <select id="prefSalaryNegotiable" class="form-select form-select-sm" onchange="savePreferences()">
                  <option value="">Selecionar</option>
                  <option value="Sim">Sim</option>
                  <option value="Não">Não</option>
                  <option value="Depende">Depende</option>
                </select>
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small text-muted mb-1">Benefícios desejados</label>
                <input id="prefBenefits" class="form-control form-control-sm"
                       placeholder="Ex.: VT, VR, plano de saúde (vírgula)"
                       oninput="savePreferencesDebounced()">
              </div>

              <div class="col-12">
                <label class="form-label small text-muted mb-1">Não abrimos mão de… (opcional)</label>
                <input id="prefDealbreakers" class="form-control form-control-sm"
                       placeholder="Ex.: ambiente respeitoso, plano de carreira, estabilidade"
                       oninput="savePreferencesDebounced()">
              </div>

              <div class="col-12">
                <div class="d-flex flex-wrap gap-2 mt-2">
                  <button class="btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="previewPreferences()">
                    <i class="fas fa-eye me-1"></i> Pré-visualizar resumo
                  </button>
                  <span class="text-muted small align-self-center" id="prefSavedHint">—</span>
                </div>
              </div>
            </div>
          </div>

        </div>


        
