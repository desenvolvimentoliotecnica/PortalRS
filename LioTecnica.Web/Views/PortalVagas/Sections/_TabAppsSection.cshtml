<div class="tab-pane fade" id="tabApps" role="tabpanel" aria-labelledby="apps-tab">

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
              <div class="fw-bold" style="font-size:1.1rem;">Histórico de Candidaturas & Etapas</div>
              <div class="text-muted small">Acompanhe suas candidaturas e o andamento (MVP: salvo neste navegador).</div>
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-sm btn-outline-secondary profile-back-to-cards">
                <i class="bi bi-arrow-left me-1"></i> Voltar &agrave;s se&ccedil;&otilde;es
              </button>
              <button class="btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="seedAppsHistory()">
                <i class="fas fa-magic me-1"></i> Inserir exemplo
              </button>
              <button class="btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="importFromMyApps()">
                <i class="fas fa-file-import me-1"></i> Importar do “Minhas candidaturas”
              </button>
              <button class="btn btn-sm btn-primary fw-bold" type="button" onclick="openAppEditModal()">
                <i class="fas fa-plus me-1"></i> Nova candidatura
              </button>
              <button class="d-none btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="downloadAppsSummary()">
                <i class="fas fa-download me-1"></i> Baixar resumo
              </button>
              <button class="btn btn-sm btn-outline-danger fw-bold" type="button" onclick="resetAppsHistory()">
                <i class="fas fa-eraser me-1"></i> Limpar
              </button>
            </div>
          </div>

          <!-- filtros -->
          <div class="row g-2 mb-3">
            <div class="col-12 col-md-6">
              <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input id="appsSearch" class="form-control" placeholder="Buscar por vaga, empresa, local..."
                       oninput="renderAppsHistory()">
              </div>
            </div>

            <div class="col-6 col-md-3">
              <select id="appsStatusFilter" class="form-select form-select-sm" onchange="renderAppsHistory()">
                <option value="">Status (todos)</option>
                <option value="Aplicado">Aplicado</option>
                <option value="Triagem">Triagem</option>
                <option value="Entrevista">Entrevista</option>
                <option value="Teste">Teste</option>
                <option value="Proposta">Proposta</option>
                <option value="Aprovado">Aprovado</option>
                <option value="Reprovado">Reprovado</option>
                <option value="Desistiu">Desistiu</option>
              </select>
            </div>

            <div class="col-6 col-md-3">
              <select id="appsSort" class="form-select form-select-sm" onchange="renderAppsHistory()">
                <option value="new">Mais recentes</option>
                <option value="old">Mais antigas</option>
                <option value="status">Por status</option>
              </select>
            </div>
          </div>

          <!-- lista -->
          <div id="appsList" class="row g-2"></div>
          <div id="appsEmpty" class="text-muted small" style="display:none;">Nenhuma candidatura cadastrada.</div>

        </div>

        <!-- Modal: Editar/Adicionar candidatura -->
        <div class="modal fade" id="appEditModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="border-radius:16px;">
              <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="fas fa-briefcase me-1"></i> Candidatura</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
              </div>

              <div class="modal-body">
                <input type="hidden" id="appId">

                <div class="row g-2">
                  <div class="col-12 col-md-6">
                    <label class="form-label small text-muted mb-1">Vaga</label>
                    <input id="appTitle" class="form-control form-control-sm" placeholder="Ex.: Analista de Qualidade Jr">
                  </div>

                  <div class="col-12 col-md-6">
                    <label class="form-label small text-muted mb-1">Empresa</label>
                    <input id="appCompany" class="form-control form-control-sm" placeholder="Ex.: Liotécnica">
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">Local</label>
                    <input id="appLocation" class="form-control form-control-sm" placeholder="Ex.: Embu das Artes / Remoto">
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">Data da candidatura</label>
                    <input id="appDate" class="form-control form-control-sm" placeholder="Ex.: 24/01/2026">
                  </div>

                  <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">Status atual</label>
                    <select id="appStatus" class="form-select form-select-sm" onchange="syncPipelineFromStatus()">
                      <option value="Aplicado">Aplicado</option>
                      <option value="Triagem">Triagem</option>
                      <option value="Entrevista">Entrevista</option>
                      <option value="Teste">Teste</option>
                      <option value="Proposta">Proposta</option>
                      <option value="Aprovado">Aprovado</option>
                      <option value="Reprovado">Reprovado</option>
                      <option value="Desistiu">Desistiu</option>
                    </select>
                  </div>

                  <div class="col-12">
                    <label class="form-label small text-muted mb-1">Link da vaga (opcional)</label>
                    <input id="appLink" class="form-control form-control-sm" placeholder="https://...">
                  </div>

                  <div class="col-12">
                    <label class="form-label small text-muted mb-2">Etapas (pipeline)</label>

                    <div class="d-flex flex-wrap gap-2">
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="stApplied">
                        <label class="form-check-label" for="stApplied">Aplicado</label>
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="stScreen">
                        <label class="form-check-label" for="stScreen">Triagem</label>
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="stInterview">
                        <label class="form-check-label" for="stInterview">Entrevista</label>
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="stTest">
                        <label class="form-check-label" for="stTest">Teste</label>
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="stOffer">
                        <label class="form-check-label" for="stOffer">Proposta</label>
                      </div>
                    </div>

                    <div class="text-muted small mt-2">
                      Dica: mudar o “Status atual” marca automaticamente as etapas até ele.
                    </div>
                  </div>

                  <div class="col-12">
                    <label class="form-label small text-muted mb-1">Notas/feedback (opcional)</label>
                    <textarea id="appNotes" class="form-control form-control-sm" rows="3"
                              placeholder="Ex.: entrevista marcada para 02/02 às 10:00"></textarea>
                  </div>

                  <div class="col-12">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                      <div class="fw-bold">Timeline</div>
                      <button class="btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="addTimelineEvent()">
                        <i class="fas fa-plus me-1"></i> Adicionar evento
                      </button>
                    </div>

                    <div id="appTimeline" class="mt-2 d-flex flex-column gap-2"></div>
                    <div id="appTimelineEmpty" class="text-muted small mt-2" style="display:none;">Sem eventos ainda.</div>
                  </div>
                </div>

              </div>

              <div class="modal-footer">
                <button class="btn btn-outline-secondary fw-bold" type="button" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary fw-bold" type="button" onclick="saveApp()">
                  <i class="fas fa-save me-1"></i> Salvar
                </button>
              </div>
            </div>
          </div>
        </div>


        
