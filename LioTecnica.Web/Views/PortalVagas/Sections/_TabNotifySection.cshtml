<div class="tab-pane fade" id="tabNotify" role="tabpanel" aria-labelledby="notify-tab">

          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
              <div class="fw-bold" style="font-size:1.1rem;">Notificações & Comunicação</div>
              <div class="text-muted small">Escolha como e quando receber atualizações. (MVP: salvo neste navegador)</div>
            </div>

            <div class="d-flex gap-2">
              <button type="button" class="btn btn-sm btn-outline-secondary profile-back-to-cards">
                <i class="bi bi-arrow-left me-1"></i> Voltar &agrave;s se&ccedil;&otilde;es
              </button>
              <button class="d-none btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="seedNotify()">
                <i class="fas fa-magic me-1"></i> Inserir exemplo
              </button>
              <button class="btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="testNotify()">
                <i class="fas fa-paper-plane me-1"></i> Testar
              </button>
              <button class="d-none btn btn-sm btn-outline-secondary fw-bold" type="button" onclick="downloadNotifySummary()">
                <i class="fas fa-download me-1"></i> Baixar resumo
              </button>
              <button class="btn btn-sm btn-outline-danger fw-bold" type="button" onclick="resetNotify()">
                <i class="fas fa-eraser me-1"></i> Limpar
              </button>
            </div>
          </div>

          <!-- Canais -->
          <div class="border rounded p-3 mb-3" style="border-radius:14px;">
            <div class="fw-bold mb-2"><i class="fas fa-broadcast-tower me-1"></i> Canais</div>
            <div class="text-muted small mb-2">Ative os canais que você deseja receber comunicações.</div>

            <div class="row g-2 align-items-end">
              <div class="col-12 col-md-6">
                <div class="d-flex flex-wrap gap-3">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="ntEmail" onchange="saveNotify()">
                    <label class="form-check-label" for="ntEmail"><i class="far fa-envelope me-1"></i> E-mail</label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="ntWhatsapp" onchange="saveNotify()">
                    <label class="form-check-label" for="ntWhatsapp"><i class="fab fa-whatsapp me-1"></i> WhatsApp</label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="ntSms" onchange="saveNotify()">
                    <label class="form-check-label" for="ntSms"><i class="fas fa-sms me-1"></i> SMS</label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="ntPush" onchange="saveNotify()">
                    <label class="form-check-label" for="ntPush"><i class="far fa-bell me-1"></i> Push</label>
                  </div>
                </div>
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Frequência</label>
                <select id="ntFrequency" class="form-select form-select-sm" onchange="saveNotify()">
                  <option value="Imediato">Imediato</option>
                  <option value="Diário (resumo)">Diário (resumo)</option>
                  <option value="Semanal (resumo)">Semanal (resumo)</option>
                </select>
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Idioma</label>
                <select id="ntLang" class="form-select form-select-sm" onchange="saveNotify()">
                  <option value="pt-BR">Português (Brasil)</option>
                  <option value="en-US">English (US)</option>
                  <option value="es-ES">Español</option>
                </select>
              </div>

              <div class="col-12 col-md-6 mt-2">
                <label class="form-label small text-muted mb-1">E-mail preferido (para avisos)</label>
                <input id="ntEmailAddr" class="form-control form-control-sm" placeholder="ex.: seuemail@dominio.com"
                       oninput="saveNotifyDebounced()">
              </div>

              <div class="col-12 col-md-6 mt-2">
                <label class="form-label small text-muted mb-1">Telefone/WhatsApp (DDD + número)</label>
                <input id="ntPhone" class="form-control form-control-sm" placeholder="ex.: 11 99999-9999"
                       oninput="saveNotifyDebounced()">
              </div>

              <div class="col-12 mt-2">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="ntAllowContact" onchange="saveNotify()">
                  <label class="form-check-label" for="ntAllowContact">
                    Autorizo contato para atualizações de candidatura e convites de entrevista (operacional).
                  </label>
                </div>
                <div class="text-muted small mt-1">No produto final, isso se conecta com consentimentos e auditoria (LGPD já está na sua aba).</div>
              </div>
            </div>
          </div>

          <!-- Tipos de alerta -->
          <div class="border rounded p-3 mb-3" style="border-radius:14px;">
            <div class="fw-bold mb-2"><i class="fas fa-list-check me-1"></i> Tipos de alerta</div>
            <div class="text-muted small mb-2">Escolha quais eventos devem gerar notificação.</div>

            <div class="row g-2">
              <div class="col-12 col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="ntNewJobs" onchange="saveNotify()">
                  <label class="form-check-label" for="ntNewJobs"><strong>Novas vagas</strong> compatíveis com meu perfil</label>
                </div>
                <div class="form-check mt-2">
                  <input class="form-check-input" type="checkbox" id="ntAppUpdates" onchange="saveNotify()">
                  <label class="form-check-label" for="ntAppUpdates"><strong>Atualização</strong> de status das candidaturas</label>
                </div>
                <div class="form-check mt-2">
                  <input class="form-check-input" type="checkbox" id="ntInterview" onchange="saveNotify()">
                  <label class="form-check-label" for="ntInterview"><strong>Entrevistas</strong> (agendamento, alteração, lembretes)</label>
                </div>
              </div>

              <div class="col-12 col-md-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="ntMessages" onchange="saveNotify()">
                  <label class="form-check-label" for="ntMessages"><strong>Mensagens</strong> do RH/recrutador</label>
                </div>
                <div class="form-check mt-2">
                  <input class="form-check-input" type="checkbox" id="ntDocs" onchange="saveNotify()">
                  <label class="form-check-label" for="ntDocs"><strong>Documentos</strong> (solicitação/pendência)</label>
                </div>
                <div class="form-check mt-2">
                  <input class="form-check-input" type="checkbox" id="ntReminders" onchange="saveNotify()">
                  <label class="form-check-label" for="ntReminders"><strong>Lembretes</strong> (testes, prazos, confirmações)</label>
                </div>
              </div>
            </div>
          </div>

          <!-- Quiet Hours -->
          <div class="border rounded p-3" style="border-radius:14px;">
            <div class="fw-bold mb-2"><i class="far fa-moon me-1"></i> Horário silencioso</div>
            <div class="text-muted small mb-2">Evite notificações em determinados horários (exceto crítico no futuro).</div>

            <div class="row g-2 align-items-end">
              <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Ativar</label>
                <select id="ntQuietEnabled" class="form-select form-select-sm" onchange="saveNotify()">
                  <option value="Não">Não</option>
                  <option value="Sim">Sim</option>
                </select>
              </div>

              <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">Início</label>
                <input id="ntQuietStart" class="form-control form-control-sm" placeholder="22:00"
                       oninput="saveNotifyDebounced()">
              </div>

              <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1">Fim</label>
                <input id="ntQuietEnd" class="form-control form-control-sm" placeholder="07:00"
                       oninput="saveNotifyDebounced()">
              </div>

              <div class="col-12 col-md-3">
                <label class="form-label small text-muted mb-1">Prioridade</label>
                <select id="ntPriority" class="form-select form-select-sm" onchange="saveNotify()">
                  <option value="Normal">Normal</option>
                  <option value="Alta">Alta (respeita silêncio)</option>
                  <option value="Crítica">Crítica (ignora silêncio)</option>
                </select>
              </div>

              <div class="col-12 mt-2">
                <label class="form-label small text-muted mb-1">Mensagem padrão (opcional)</label>
                <input id="ntSignature" class="form-control form-control-sm"
                       placeholder="Ex.: Obrigado! — (Seu nome)"
                       oninput="saveNotifyDebounced()">
              </div>
            </div>

            <hr class="my-3">

            <div class="d-flex flex-wrap gap-2">
              <span class="badge rounded-pill text-bg-light" style="border:1px solid #e5e7eb;color:#6b7280;">
                <i class="fas fa-shield-alt me-1"></i> Segurança: dados ficam no navegador (MVP)
              </span>
              <span class="badge rounded-pill text-bg-light" style="border:1px solid #e5e7eb;color:#6b7280;">
                <i class="fas fa-clock me-1"></i> Resumo: <span id="ntPreview" class="ms-1">—</span>
              </span>
            </div>
          </div>

        </div>
        </div>
    </div>
</div>
                            </div>


                        </div>
                    </div>
