@model LioTecnica.Web.ViewModels.Portal.PortalAccessViewModel
@{ Layout = null; }
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portal de Vagas - Acesso</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Open+Sans:wght@400;600;700&family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/portal-candidatos-access.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="auth-view">
    <main class="auth-screen" aria-labelledby="authTitle">
        <header class="auth-header">
            <div class="auth-container auth-header-inner">
                <div class="auth-brand">
                    <span class="auth-logo">LT</span>
                    <span class="auth-logo-text">portal vagas</span>
                </div>
                <a class="auth-help" href="mailto:rh@liotecnica.com.br">Precisa de ajuda?</a>
            </div>
        </header>

        <section class="auth-body">
            <div class="auth-container auth-content">
                <div class="auth-card auth-card-main">
                    <div class="auth-title">
                        <h1 id="authTitle">Acesse sua area de candidato</h1>
                        <h2>Use seu e-mail e senha cadastrados para continuar.</h2>
                    </div>

                    <form id="candidateLoginForm" class="auth-form" novalidate>
                        <div class="field">
                            <label for="loginEmail">E-mail</label>
                            <input id="loginEmail" name="email" type="email" autocomplete="email" required />
                        </div>
                        <div class="field">
                            <label for="loginPassword">Senha</label>
                            <input id="loginPassword" name="password" type="password" minlength="8" autocomplete="current-password" required />
                        </div>
                        <input id="tenantId" type="hidden" value="@Model.TenantId" />
                        <input id="returnUrl" type="hidden" value="@Model.ReturnUrl" />
                        <button id="loginSubmit" class="btn auth-submit auth-primary" type="submit">
                            Entrar no portal
                        </button>
                    </form>

                    <div class="auth-links">
                        <span class="auth-note">Ainda nao possui acesso?</span>
                        <button id="openRegister" class="auth-secondary-btn" type="button">Criar acesso</button>
                        <span id="tenantNotice" class="auth-note" data-tenant-warning hidden>
                            Tenant nao informado. Use o link enviado pelo RH.
                        </span>
                    </div>
                </div>

                <div class="auth-card auth-card-secondary">
                    <h3>Como funciona?</h3>
                    <p>Qualquer pessoa pode criar um acesso e acompanhar as vagas disponiveis.</p>
                    <p>Se voce ja possui cadastro, use seu e-mail e senha para entrar.</p>
                </div>
            </div>
        </section>
    </main>

    <div class="modal fade auth-modal" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <form id="registerForm" class="needs-validation" novalidate>
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title h6 mb-1" id="registerModalLabel">Criar acesso</h2>
                            <div class="text-muted small">Preencha os dados basicos para entrar no portal.</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label" for="registerName">Nome completo</label>
                                <input id="registerName" class="form-control" type="text" autocomplete="name" required />
                                <div class="invalid-feedback">Informe seu nome completo.</div>
                            </div>

                            <div class="col-12">
                                <label class="form-label" for="registerEmail">E-mail</label>
                                <input id="registerEmail" class="form-control" type="email" autocomplete="email" required />
                                <div class="invalid-feedback">Informe um e-mail valido.</div>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label" for="registerPhone">Telefone</label>
                                <input id="registerPhone" class="form-control" type="tel" autocomplete="tel" required />
                                <div class="invalid-feedback">Informe um telefone com DDD e 9 digitos.</div>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label" for="registerUf">UF</label>
                                <select id="registerUf" class="form-select" required>
                                    <option value="" selected>Selecione</option>
                                </select>
                                <div class="invalid-feedback">Selecione a UF.</div>
                            </div>

                            <div class="col-12 col-md-5">
                                <label class="form-label" for="registerCity">Cidade</label>
                                <select id="registerCity" class="form-select" required disabled>
                                    <option value="" selected>Selecione a UF primeiro</option>
                                </select>
                                <div class="invalid-feedback">Selecione a cidade.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="registerPassword">Senha</label>
                                <input id="registerPassword" class="form-control" type="password" minlength="8"
                                       autocomplete="new-password"
                                       required />
                                <div class="form-text">Minimo 8 caracteres, 1 maiuscula, 1 numero e 1 especial.</div>
                                <div class="invalid-feedback">Senha fora do criterio.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="registerPasswordConfirm">Confirmar senha</label>
                                <input id="registerPasswordConfirm" class="form-control" type="password" minlength="8"
                                       autocomplete="new-password"
                                       required />
                                <div class="invalid-feedback">As senhas nao conferem.</div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancelar</button>
                        <button id="registerSubmit" class="btn btn-primary" type="submit">Criar acesso</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/views/portal-vagas-access.js" asp-append-version="true"></script>
</body>
</html>
