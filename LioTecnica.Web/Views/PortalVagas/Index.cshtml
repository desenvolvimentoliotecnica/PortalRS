          async function fetchCitiesForUf(uf) {
            const key = uf.toUpperCase();
            if (cityCache.has(key)) return cityCache.get(key);
            const res = await fetch(`${LOCATION_BASE}/Ufs/${encodeURIComponent(key)}/Cities`);
