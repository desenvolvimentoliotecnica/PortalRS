@using System.Security.Claims
@{
    Layout = null;
    var userName = User?.Identity?.Name ?? "Candidato";
    var userEmail = User?.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
    var initials = string.Empty;
    var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    if (parts.Length > 0)
    {
        initials += char.ToUpperInvariant(parts[0][0]);
        if (parts.Length > 1)
            initials += char.ToUpperInvariant(parts[parts.Length - 1][0]);
    }
    if (string.IsNullOrWhiteSpace(initials))
        initials = "US";
    var tenantId = Context.Request.Query["tenantId"].ToString();
    if (string.IsNullOrWhiteSpace(tenantId))
    {
        tenantId = User?.FindFirst("tenant")?.Value ?? string.Empty;
    }
}
@inject IConfiguration Configuration
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portal de Vagas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/portal-vagas.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body>
    <div class="header-wrapper">
        <nav class="navbar">
            <div class="container d-flex justify-content-between align-items-center">
                <div class="portal-brand">
                    <i class="fas fa-flask" aria-hidden="true"></i>
                    <span>LT Portal de Vagas</span>
                </div>
                <div class="portal-actions">
                    @if (User.IsInRole("Admin"))
                    {
                        <button class="btn btn-outline-primary portal-new-job" type="button" data-bs-toggle="modal" data-bs-target="#newJobModal">
                            <i class="fas fa-plus me-1" aria-hidden="true"></i> Nova vaga
                        </button>
                    }
                    <div class="dropdown portal-user-menu">
                        <button class="btn portal-user-btn dropdown-toggle" type="button" id="portalUserMenu" data-bs-toggle="dropdown" aria-expanded="false">
                            <span id="portalUserAvatar" class="portal-user-avatar">@initials</span>
                            <span class="text-start d-none d-md-block">
                                <div id="portalUserName" class="portal-user-name">@userName</div>
                                <div id="portalUserEmail" class="portal-user-email">@userEmail</div>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="portalUserMenu">
                            <li>
                                <button class="dropdown-item" type="button" id="btnProfile">Ver perfil</button>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="/PortalVagas/Logout?tenantId=@tenantId">
                                    <button class="dropdown-item text-danger" type="submit">Sair</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </div>

    <!-- Alertas (erro/sucesso) -->
    <div class="container py-3">
        <div id="appAlert" class="alert d-none" role="alert" aria-live="polite"></div>
    </div>

    <section class="main-header">
    <div class="container">
        <h1 class="display-6 fw-semibold mb-2">Transforme o Futuro da Alimentação</h1>
        <p class="lead mb-0">Ambiente inovador, tecnologia de ponta e paixão por qualidade.</p>
    </div>
</section>

<div class="container search-wrapper">
    <div class="search-box">
        <i class="fas fa-search"></i>
        <input id="q" name="q" type="search" placeholder="Buscar por cargo, empresa, tecnologia..." autocomplete="off" />
        <button id="searchBtn" class="btn-search" type="button">Buscar</button>
        <button id="searchClearBtn" class="btn-clear" type="button">Limpar</button>
    </div>
</div>

    <button class="btn btn-light border shadow-sm back-to-top px-3 py-2"
            type="button"
            id="backToTopBtn"
            aria-label="Voltar ao topo">
        <i class="fas fa-arrow-up me-2" aria-hidden="true"></i> Topo
    </button>

    <button class="btn btn-primary filters-fab px-3 py-2"
            type="button"
            data-bs-toggle="offcanvas" data-bs-target="#filtersDrawer"
            aria-controls="filtersDrawer" aria-label="Abrir filtros">
        <i class="fas fa-sliders-h me-2" aria-hidden="true"></i> Filtros
    </button>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="filtersDrawer" aria-labelledby="filtersDrawerLabel">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title fs-5" id="filtersDrawerLabel">Filtros</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
        </div>

        <div class="offcanvas-body d-flex flex-column">
            <form id="filtersForm" novalidate class="filters-form">
                <div class="filters-scroll">
                    

                    <div class="row g-2">
                        <div class="col-12">
                            <label for="location" class="form-label">Local</label>
                            <select id="location" name="location" class="form-select">
                                <option value="">Qualquer</option>
                                <option>S&atilde;o Paulo, SP</option>
                                <option>Rio de Janeiro, RJ</option>
                                <option>Belo Horizonte, MG</option>
                                <option>Curitiba, PR</option>
                                <option>Remoto (Brasil)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="mode" class="form-label">Formato</label>
                            <select id="mode" name="mode" class="form-select">
                                <option value="">Qualquer</option>
                                <option>Remoto</option>
                                <option>H&iacute;brido</option>
                                <option>Presencial</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="type" class="form-label">Tipo</label>
                            <select id="type" name="type" class="form-select">
                                <option value="">Qualquer</option>
                                <option>CLT</option>
                                <option>PJ</option>
                                <option>Est&aacute;gio</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="level" class="form-label">Senioridade</label>
                            <select id="level" name="level" class="form-select">
                                <option value="">Qualquer</option>
                                <option>J&uacute;nior</option>
                                <option>Pleno</option>
                                <option>S&ecirc;nior</option>
                                <option>Lideran&ccedil;a</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="area" class="form-label">&Aacute;rea</label>
                            <select id="area" name="area" class="form-select">
                                <option value="">Qualquer</option>
                                <option>Engenharia</option>
                                <option>Dados</option>
                                <option>Produto</option>
                                <option>Design</option>
                                <option>Seguran&ccedil;a</option>
                                <option>Opera&ccedil;&otilde;es</option>
                            </select>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="mb-3">
                        <label for="minSalary" class="form-label">Sal&aacute;rio m&iacute;nimo (R$)</label>
                        <input id="minSalary" name="minSalary" type="number" class="form-control"
                               inputmode="numeric" min="0" step="500" placeholder="Ex.: 8000" />
                        <div class="form-text">Filtra por vagas cuja faixa m&aacute;xima seja compat&iacute;vel</div>
                    </div>

                    <div class="mt-4 small text-secondary" aria-hidden="true">
                        Use Tab para navegar e Enter para aplicar.
                    </div>
                </div>

                <div class="filters-footer d-grid gap-2">
                    <button id="applyBtn" class="btn btn-primary" type="submit">Aplicar</button>
                    <button id="clearBtn" class="btn btn-outline-secondary" type="button">Limpar filtros</button>
                </div>
            </form>
        </div>
    </div>

    @await Html.PartialAsync("Modals/_NewJobModal")


    <div id="loadingOverlay" class="overlay" aria-hidden="true">
        <div class="text-center">
            <div class="spinner-border" role="status" aria-label="Carregando"></div>
            <div class="mt-2 text-secondary">Atualizando resultados…</div>
        </div>
    </div>

    <main class="container pb-5">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div class="text-secondary">
                <span id="resultsCount" class="fw-semibold">0</span> vagas encontradas
            </div>

            <div class="d-none d-md-inline-flex gap-2 align-items-center">
                <button class="btn btn-sm btn-outline-primary"
                        type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#filtersDrawer"
                        aria-controls="filtersDrawer">
                    Ajustar filtros
                </button>

                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        Ordenar
                    </button>
                    <ul class="dropdown-menu">
                        <li><button class="dropdown-item" type="button" data-sort="recent">Mais recentes</button></li>
                        <li><button class="dropdown-item" type="button" data-sort="salaryDesc">Faixa salarial (maior primeiro)</button></li>
                        <li><button class="dropdown-item" type="button" data-sort="companyAsc">Empresa (A–Z)</button></li>
                    </ul>
                </div>
            </div>
        </div>

        <section id="emptyState" class="empty-state d-none" aria-live="polite">
            <h2 class="h5 fw-semibold mb-2">Nenhuma vaga encontrada</h2>
            <p class="text-secondary mb-3">Tente remover alguns filtros ou refinar o texto de busca.</p>
            <button class="btn btn-outline-secondary" type="button" id="emptyClearBtn">Limpar filtros</button>
        </section>
        <section id="jobsGrid" class="jobs-sections" aria-label="Lista de vagas">
    <div class="jobs-loading" id="jobsLoading">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    </div>
</section>
    </main>

    <!-- Modal de detalhes -->
    @await Html.PartialAsync("Modals/_JobModal")


    <!-- Modal de candidatura -->
    @await Html.PartialAsync("Modals/_ApplyModal")


    <!-- Modal de perfil do candidato -->
    <div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalLabel" aria-hidden="true" data-bs-focus="false">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form id="profileForm" class="needs-validation" novalidate>
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title h5 mb-0" id="profileModalLabel">Meu perfil</h2>
                            <div class="text-secondary small">Atualize seus dados basicos e acompanhe o preenchimento das seções.</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-3">
                            <!-- Coluna: dados do candidato (100% altura da linha) -->
                            <div class="col-12 col-lg-5 d-flex" id="profileLeftPanelCol">
                                <div class="border rounded-4 p-3 bg-white flex-fill d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <div class="fw-semibold">Dados do candidato</div>
                                    </div>

                                    <!-- Conteúdo -->
                                    <div class="row g-3 flex-grow-1">
                                        <div class="col-12">
                                            <label for="profileName" class="form-label">Nome completo</label>
                                            <input id="profileName" class="form-control" type="text" value="" required />
                                            <div class="invalid-feedback">Informe seu nome completo.</div>
                                        </div>

                                        <div class="col-12">
                                            <label for="profileEmail" class="form-label">E-mail</label>
                                            <input id="profileEmail" class="form-control" type="email" value="" readonly />
                                            <div class="form-text">O e-mail nao pode ser alterado.</div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label for="profilePhone" class="form-label">Telefone</label>
                                            <input id="profilePhone" class="form-control" type="tel" required />
                                            <div class="invalid-feedback">Informe um telefone para contato.</div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <label for="profileUf" class="form-label">UF</label>
                                            <select id="profileUf" class="form-select" required>
                                                <option value="" selected>Selecione</option>
                                            </select>
                                            <div class="invalid-feedback">Selecione a UF.</div>
                                        </div>

                                        <div class="col-12">
                                            <label for="profileCity" class="form-label">Cidade</label>
                                            <select id="profileCity" class="form-select" required disabled>
                                                <option value="" selected>Selecione a UF primeiro</option>
                                            </select>
                                            <div class="invalid-feedback">Selecione a cidade.</div>
                                        </div>

                                        <!-- Empurra a LGPD pro final do card, se sobrar altura -->
                                        <div class="col-12 mt-auto">
                                            <div class="small text-secondary">
                                                <i class="bi bi-shield-lock me-1"></i>Seus dados sao tratados de acordo com a LGPD.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Coluna: seções (cards) -->
                            <!-- Coluna: seções (cards) - 100% altura como a esquerda -->
                            <div class="col-12 col-lg-7 d-flex" id="profileSectionsCol">
                                <div class="sections-panel flex-fill d-flex flex-column">
    <div id="profileSectionsCards" class="profile-sections-cards flex-grow-1">
        <div class="topics-grid" id="profileTopicsGrid"></div>
    </div>

    <div id="profileSectionsContent" class="profile-sections-content flex-grow-1 d-none">
                <div class="tab-content" id="profileTabsContent">
        <!-- Aba: Perfil -->
                        @await Html.PartialAsync("Sections/_TabProfileSection")
@await Html.PartialAsync("Sections/_TabTestsSection")
@await Html.PartialAsync("Sections/_TabExperienceSection")
@await Html.PartialAsync("Sections/_TabSkillsSection")
@await Html.PartialAsync("Sections/_TabEduSection")
@await Html.PartialAsync("Sections/_TabLgpdSection")
@await Html.PartialAsync("Sections/_TabPrefSection")
@await Html.PartialAsync("Sections/_TabDocsSection")
@await Html.PartialAsync("Sections/_TabRefsSection")
@await Html.PartialAsync("Sections/_TabA11ySection")
@await Html.PartialAsync("Sections/_TabAgendaSection")
@await Html.PartialAsync("Sections/_TabAppsSection")
@await Html.PartialAsync("Sections/_TabNotifySection")
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
                        <button id="profileSaveBtn" class="btn btn-primary" type="submit">Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    


    
    <script>
        window.__portalApiUrl = "@(Configuration["Endpoints:RhApi"] ?? string.Empty)".replace(/\/$/, "");
        window.__portalTenantId = "@(Context.Request.Query["tenantId"].ToString())";
        window.__portalTenantFromClaim = "@(User?.FindFirst("tenant")?.Value ?? string.Empty)";
        window.__portalIsAdmin = "@(User.IsInRole("Admin").ToString().ToLowerInvariant())";
    </script>
    <script src="~/js/views/portal-vagas-profile.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas-profile-demo.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-experience.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-skills.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-education.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-lgpd.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-preferences.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-documents.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-references.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-a11y.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-agenda.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-apps.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-notifications.js" asp-append-version="true"></script>
    <script src="~/js/views/portal-vagas/portal-vagas-index.js" asp-append-version="true"></script>
</body>
</html>
