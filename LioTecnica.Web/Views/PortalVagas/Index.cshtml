@using System.Security.Claims
@{
    Layout = null;
    var userName = User?.Identity?.Name ?? "Candidato";
    var userEmail = User?.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
    var initials = string.Empty;
    var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    if (parts.Length > 0)
    {
        initials += char.ToUpperInvariant(parts[0][0]);
        if (parts.Length > 1)
            initials += char.ToUpperInvariant(parts[parts.Length - 1][0]);
    }
    if (string.IsNullOrWhiteSpace(initials))
        initials = "US";
    var tenantId = Context.Request.Query["tenantId"].ToString();
    if (string.IsNullOrWhiteSpace(tenantId))
    {
        tenantId = User?.FindFirst("tenant")?.Value ?? string.Empty;
    }
}
@inject IConfiguration Configuration
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portal de Vagas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            color-scheme: light;
            --primary-color: #004aad;
            --secondary-color: #7ab800;
            --accent-bg: #f8f9fa;
            --text-dark: #2c3e50;
            --text-muted: #6c757d;
            --radius-xl: 16px;
            --radius-pill: 999px;
        }

        body {
            font-family: "Roboto", sans-serif;
            background-color: var(--accent-bg);
            color: var(--text-dark);
            overflow-x: hidden;
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
        }

        .header-wrapper {
            position: sticky;
            top: 0;
            z-index: 1020;
            box-shadow: 0 4px 20px rgba(0,0,0,.05);
            background: #fff;
        }

        .top-bar {
            background: #fff;
            border-bottom: 1px solid #eee;
            font-size: .85rem;
            padding: 8px 0;
        }

        .top-nav-link {
            color: #6c757d;
            text-decoration: none;
            margin-left: 18px;
            transition: .2s;
            cursor: pointer;
            white-space: nowrap;
        }

        .top-nav-link:hover {
            color: var(--primary-color);
        }

        .main-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, #002855 100%);
            color: white;
            padding: clamp(56px, 6vw, 90px) 0 clamp(44px, 5vw, 70px);
            text-align: center;
        }

        .search-wrapper {
            margin-top: -28px;
            margin-bottom: 40px;
            position: relative;
            z-index: 10;
        }

        .search-box {
            background: white;
            border-radius: var(--radius-xl);
            box-shadow: 0 10px 40px rgba(0,0,0,.15);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 12px 12px 14px;
            flex-wrap: wrap;
        }

        .search-box i {
            flex: 0 0 auto;
            color: #64748b;
        }

        .search-box input {
            border: none;
            flex: 1 1 260px;
            min-width: 160px;
            padding: 12px 10px;
            font-size: 1.02rem;
            outline: none;
            border-radius: var(--radius-pill);
            color: #555;
            background: #fff;
        }

        .btn-search {
            background-color: var(--secondary-color);
            color: white;
            border: none;
            border-radius: var(--radius-pill);
            padding: 10px 22px;
            font-weight: 700;
            transition: .3s;
            white-space: nowrap;
            flex: 0 0 auto;
        }

        .btn-search:hover {
            background-color: #6da300;
            box-shadow: 0 4px 10px rgba(122,184,0,.3);
        }

        .btn-clear {
            background-color: transparent;
            color: #777;
            border: 1px solid #ddd;
            border-radius: var(--radius-pill);
            padding: 10px 16px;
            font-weight: 600;
            transition: .3s;
            white-space: nowrap;
            cursor: pointer;
            flex: 0 0 auto;
        }

        .btn-clear:hover {
            background-color: #f1f1f1;
            color: #666;
        }

        .portal-topbar {
            background: #ffffff;
            border-bottom: 1px solid rgba(0, 0, 0, .08);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .portal-topbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 0;
        }

        .portal-brand {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

        .portal-logo {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            color: #fff;
            font-weight: 700;
            letter-spacing: .08em;
            background: linear-gradient(135deg, #1f6fe5, #154ea7);
            box-shadow: 0 10px 18px rgba(31, 111, 229, .32);
        }

        .portal-logo-text {
            font-size: .9rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: lowercase;
        }

        .portal-user-btn {
            display: flex;
            align-items: center;
            gap: .6rem;
            border-radius: 999px;
            border: 1px solid rgba(0, 0, 0, .08);
            background: #fff;
            padding: .35rem .7rem;
        }

        .portal-user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: linear-gradient(135deg, #1f6fe5, #154ea7);
            color: #fff;
            font-weight: 700;
            display: grid;
            place-items: center;
        }

        .portal-user-name {
            font-weight: 600;
            font-size: .92rem;
        }

        .portal-user-email {
            font-size: .78rem;
            color: #6c757d;
        }

        .portal-user-menu .dropdown-menu {
            min-width: 220px;
        }

        .portal-actions {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .portal-new-job {
            border-radius: 999px;
            font-weight: 600;
        }

        .new-job-modal .modal-body {
            max-height: 70vh;
            overflow-y: auto;
        }

        .portal-brand {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            font-weight: 700;
            font-size: 1.5rem;
            color: #0b1f3b;
            text-decoration: none;
            letter-spacing: .2px;
        }

        .portal-brand i {
            color: #0b1f3b;
            font-size: 1.5rem;
        }

        .job-hero {
            height: 140px;
            background-size: cover;
            background-position: center;
            border-top-left-radius: .75rem;
            border-top-right-radius: .75rem;
            position: relative;
            overflow: hidden;
        }

            .job-hero::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg, rgba(0,0,0,.10), rgba(0,0,0,.55));
            }

        .job-badge-row {
            position: absolute;
            left: .75rem;
            bottom: .75rem;
            right: .75rem;
            display: flex;
            gap: .5rem;
            flex-wrap: wrap;
            z-index: 1;
        }

        .job-title-on-hero {
            position: absolute;
            left: .75rem;
            top: .75rem;
            right: .75rem;
            color: #fff;
            font-size: 1.1rem;
            font-weight: 700;
            line-height: 1.25;
            margin: 0;
            z-index: 1;
            text-shadow: 0 2px 6px rgba(0,0,0,.35);
        }

            .job-badge-row .badge {
                backdrop-filter: blur(4px);
                background: rgba(255,255,255,.16);
                border: 1px solid rgba(255,255,255,.20);
                color: #fff;
                font-weight: 600;
            }

        .job-card {
            border-radius: .75rem;
            overflow: hidden;
            transition: transform .08s ease-in-out, box-shadow .08s ease-in-out;
        }

            .job-card:focus-within,
            .job-card:hover {
                transform: translateY(-1px);
                box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.08);
            }

            .job-card a.job-link {
                outline: none;
            }

                .job-card a.job-link:focus-visible {
                    outline: 3px solid rgba(13,110,253,.45);
                    outline-offset: 3px;
                    border-radius: .5rem;
                }

        .filters-fab {
            position: fixed;
            right: 1rem;
            bottom: 1rem;
            z-index: 1030;
            box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.15);
            border-radius: 999px;
        }

        .back-to-top {
            position: fixed;
            right: 1rem;
            bottom: 4.25rem;
            z-index: 1030;
            border-radius: 999px;
        }

        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,.70);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1025;
        }

            .overlay[aria-hidden="false"] {
                display: flex;
            }

        .job-meta {
            display: flex;
            gap: .5rem;
            flex-wrap: wrap;
            align-items: center;
        }

            .job-meta .dot {
                width: .25rem;
                height: .25rem;
                border-radius: 999px;
                background: #6c757d;
                display: inline-block;
                transform: translateY(-1px);
            }

        .job-section {
            margin-bottom: 2rem;
        }

        .job-section-hero {
            border-radius: 18px;
            padding: 2.2rem 2rem;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-size: cover;
            background-position: center;
            position: relative;
            overflow: hidden;
        }

        .job-section-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(0,74,173,.9), rgba(0,74,173,.55));
        }

        .job-section-title {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: .75rem;
            font-weight: 700;
            font-size: 1.6rem;
        }

        .job-section-count {
            position: relative;
            z-index: 1;
            background: rgba(255,255,255,.2);
            border: 1px solid rgba(255,255,255,.35);
            color: #fff;
            padding: .55rem 1.2rem;
            border-radius: 999px;
            font-size: 1.75rem;
            font-weight: 700;
        }

        .jobs-loading {
            display: flex;
            justify-content: center;
            padding: 3rem 0;
        }


        .filters-form {
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .filters-scroll {
            flex: 1;
            overflow-y: auto;
            padding-right: .25rem;
        }

        .filters-footer {
            border-top: 1px solid rgba(0,0,0,.08);
            padding-top: 1rem;
            margin-top: 1rem;
        }

        .empty-state {
            border: 1px dashed rgba(0,0,0,.20);
            border-radius: .75rem;
            padding: 2rem;
            text-align: center;
            background: rgba(0,0,0,.02);
        }

        /* Modal de candidatura: scroll interno no corpo, header/footer fixos */
        #applyModal .modal-dialog {
            /* Garante que o dialog respeite o viewport */
            height: calc(100% - 2rem);
            margin: 1rem auto;
        }

        #applyModal .modal-content {
            /* Limita a altura total do modal ao viewport */
            max-height: calc(100vh - 2rem);
        }

        #applyModal .modal-body {
            /* Scroll vertical interno */
            overflow-y: auto;
        }

        /* Em telas pequenas, melhora o encaixe */
        @@media (max-width: 576px) {
            #applyModal .modal-dialog {
                margin: .5rem auto;
                height: calc(100% - 1rem);
            }

            #applyModal .modal-content {
                max-height: calc(100vh - 1rem);
            }
        }

        /* ===== Seções (cards 85x85) - dentro do modal de perfil ===== */
        :root {
            --ui-primary: #0d6efd;
            --ui-ink: #0b1220;
            --ui-muted: #6b7280;
            --ui-card: #ffffff;
            --ui-border: rgba(15, 23, 42, .12);
            --ui-shadow: 0 10px 30px rgba(2, 6, 23, .08);
            /* paleta dinâmica */
            --c-low: 210;
            --c-mid: 48;
            --c-high: 135;
        }

        .sections-panel {
            border: none;
            border-radius: 0;
            background: transparent;
            padding: 0;
        }
        .profile-sections-cards {
            min-height: 100%;
        }

        .profile-sections-content {
            background: transparent;
            border: none;
            border-radius: 0;
            padding: 0;
            overflow: auto;
            overflow-x: hidden;
        }

        .profile-avatar {
            position: relative;
            width: 96px;
            height: 96px;
            border-radius: 50%;
            border: 2px solid rgba(13, 110, 253, 0.35);
            overflow: hidden;
            background: #eef4ff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #1e3a8a;
            font-weight: 600;
        }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .profile-avatar-card {
            border: 1px solid rgba(15, 23, 42, .10);
            border-radius: 16px;
            background: #ffffff;
            padding: 16px;
        }

        .profile-avatar-progress {
            height: 8px;
            border-radius: 999px;
        }


        .topics-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 5px 0px;
        }

        @@media (max-width: 992px) {
            .topics-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }

        @@media (max-width: 576px) {
            .topics-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        .topic-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
        }

        .topic-card {
            width: 85px;
            height: 85px;
            border-radius: 16px;
            border: 1px solid var(--ui-border);
            background: var(--ui-card);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            cursor: pointer;
            transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease, background .2s ease;
            user-select: none;
            outline: none;
        }

            .topic-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(2,6,23,.08);
            }

            .topic-card:active {
                transform: translateY(0);
            }

        .topic-icon {
            font-size: 26px;
            color: var(--ui-primary);
            line-height: 1;
            transition: color .2s ease;
        }

        .topic-badge {
            position: absolute;
            right: 8px;
            top: 8px;
            font-size: 11px;
            padding: 3px 7px;
            border-radius: 999px;
            font-weight: 800;
            letter-spacing: .2px;
            border: 1px solid rgba(15, 23, 42, .10);
            background: rgba(255,255,255,.75);
            color: rgba(15, 23, 42, .85);
            backdrop-filter: blur(6px);
        }

        .topic-progress {
            position: absolute;
            left: 10px;
            right: 10px;
            bottom: 9px;
            height: 7px;
            border-radius: 999px;
            background: rgba(2,6,23,.10);
            overflow: hidden;
        }

            .topic-progress > span {
                display: block;
                height: 100%;
                width: 0%;
                border-radius: 999px;
                background: var(--ui-primary);
                transition: width .3s ease;
            }

        .topic-label {
            margin-top: 8px;
            font-size: 12px;
            color: var(--ui-ink);
            text-align: center;
            line-height: 1.15;
            max-width: 130px;
        }

        .topic-sub {
            font-size: 11px;
            color: var(--ui-muted);
            margin-top: 2px;
            text-align: center;
        }

        /* ===== Cards por faixa (igual print) ===== */
        .topic-card {
            border-radius: 16px;
            border: 1px solid rgba(15, 23, 42, .10);
            background: #fff;
        }

            /* Verde (>=75) */
            .topic-card.is-green {
                background: #dff7e7;
                border-color: rgba(22, 163, 74, .18);
            }

                .topic-card.is-green .topic-icon {
                    color: #15803d;
                }

                .topic-card.is-green .topic-progress {
                    background: rgba(21,128,61,.14);
                }

                    .topic-card.is-green .topic-progress > span {
                        background: #16a34a;
                    }

            /* Azul (>=50 e <75) */
            .topic-card.is-blue {
                background: #dff2ff;
                border-color: rgba(2, 132, 199, .18);
            }

                .topic-card.is-blue .topic-icon {
                    color: #0369a1;
                }

                .topic-card.is-blue .topic-progress {
                    background: rgba(3,105,161,.14);
                }

                    .topic-card.is-blue .topic-progress > span {
                        background: #0ea5e9;
                    }

            /* Amarelo (>=25 e <50) */
            .topic-card.is-yellow {
                background: #fff2c6;
                border-color: rgba(245, 158, 11, .22);
            }

                .topic-card.is-yellow .topic-icon {
                    color: #b45309;
                }

                .topic-card.is-yellow .topic-progress {
                    background: rgba(180,83,9,.14);
                }

                    .topic-card.is-yellow .topic-progress > span {
                        background: #f59e0b;
                    }

            /* Vermelho (<25) */
            .topic-card.is-red {
                background: #ffd9d9;
                border-color: rgba(239, 68, 68, .20);
            }

                .topic-card.is-red .topic-icon {
                    color: #b91c1c;
                }

                .topic-card.is-red .topic-progress {
                    background: rgba(185,28,28,.14);
                }

                    .topic-card.is-red .topic-progress > span {
                        background: #ef4444;
                    }

        /* Badge mais suave */
        .topic-badge {
            background: rgba(255,255,255,.65);
            border: 1px solid rgba(15,23,42,.10);
        }


        .topic-card.is-selected {
            outline: 3px solid rgba(13,110,253,.25);
            box-shadow: 0 18px 35px rgba(2,6,23,.12);
            transform: translateY(-2px);
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            border: 1px solid rgba(15, 23, 42, .10);
            background: #fff;
            font-size: 12px;
            color: var(--ui-ink);
        }


        /* ===== Inputs estilo "azul + arredondado" (só no modal Perfil) ===== */
        #profileModal .form-control,
        #profileModal .form-select {
            background: #eef4ff; /* azul claro */
            border: 1px solid rgba(31, 111, 229, .18);
            border-radius: 14px; /* bem arredondado */
            box-shadow: inset 0 1px 0 rgba(255,255,255,.75);
            color: #0b1220;
            padding: .62rem .85rem;
            transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        }

            /* placeholder mais suave */
            #profileModal .form-control::placeholder {
                color: rgba(11, 18, 32, .45);
            }

            /* foco igual "clean" do print */
            #profileModal .form-control:focus,
            #profileModal .form-select:focus {
                background: #eef4ff;
                border-color: rgba(31, 111, 229, .55);
                box-shadow: 0 0 0 .22rem rgba(31, 111, 229, .18);
            }

            /* readonly (email) com visual coerente */
            #profileModal .form-control[readonly] {
                background: #e8f0ff;
                opacity: 1;
                cursor: not-allowed;
            }

        /* selects - seta mais suave */
        #profileModal .form-select {
            background-color: #eef4ff;
        }

        /* labels como no print (menores e suaves) */
        #profileModal .form-label {
            font-size: .85rem;
            font-weight: 600;
            color: rgba(11, 18, 32, .75);
            margin-bottom: .35rem;
        }

        /* ajuda/descricao */
        #profileModal .form-text {
            color: rgba(11, 18, 32, .55);
        }

        #newJobModal .form-control,
        #newJobModal .form-select {
            background: #eef4ff;
            border: 1px solid rgba(31, 111, 229, .18);
            border-radius: 14px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.75);
            color: #0b1220;
            padding: .62rem .85rem;
            transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        }

        #newJobModal .form-control::placeholder {
            color: rgba(11, 18, 32, .45);
        }

        #newJobModal .form-control:focus,
        #newJobModal .form-select:focus {
            background: #eef4ff;
            border-color: rgba(31, 111, 229, .55);
            box-shadow: 0 0 0 .22rem rgba(31, 111, 229, .18);
        }

        #newJobModal .form-select {
            background-color: #eef4ff;
        }

        #newJobModal .form-label {
            font-size: .85rem;
            font-weight: 600;
            color: rgba(11, 18, 32, .75);
            margin-bottom: .35rem;
        }

        #newJobModal .form-text {
            color: rgba(11, 18, 32, .55);
        }

        /* ===== Modal "Meu perfil" igual ao print ===== */
        #profileModal .modal-dialog {
            height: calc(100vh - 2rem);
            margin: 1rem auto;
        }

        #profileModal .modal-dialog .modal-content {
            height: 100%;
        }

        #profileModal .modal-content {
            display: flex;
            flex-direction: column;
            max-height: calc(100vh - 2rem);
            height: 100%;
            border-radius: 22px; /* cantos arredondados */
            border: 1px solid rgba(15, 23, 42, .10); /* borda fina */
            box-shadow: 0 18px 50px rgba(2, 6, 23, .14), /* sombra externa suave */
            0 1px 0 rgba(255,255,255,.60) inset; /* brilho interno */
            overflow: hidden; /* garante cantos limpos */
            background: #ffffff;
            overflow-x: hidden;
        }

        #profileModal form {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
        }

        /* Header com linha bem leve */
        #profileModal .modal-header {
            border-bottom: 1px solid rgba(15, 23, 42, .08);
            padding: 18px 20px;
            background: #ffffff;
        }

        /* Body com leve azul (igual print) */
        #profileModal .modal-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            background: #f3f7ff; /* azul muito suave */
            padding: 18px 20px;
        }

        /* Scrollbar estilo Pixel */
        #profileModal .modal-body::-webkit-scrollbar {
            width: 12px;
        }

        #profileModal .modal-body::-webkit-scrollbar-track {
            background: #e6ecfb;
            border-radius: 999px;
        }

        #profileModal .modal-body::-webkit-scrollbar-thumb {
            background: #182b57;
            border-radius: 999px;
            border: 3px solid #e6ecfb;
        }

        #profileModal .modal-body {
            scrollbar-color: #182b57 #e6ecfb;
            scrollbar-width: auto;
        }

        /* Footer com leve azul e linha suave */
        #profileModal .modal-footer {
            border-top: 1px solid rgba(15, 23, 42, .08);
            background: #f3f7ff;
            padding: 14px 20px;
            margin-top: auto;
        }

        #tagEditModal .modal-dialog {
            max-width: 360px;
            height: auto;
        }

        #tagEditModal .modal-content {
            height: auto;
            max-height: none;
        }

        #tagEditModal .modal-body {
            padding: 1rem 1.25rem;
            flex: 0 0 auto;
        }

        #tagEditModal .modal-footer {
            padding: .75rem 1rem 1rem;
        }

        #newJobModal .modal-dialog {
            height: calc(100vh - 2rem);
            margin: 1rem auto;
        }

        #newJobModal .modal-dialog .modal-content {
            height: 100%;
        }

        #newJobModal .modal-content {
            display: flex;
            flex-direction: column;
            max-height: calc(100vh - 2rem);
            height: 100%;
            border-radius: 22px;
            border: 1px solid rgba(15, 23, 42, .10);
            box-shadow: 0 18px 50px rgba(2, 6, 23, .14),
            0 1px 0 rgba(255,255,255,.60) inset;
            overflow: hidden;
            background: #ffffff;
            overflow-x: hidden;
        }

        #newJobModal form {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
        }

        #newJobModal .modal-header {
            border-bottom: 1px solid rgba(15, 23, 42, .08);
            padding: 18px 20px;
            background: #ffffff;
        }

        #newJobModal .modal-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            background: #f3f7ff;
            padding: 18px 20px;
        }

        #newJobModal .modal-body::-webkit-scrollbar {
            width: 12px;
        }

        #newJobModal .modal-body::-webkit-scrollbar-track {
            background: #e6ecfb;
            border-radius: 999px;
        }

        #newJobModal .modal-body::-webkit-scrollbar-thumb {
            background: #182b57;
            border-radius: 999px;
            border: 3px solid #e6ecfb;
        }

        #newJobModal .modal-body {
            scrollbar-color: #182b57 #e6ecfb;
            scrollbar-width: auto;
        }

        #newJobModal .modal-footer {
            border-top: 1px solid rgba(15, 23, 42, .08);
            background: #f3f7ff;
            padding: 14px 20px;
            margin-top: auto;
        }


        @@media (max-width: 576px) {
            #profileModal .modal-dialog {
                height: calc(100vh - 1rem);
                margin: .5rem auto;
            }

            #profileModal .modal-content {
                max-height: calc(100vh - 1rem);
            }

            #newJobModal .modal-dialog {
                height: calc(100vh - 1rem);
                margin: .5rem auto;
            }

            #newJobModal .modal-content {
                max-height: calc(100vh - 1rem);
            }
        }
    





        /* Botão fechar arredondado e suave (opcional) */
        #profileModal .btn-close {
            background-color: rgba(15,23,42,.06);
            border-radius: 999px;
            padding: 10px;
            opacity: .9;
        }

            #profileModal .btn-close:hover {
                opacity: 1;
            }

        #newJobModal .btn-close {
            background-color: rgba(15,23,42,.06);
            border-radius: 999px;
            padding: 10px;
            opacity: .9;
        }

            #newJobModal .btn-close:hover {
                opacity: 1;
            }

    </style>
