@{ Layout = null; }
@inject IConfiguration Configuration
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portal de Vagas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            color-scheme: light;
        }

        .job-hero {
            height: 140px;
            background-size: cover;
            background-position: center;
            border-top-left-radius: .75rem;
            border-top-right-radius: .75rem;
            position: relative;
            overflow: hidden;
        }

            .job-hero::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg, rgba(0,0,0,.10), rgba(0,0,0,.55));
            }

        .job-badge-row {
            position: absolute;
            left: .75rem;
            bottom: .75rem;
            right: .75rem;
            display: flex;
            gap: .5rem;
            flex-wrap: wrap;
            z-index: 1;
        }

            .job-badge-row .badge {
                backdrop-filter: blur(4px);
                background: rgba(255,255,255,.16);
                border: 1px solid rgba(255,255,255,.20);
                color: #fff;
                font-weight: 600;
            }

        .job-card {
            border-radius: .75rem;
            overflow: hidden;
            transition: transform .08s ease-in-out, box-shadow .08s ease-in-out;
        }

            .job-card:focus-within,
            .job-card:hover {
                transform: translateY(-1px);
                box-shadow: 0 .5rem 1.25rem rgba(0,0,0,.08);
            }

            .job-card a.job-link {
                outline: none;
            }

                .job-card a.job-link:focus-visible {
                    outline: 3px solid rgba(13,110,253,.45);
                    outline-offset: 3px;
                    border-radius: .5rem;
                }

        .filters-fab {
            position: fixed;
            right: 1rem;
            bottom: 1rem;
            z-index: 1030;
            box-shadow: 0 .75rem 1.5rem rgba(0,0,0,.15);
            border-radius: 999px;
        }

        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,.70);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1025;
        }

            .overlay[aria-hidden="false"] {
                display: flex;
            }

        .job-meta {
            display: flex;
            gap: .5rem;
            flex-wrap: wrap;
            align-items: center;
        }

            .job-meta .dot {
                width: .25rem;
                height: .25rem;
                border-radius: 999px;
                background: #6c757d;
                display: inline-block;
                transform: translateY(-1px);
            }

        .empty-state {
            border: 1px dashed rgba(0,0,0,.20);
            border-radius: .75rem;
            padding: 2rem;
            text-align: center;
            background: rgba(0,0,0,.02);
        }

        /* Modal de candidatura: scroll interno no corpo, header/footer fixos */
        #applyModal .modal-dialog {
            /* Garante que o dialog respeite o viewport */
            height: calc(100% - 2rem);
            margin: 1rem auto;
        }

        #applyModal .modal-content {
            /* Limita a altura total do modal ao viewport */
            max-height: calc(100vh - 2rem);
        }

        #applyModal .modal-body {
            /* Scroll vertical interno */
            overflow-y: auto;
        }

        /* Em telas pequenas, melhora o encaixe */
        @@media (max-width: 576px) {
            #applyModal .modal-dialog {
                margin: .5rem auto;
                height: calc(100% - 1rem);
            }

            #applyModal .modal-content {
                max-height: calc(100vh - 1rem);
            }
        }
    </style>
</head>

<body class="bg-body-tertiary">

    <!-- Alertas (erro/sucesso) -->
    <div class="container py-3">
        <div id="appAlert" class="alert d-none" role="alert" aria-live="polite"></div>
    </div>

    <header class="container pb-2">
        <div class="text-center py-3 py-md-4">
            <h1 class="display-6 fw-semibold mb-2">Vagas em Destaque</h1>
            <p class="lead text-secondary mb-0">
                Encontre oportunidades por área, nível, formato e localização.
            </p>
        </div>
    </header>

    <button class="btn btn-primary filters-fab px-3 py-2"
            type="button"
            data-bs-toggle="offcanvas" data-bs-target="#filtersDrawer"
            aria-controls="filtersDrawer" aria-label="Abrir filtros">
        <span class="me-2" aria-hidden="true">☰</span> Filtros
    </button>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="filtersDrawer" aria-labelledby="filtersDrawerLabel">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title fs-5" id="filtersDrawerLabel">Filtros</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
        </div>

        <div class="offcanvas-body">
            <form id="filtersForm" novalidate>
                <div class="mb-3">
                    <label for="q" class="form-label">Buscar</label>
                    <input id="q" name="q" type="search" class="form-control"
                           placeholder="Cargo, empresa, tecnologia..."
                           autocomplete="off" />
                    <div class="form-text" id="qHint">Dica: “C#”, “Produto”, “Dados”, “UX”.</div>
                </div>

                <div class="row g-2">
                    <div class="col-12">
                        <label for="location" class="form-label">Local</label>
                        <select id="location" name="location" class="form-select">
                            <option value="">Qualquer</option>
                            <option>São Paulo, SP</option>
                            <option>Rio de Janeiro, RJ</option>
                            <option>Belo Horizonte, MG</option>
                            <option>Curitiba, PR</option>
                            <option>Remoto (Brasil)</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label for="mode" class="form-label">Formato</label>
                        <select id="mode" name="mode" class="form-select">
                            <option value="">Qualquer</option>
                            <option>Remoto</option>
                            <option>Híbrido</option>
                            <option>Presencial</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label for="type" class="form-label">Tipo</label>
                        <select id="type" name="type" class="form-select">
                            <option value="">Qualquer</option>
                            <option>CLT</option>
                            <option>PJ</option>
                            <option>Estágio</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label for="level" class="form-label">Senioridade</label>
                        <select id="level" name="level" class="form-select">
                            <option value="">Qualquer</option>
                            <option>Júnior</option>
                            <option>Pleno</option>
                            <option>Sênior</option>
                            <option>Liderança</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label for="area" class="form-label">Área</label>
                        <select id="area" name="area" class="form-select">
                            <option value="">Qualquer</option>
                            <option>Engenharia</option>
                            <option>Dados</option>
                            <option>Produto</option>
                            <option>Design</option>
                            <option>Segurança</option>
                            <option>Operações</option>
                        </select>
                    </div>
                </div>

                <hr class="my-4">

                <div class="mb-3">
                    <label for="minSalary" class="form-label">Salário mínimo (R$)</label>
                    <input id="minSalary" name="minSalary" type="number" class="form-control"
                           inputmode="numeric" min="0" step="500" placeholder="Ex.: 8000" />
                    <div class="form-text">Filtra por vagas cuja faixa máxima seja compatível.</div>
                </div>

                <div class="d-grid gap-2">
                    <button id="applyBtn" class="btn btn-primary" type="submit">Aplicar</button>
                    <button id="clearBtn" class="btn btn-outline-secondary" type="button">Limpar filtros</button>
                </div>
            </form>

            <div class="mt-4 small text-secondary" aria-hidden="true">
                Use Tab para navegar e Enter para aplicar.
            </div>
        </div>
    </div>

    <div id="loadingOverlay" class="overlay" aria-hidden="true">
        <div class="text-center">
            <div class="spinner-border" role="status" aria-label="Carregando"></div>
            <div class="mt-2 text-secondary">Atualizando resultados…</div>
        </div>
    </div>

    <main class="container pb-5">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div class="text-secondary">
                <span id="resultsCount" class="fw-semibold">0</span> vagas encontradas
            </div>

            <div class="d-none d-md-inline-flex gap-2 align-items-center">
                <button class="btn btn-sm btn-outline-primary"
                        type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#filtersDrawer"
                        aria-controls="filtersDrawer">
                    Ajustar filtros
                </button>

                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        Ordenar
                    </button>
                    <ul class="dropdown-menu">
                        <li><button class="dropdown-item" type="button" data-sort="recent">Mais recentes</button></li>
                        <li><button class="dropdown-item" type="button" data-sort="salaryDesc">Faixa salarial (maior primeiro)</button></li>
                        <li><button class="dropdown-item" type="button" data-sort="companyAsc">Empresa (A–Z)</button></li>
                    </ul>
                </div>
            </div>
        </div>

        <section id="emptyState" class="empty-state d-none" aria-live="polite">
            <h2 class="h5 fw-semibold mb-2">Nenhuma vaga encontrada</h2>
            <p class="text-secondary mb-3">Tente remover alguns filtros ou refinar o texto de busca.</p>
            <button class="btn btn-outline-secondary" type="button" id="emptyClearBtn">Limpar filtros</button>
        </section>

        <section class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-4" id="jobsGrid" aria-label="Lista de vagas">
            <div class="col-12 d-flex justify-content-center py-5" id="jobsLoading">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Carregando...</span>
                </div>
            </div>
        </section>
    </main>

    <!-- Modal de detalhes -->
    <div class="modal fade" id="jobModal" tabindex="-1" aria-labelledby="jobModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5 mb-0" id="jobModalLabel">Detalhes da vaga</h2>
                        <div id="jobModalCompany" class="text-secondary small"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="p-3 bg-body-tertiary rounded-3 border">
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <span id="jobModalMode" class="badge text-bg-primary"></span>
                                    <span id="jobModalType" class="badge text-bg-secondary"></span>
                                    <span id="jobModalLevel" class="badge text-bg-dark"></span>
                                    <span id="jobModalArea" class="badge text-bg-light border text-dark"></span>
                                </div>
                                <div class="mt-2 text-secondary">
                                    <strong>Local:</strong> <span id="jobModalLocation"></span>
                                    <span class="mx-2 text-secondary">•</span>
                                    <strong>Faixa:</strong> <span id="jobModalSalary"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <h3 class="h6 fw-semibold">Tecnologias / Tags</h3>
                            <div id="jobModalTags" class="d-flex flex-wrap gap-2"></div>
                        </div>

                        <div class="col-12">
                            <h3 class="h6 fw-semibold">Resumo</h3>
                            <p id="jobModalSummary" class="text-secondary mb-0"></p>
                        </div>

                        <div class="col-12">
                            <h3 class="h6 fw-semibold">Principais responsabilidades</h3>
                            <ul id="jobModalResp" class="mb-0 text-secondary"></ul>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a id="jobModalAnchor" class="btn btn-outline-secondary" href="#" role="button">
                        Copiar link interno
                    </a>

                    <!-- NOVO: abrir modal de candidatura -->
                    <button id="jobModalApplyBtn" type="button" class="btn btn-primary">
                        Candidatar-se
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de candidatura -->
    <div class="modal fade" id="applyModal" tabindex="-1" aria-labelledby="applyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <form id="applyForm" class="modal-content needs-validation" novalidate>
                    <div class="modal-header">
                        <div>
                            <h2 class="modal-title h5 mb-0" id="applyModalLabel">Enviar candidatura</h2>
                            <div class="text-secondary small" id="applyModalJobLine"></div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>

                    <div class="modal-body">
                        <!-- Alerta interno do modal (erros de validação/envio) -->
                        <div id="applyAlert" class="alert alert-danger d-none" role="alert" aria-live="polite"></div>

                        <!-- Dados da vaga (readonly, para evitar erro humano) -->
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label for="applyJobTitle" class="form-label">Vaga</label>
                                <input id="applyJobTitle" class="form-control" type="text" readonly />
                            </div>
                            <div class="col-12 col-md-6">
                                <label for="applyCompany" class="form-label">Empresa</label>
                                <input id="applyCompany" class="form-control" type="text" readonly />
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Dados do candidato -->
                        <h3 class="h6 fw-semibold mb-3">Dados do candidato</h3>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label for="fullName" class="form-label">Nome completo</label>
                                <input id="fullName" name="fullName" class="form-control" type="text" required />
                                <div class="invalid-feedback">Informe seu nome completo.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="email" class="form-label">E-mail</label>
                                <input id="email" name="email" class="form-control" type="email" required autocomplete="email" />
                                <div class="invalid-feedback">Informe um e-mail válido.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="phone" class="form-label">Telefone / WhatsApp</label>
                                <input id="phone" name="phone" class="form-control" type="tel" required placeholder="(DD) 9XXXX-XXXX" autocomplete="tel" />
                                <div class="invalid-feedback">Informe um telefone para contato.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="candidateLocation" class="form-label">Cidade/UF</label>
                                <input id="candidateLocation" name="candidateLocation" class="form-control" type="text" required placeholder="Ex.: São Paulo, SP" />
                                <div class="invalid-feedback">Informe sua localização.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="linkedin" class="form-label">LinkedIn</label>
                                <input id="linkedin" name="linkedin" class="form-control" type="url" placeholder="https://linkedin.com/in/..." />
                                <div class="form-text">Opcional, mas ajuda bastante na triagem.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="portfolio" class="form-label">Portfólio / GitHub</label>
                                <input id="portfolio" name="portfolio" class="form-control" type="url" placeholder="https://..." />
                                <div class="form-text">Opcional (ideal para Design/Engenharia/Dados).</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="currentRole" class="form-label">Cargo atual</label>
                                <input id="currentRole" name="currentRole" class="form-control" type="text" required />
                                <div class="invalid-feedback">Informe seu cargo atual (ou último).</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="experienceYears" class="form-label">Anos de experiência</label>
                                <input id="experienceYears" name="experienceYears" class="form-control" type="number" min="0" step="1" required />
                                <div class="invalid-feedback">Informe um número válido.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="salaryExpectation" class="form-label">Pretensão (R$)</label>
                                <input id="salaryExpectation" name="salaryExpectation" class="form-control" type="number" min="0" step="500" required placeholder="Ex.: 12000" />
                                <div class="invalid-feedback">Informe sua pretensão salarial.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label for="availability" class="form-label">Disponibilidade para iniciar</label>
                                <select id="availability" name="availability" class="form-select" required>
                                    <option value="" selected>Selecione</option>
                                    <option>Imediata</option>
                                    <option>Até 15 dias</option>
                                    <option>Até 30 dias</option>
                                    <option>Mais de 30 dias</option>
                                </select>
                                <div class="invalid-feedback">Selecione sua disponibilidade.</div>
                            </div>

                            <div class="col-12">
                                <label for="highlights" class="form-label">Resumo profissional</label>
                                <textarea id="highlights" name="highlights" class="form-control" rows="4" required
                                          placeholder="Conte, em poucas linhas, os pontos mais relevantes: impacto, projetos, stack, resultados."></textarea>
                                <div class="invalid-feedback">Escreva um breve resumo profissional.</div>
                            </div>

                            <div class="col-12">
                                <label for="recruiterNotes" class="form-label">Informações adicionais</label>
                                <textarea id="recruiterNotes" name="recruiterNotes" class="form-control" rows="3"
                                          placeholder="Ex.: preferências de formato (remoto/híbrido), viagem/mudança, certificações, etc."></textarea>
                            </div>

                            <div class="col-12">
                                <label for="attachment" class="form-label">Anexo (opcional)</label>
                                <input id="attachment" name="attachment" class="form-control" type="file"
                                       accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                                <div class="form-text" id="attachmentHint">Tipos aceitos: PDF, DOC, DOCX. Tamanho máximo: 5MB.</div>
                                <div class="invalid-feedback" id="attachmentInvalid">Arquivo inválido.</div>
                            </div>

                            <div class="col-12">
                                <!-- Regra importante: consentimento explícito -->
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="1" id="consent" name="consent" required>
                                    <label class="form-check-label" for="consent">
                                        Concordo em compartilhar meus dados para fins de recrutamento e seleção.
                                    </label>
                                    <div class="invalid-feedback">Você precisa concordar para enviar a candidatura.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button id="sendApplicationBtn" type="submit" class="btn btn-primary">
                            <span id="sendBtnText">Enviar candidatura</span>
                            <span id="sendBtnSpinner" class="spinner-border spinner-border-sm ms-2 d-none" aria-hidden="true"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
      window.__portalApiUrl = "@(Configuration["Endpoints:RhApi"] ?? string.Empty)".replace(/\/$/, "");
      window.__portalTenantId = "@(Context.Request.Query["tenantId"].ToString())";
      window.__portalTenantFromClaim = "@(User?.FindFirst("tenant")?.Value ?? string.Empty)";
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    /**
     * Intenção:
     * - Candidatura completa, com validação e upload opcional.
     * - Sem engolir erro: toda falha resulta em alerta visível.
     * - Mantém a seleção da vaga atual para preencher o modal de candidatura.
     */
    (async function () {
      const elAlert = document.getElementById("appAlert");
      const overlay = document.getElementById("loadingOverlay");
      const apiBase = (window.__portalApiUrl || "").replace(/\/$/, "");
      const tenantId = window.__portalTenantId
        || window.__portalTenantFromClaim
        || new URLSearchParams(window.location.search).get("tenantId")
        || new URLSearchParams(window.location.search).get("tenant")
        || "";
      const grid = document.getElementById("jobsGrid");
      const gridLoading = document.getElementById("jobsLoading");
      let items = [];
      const resultsCount = document.getElementById("resultsCount");
      const emptyState = document.getElementById("emptyState");

      const filtersForm = document.getElementById("filtersForm");
      const clearBtn = document.getElementById("clearBtn");
      const emptyClearBtn = document.getElementById("emptyClearBtn");

      const jobModalEl = document.getElementById("jobModal");
      const jobModal = new bootstrap.Modal(jobModalEl, { backdrop: true, keyboard: true });

      const applyModalEl = document.getElementById("applyModal");
      const applyModal = new bootstrap.Modal(applyModalEl, { backdrop: "static", keyboard: true }); // static para evitar perda acidental

      const jobModalApplyBtn = document.getElementById("jobModalApplyBtn");

      const applyForm = document.getElementById("applyForm");
      const applyAlert = document.getElementById("applyAlert");
      const sendBtn = document.getElementById("sendApplicationBtn");
      const sendBtnText = document.getElementById("sendBtnText");
      const sendBtnSpinner = document.getElementById("sendBtnSpinner");

      const attachmentInput = document.getElementById("attachment");
      const attachmentInvalid = document.getElementById("attachmentInvalid");

      let currentSort = "recent";

      // Mantém a vaga atual selecionada (para candidatura)
      let currentJob = null;

      const heroGradients = [
        "linear-gradient(135deg, #1e3a8a, #0ea5e9)",
        "linear-gradient(135deg, #0f766e, #22c55e)",
        "linear-gradient(135deg, #7c3aed, #ec4899)",
        "linear-gradient(135deg, #d97706, #f97316)",
        "linear-gradient(135deg, #1d4ed8, #38bdf8)",
        "linear-gradient(135deg, #4f46e5, #6366f1)"
      ];

      function setGridLoading(isLoading) {
        if (!gridLoading) return;
        gridLoading.classList.toggle("d-none", !isLoading);
      }

      function showAppAlert(type, message) {
        // type: "success" | "danger"
        elAlert.className = "alert alert-" + type;
        elAlert.textContent = message;
        elAlert.classList.remove("d-none");
      }

      function clearAppAlert() {
        elAlert.textContent = "";
        elAlert.classList.add("d-none");
      }

      function showApplyAlert(message) {
        applyAlert.textContent = message;
        applyAlert.classList.remove("d-none");
      }

      function clearApplyAlert() {
        applyAlert.textContent = "";
        applyAlert.classList.add("d-none");
      }

      function setLoading(isLoading) {
        overlay.setAttribute("aria-hidden", isLoading ? "false" : "true");
      }

      function setSendLoading(isLoading) {
        // Regra: evitar double-submit e dar feedback visual consistente
        sendBtn.disabled = isLoading;
        sendBtnSpinner.classList.toggle("d-none", !isLoading);
        sendBtnText.textContent = isLoading ? "Enviando..." : "Enviar candidatura";
      }

      function normalize(str) {
        return (str || "").toString().trim().toLowerCase();
      }

      function parseNumber(value) {
        const n = Number(value);
        return Number.isFinite(n) ? n : null;
      }

      function parseTags(raw) {
        if (!raw) return [];
        return raw
          .split(/[;,]/)
          .map(x => x.trim())
          .filter(Boolean);
      }

      function buildTags(job) {
        const tags = [
          ...parseTags(job.tagsKeywordsRaw),
          ...parseTags(job.tagsStackRaw),
          ...parseTags(job.tagsResponsabilidadesRaw)
        ];
        return Array.from(new Set(tags));
      }

      function formatLocation(job) {
        const city = (job.cidade || "").trim();
        const uf = (job.uf || "").trim();
        if (city && uf) return `${city}, ${uf}`;
        if (city) return city;
        if (uf) return uf;
        return job.modalidade || "Nao informado";
      }

      function normalizeEnum(value) {
        return value || "Nao informado";
      }

      function buildJobCard(job, index) {
        const tags = buildTags(job);
        const company = job.tenantName || "Portal RH";
        const location = formatLocation(job);
        const mode = normalizeEnum(job.modalidade);
        const type = normalizeEnum(job.tipoContratacao);
        const level = normalizeEnum(job.senioridade);
        const area = job.area || "Geral";
        const salaryMin = job.salarioMinimo || 0;
        const salaryMax = job.salarioMaximo || 0;
        const createdAt = job.createdAtUtc ? new Date(job.createdAtUtc) : new Date();
        const dateIso = createdAt.toISOString().slice(0, 10);

        const col = document.createElement("div");
        col.className = "col job-item";
        col.dataset.id = job.id;
        col.dataset.title = job.titulo || "Vaga";
        col.dataset.company = company;
        col.dataset.location = location;
        col.dataset.mode = mode;
        col.dataset.type = type;
        col.dataset.level = level;
        col.dataset.area = area;
        col.dataset.tags = tags.join(", ");
        col.dataset.salaryMin = String(salaryMin);
        col.dataset.salaryMax = String(salaryMax);
        col.dataset.date = dateIso;

        const badgeHtml = [mode, type, level]
          .filter(Boolean)
          .map(item => `<span class="badge rounded-pill">${item}</span>`)
          .join("");

        const tagHtml = tags.slice(0, 6)
          .map(tag => `<span class="badge text-bg-light border">${tag}</span>`)
          .join("");

        const salaryLine = salaryMax ? `Faixa: ${formatMoney(salaryMin, salaryMax)}` : "Faixa: a combinar";
        const hero = heroGradients[index % heroGradients.length];

        col.innerHTML = `
          <article class="card job-card h-100">
            <div class="job-hero" style="background-image:${hero};">
              <div class="job-badge-row">
                ${badgeHtml}
              </div>
            </div>
            <div class="card-body">
              <h3 class="h5 fw-semibold mb-1">${col.dataset.title}</h3>
              <div class="text-secondary mb-2">${company}</div>
              <div class="job-meta text-secondary small mb-3">
                <span>${location}</span><span class="dot" aria-hidden="true"></span>
                <span>${area}</span>
              </div>
              <div class="d-flex flex-wrap gap-2 mb-2">
                ${tagHtml || "<span class=\"badge text-bg-light border\">Geral</span>"}
              </div>
              <div class="text-secondary small">${salaryLine}</div>
              <a class="stretched-link job-link" href="#${col.dataset.id}"
                 aria-label="Ver detalhes da vaga ${col.dataset.title}"></a>
            </div>
          </article>`;

        return col;
      }

      async function loadJobs() {
        if (!apiBase) {
          showAppAlert("danger", "Nao foi possivel carregar as vagas. URL da API nao configurada.");
          setGridLoading(false);
          grid.replaceChildren();
          return;
        }
        if (!tenantId) {
          showAppAlert("danger", "Tenant nao informado. Use o parametro tenantId na URL.");
          setGridLoading(false);
          grid.replaceChildren();
          return;
        }

        if (gridLoading) {
          grid.replaceChildren(gridLoading);
        }
        setGridLoading(true);
        try {
          const url = `${apiBase}/api/public/vagas?tenantId=${encodeURIComponent(tenantId)}`;
          const res = await fetch(url, { headers: { "accept": "application/json" } });
          if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
          }
          const data = await res.json();
          const fragment = document.createDocumentFragment();
          data.forEach((job, index) => {
            fragment.appendChild(buildJobCard(job, index));
          });
          grid.replaceChildren();
          grid.appendChild(fragment);
          items = Array.from(grid.querySelectorAll(".job-item"));
        } catch (err) {
          console.error(err);
          showAppAlert("danger", "Nao foi possivel carregar as vagas. Tente novamente.");
        } finally {
          setGridLoading(false);
        }
      }

      function getFilters() {
        const q = normalize(document.getElementById("q").value);
        const location = document.getElementById("location").value.trim();
        const mode = document.getElementById("mode").value.trim();
        const type = document.getElementById("type").value.trim();
        const level = document.getElementById("level").value.trim();
        const area = document.getElementById("area").value.trim();
        const minSalary = parseNumber(document.getElementById("minSalary").value);

        return { q, location, mode, type, level, area, minSalary };
      }

      function matchesFilters(item, f) {
        const haystack = normalize(
          item.dataset.title + " " + item.dataset.company + " " + item.dataset.tags
        );

        if (f.q && !haystack.includes(f.q)) return false;
        if (f.location && item.dataset.location !== f.location) return false;
        if (f.mode && item.dataset.mode !== f.mode) return false;
        if (f.type && item.dataset.type !== f.type) return false;
        if (f.level && item.dataset.level !== f.level) return false;
        if (f.area && item.dataset.area !== f.area) return false;

        if (f.minSalary !== null) {
          const max = parseNumber(item.dataset.salaryMax);
          if (max === null) return false;
          if (max < f.minSalary) return false;
        }

        return true;
      }

      function sortItems(visibleItems) {
        const sorted = [...visibleItems];

        if (currentSort === "recent") {
          sorted.sort((a, b) => (b.dataset.date || "").localeCompare(a.dataset.date || ""));
        } else if (currentSort === "salaryDesc") {
          sorted.sort((a, b) => (Number(b.dataset.salaryMax) || 0) - (Number(a.dataset.salaryMax) || 0));
        } else if (currentSort === "companyAsc") {
          sorted.sort((a, b) => (a.dataset.company || "").localeCompare(b.dataset.company || "", "pt-BR"));
        }

        return sorted;
      }

      function render(filters) {
        clearAppAlert();

        const visible = items.filter(i => matchesFilters(i, filters));
        const sorted = sortItems(visible);

        const fragment = document.createDocumentFragment();
        sorted.forEach(el => fragment.appendChild(el));
        items
          .filter(el => !visible.includes(el))
          .forEach(el => fragment.appendChild(el));

        grid.appendChild(fragment);

        items.forEach(el => {
          el.classList.toggle("d-none", !visible.includes(el));
        });

        resultsCount.textContent = String(visible.length);
        emptyState.classList.toggle("d-none", visible.length !== 0);
      }

      function resetFilters() {
        filtersForm.reset();
        currentSort = "recent";
        render(getFilters());
      }

      function formatMoney(min, max) {
        const f = (n) => n.toLocaleString("pt-BR");
        return `R$ ${f(min)} – ${f(max)}`;
      }

      function buildSummary(item) {
        const title = item.dataset.title;
        const company = item.dataset.company;
        const tags = (item.dataset.tags || "").split(",").map(x => x.trim()).filter(Boolean);
        return `${title} em ${company}, com foco em ${tags.slice(0, 3).join(", ")}. Atuação ${item.dataset.mode.toLowerCase()} e colaboração com time multidisciplinar para entregar valor contínuo.`;
      }

      function buildResponsibilities(item) {
        const area = item.dataset.area;
        const base = [
          "Participar de planejamento e refinamento, alinhando escopo e qualidade",
          "Implementar melhorias com atenção a performance, segurança e manutenção",
          "Garantir comunicação clara com áreas parceiras e registrar decisões relevantes"
        ];

        if (area === "Engenharia") {
          base.unshift("Desenvolver e evoluir serviços e interfaces com testes e revisão de código");
          base.push("Apoiar observabilidade (logs/métricas) e correção de incidentes com causa raiz");
        } else if (area === "Dados") {
          base.unshift("Construir e manter pipelines e modelos de dados com rastreabilidade");
          base.push("Definir padrões de qualidade e monitoramento de dados (alertas e validações)");
        } else if (area === "Produto") {
          base.unshift("Conduzir discovery, alinhar objetivos e priorizar roadmap orientado a métricas");
          base.push("Desenhar e acompanhar experimentos, com aprendizado documentado");
        } else if (area === "Design") {
          base.unshift("Desenhar fluxos e interfaces com acessibilidade e consistência visual");
          base.push("Evoluir design system e conduzir pesquisa com usuários quando necessário");
        } else if (area === "Segurança") {
          base.unshift("Atuar em AppSec e revisão de riscos (ameaças e vulnerabilidades)");
          base.push("Definir guardrails de segurança em CI/CD e apoiar squads na adoção");
        } else if (area === "Operações") {
          base.unshift("Padronizar rotinas e processos para elevar eficiência e previsibilidade");
          base.push("Acompanhar indicadores e sugerir melhorias contínuas (SLA/qualidade)");
        }

        return base.slice(0, 6);
      }

      function openJobModal(item) {
        currentJob = item; // seleciona vaga atual

        document.getElementById("jobModalLabel").textContent = item.dataset.title;
        document.getElementById("jobModalCompany").textContent = item.dataset.company;

        document.getElementById("jobModalMode").textContent = item.dataset.mode;
        document.getElementById("jobModalType").textContent = item.dataset.type;
        document.getElementById("jobModalLevel").textContent = item.dataset.level;
        document.getElementById("jobModalArea").textContent = item.dataset.area;

        document.getElementById("jobModalLocation").textContent = item.dataset.location;

        const min = Number(item.dataset.salaryMin) || 0;
        const max = Number(item.dataset.salaryMax) || 0;
        document.getElementById("jobModalSalary").textContent = formatMoney(min, max);

        const tagsWrap = document.getElementById("jobModalTags");
        tagsWrap.innerHTML = "";
        (item.dataset.tags || "")
          .split(",")
          .map(x => x.trim())
          .filter(Boolean)
          .forEach(tag => {
            const span = document.createElement("span");
            span.className = "badge text-bg-light border";
            span.textContent = tag;
            tagsWrap.appendChild(span);
          });

        document.getElementById("jobModalSummary").textContent = buildSummary(item);

        const ul = document.getElementById("jobModalResp");
        ul.innerHTML = "";
        buildResponsibilities(item).forEach(r => {
          const li = document.createElement("li");
          li.textContent = r;
          ul.appendChild(li);
        });

        const anchor = document.getElementById("jobModalAnchor");
        anchor.href = "#" + item.dataset.id;

        jobModal.show();
      }

      function openApplyModalFromCurrentJob() {
        if (!currentJob) {
          // Sem fallback silencioso: mostra erro claro e loga contexto
          console.error("Candidatura solicitada sem currentJob definido.");
          showAppAlert("danger", "Não foi possível iniciar a candidatura. Abra os detalhes de uma vaga e tente novamente.");
          return;
        }

        // Limpa mensagens/validação anterior
        clearApplyAlert();
        applyForm.classList.remove("was-validated");
        applyForm.reset();
        setSendLoading(false);

        // Preenche dados da vaga
        document.getElementById("applyJobTitle").value = currentJob.dataset.title;
        document.getElementById("applyCompany").value = currentJob.dataset.company;
        document.getElementById("applyModalJobLine").textContent =
          `${currentJob.dataset.title} • ${currentJob.dataset.company} • ${currentJob.dataset.mode}`;

        // Reseta validação do anexo
        attachmentInput.classList.remove("is-invalid");
        attachmentInvalid.textContent = "Arquivo inválido.";

        // Fecha detalhes e abre candidatura (fluxo claro)
        jobModal.hide();
        applyModal.show();
      }

      function validateAttachment() {
        // Regra: upload opcional, mas se houver arquivo, validar tipo e tamanho
        const file = attachmentInput.files && attachmentInput.files[0] ? attachmentInput.files[0] : null;
        attachmentInput.classList.remove("is-invalid");

        if (!file) return true;

        const maxBytes = 5 * 1024 * 1024; // 5MB
        if (file.size > maxBytes) {
          attachmentInvalid.textContent = "O arquivo excede 5MB. Selecione um arquivo menor.";
          attachmentInput.classList.add("is-invalid");
          return false;
        }

        const allowedExt = [".pdf", ".doc", ".docx"];
        const name = (file.name || "").toLowerCase();
        const okExt = allowedExt.some(ext => name.endsWith(ext));

        if (!okExt) {
          attachmentInvalid.textContent = "Formato não aceito. Use PDF, DOC ou DOCX.";
          attachmentInput.classList.add("is-invalid");
          return false;
        }

        return true;
      }

      // Clique nos cards
      grid.addEventListener("click", (ev) => {
        const link = ev.target.closest("a.job-link");
        if (!link) return;

        ev.preventDefault();
        const jobItem = ev.target.closest(".job-item");
        if (!jobItem) return;

        try {
          openJobModal(jobItem);
        } catch (err) {
          console.error(err);
          showAppAlert("danger", "Ocorreu um erro ao abrir os detalhes da vaga. Recarregue a página e tente novamente.");
        }
      });

      // Botão "Candidatar-se" no modal de detalhes
      jobModalApplyBtn.addEventListener("click", () => {
        try {
          openApplyModalFromCurrentJob();
        } catch (err) {
          console.error(err);
          showAppAlert("danger", "Ocorreu um erro ao iniciar a candidatura. Recarregue a página e tente novamente.");
        }
      });

      // Validação do anexo ao mudar o arquivo
      attachmentInput.addEventListener("change", () => {
        try {
          validateAttachment();
        } catch (err) {
          console.error(err);
          // Não bloqueia a UI, mas avisa de forma explícita
          showApplyAlert("Não foi possível validar o arquivo selecionado. Tente novamente.");
        }
      });

      // Envio da candidatura
      applyForm.addEventListener("submit", async (ev) => {
        ev.preventDefault();
        ev.stopPropagation();

        try {
          clearApplyAlert();

          // Bootstrap validation
          applyForm.classList.add("was-validated");

          const isFormValid = applyForm.checkValidity();
          const isAttachmentValid = validateAttachment();

          if (!isFormValid || !isAttachmentValid) {
            showApplyAlert("Revise os campos destacados antes de enviar.");
            return;
          }

          setSendLoading(true);

          // Monta payload com FormData (inclui arquivo)
          const formData = new FormData(applyForm);
          formData.append("jobId", currentJob?.dataset?.id || "");
          formData.append("jobTitle", currentJob?.dataset?.title || "");
          formData.append("company", currentJob?.dataset?.company || "");

          /**
           * Intenção:
           * - Aqui você chamaria um endpoint real (fetch POST).
           * - Como é um HTML estático, registramos o envio e damos feedback ao usuário.
           */
          await new Promise(resolve => window.setTimeout(resolve, 650));

          // Registro mínimo em memória (útil para debug local sem poluir a UI)
          // Regra: não esconder erro; console é só complemento.
          const sent = {
            jobId: formData.get("jobId"),
            jobTitle: formData.get("jobTitle"),
            company: formData.get("company"),
            fullName: formData.get("fullName"),
            email: formData.get("email"),
            phone: formData.get("phone"),
            attachmentName: attachmentInput.files?.[0]?.name || null
          };
          console.info("Candidatura enviada:", sent);

          applyModal.hide();
          showAppAlert("success", "Candidatura enviada com sucesso. Você pode continuar navegando pelas vagas.");

          // Boa prática: volta foco para um ponto previsível após fechar modal
          document.querySelector("main")?.scrollIntoView({ behavior: "smooth", block: "start" });

        } catch (err) {
          console.error(err);
          setSendLoading(false);
          showApplyAlert("Ocorreu um erro ao enviar sua candidatura. Tente novamente.");
        } finally {
          // Se deu certo, o modal fecha e o botão some; se deu erro, reabilita aqui.
          setSendLoading(false);
        }
      });

      // Aplicar filtros
      filtersForm.addEventListener("submit", (ev) => {
        ev.preventDefault();
        try {
          setLoading(true);
          window.setTimeout(() => {
            render(getFilters());
            setLoading(false);
          }, 250);
        } catch (err) {
          setLoading(false);
          console.error(err);
          showAppAlert("danger", "Ocorreu um erro ao aplicar filtros. Verifique os campos e tente novamente.");
        }
      });

      // Limpar filtros
      clearBtn.addEventListener("click", () => {
        try {
          setLoading(true);
          window.setTimeout(() => {
            resetFilters();
            setLoading(false);
          }, 150);
        } catch (err) {
          setLoading(false);
          console.error(err);
          showAppAlert("danger", "Ocorreu um erro ao limpar filtros. Recarregue a página e tente novamente.");
        }
      });
      emptyClearBtn.addEventListener("click", () => clearBtn.click());

      // Ordenação
      document.addEventListener("click", (ev) => {
        const btn = ev.target.closest("[data-sort]");
        if (!btn) return;

        try {
          currentSort = btn.getAttribute("data-sort");
          setLoading(true);
          window.setTimeout(() => {
            render(getFilters());
            setLoading(false);
          }, 150);
        } catch (err) {
          setLoading(false);
          console.error(err);
          showAppAlert("danger", "Ocorreu um erro ao ordenar os resultados. Tente novamente.");
        }
      });

      // Render inicial
      try {
        await loadJobs();
        render(getFilters());
      } catch (err) {
        console.error(err);
        showAppAlert("danger", "Ocorreu um erro ao carregar a página. Recarregue e tente novamente.");
      }
    })();
    </script>
</body>
</html>
