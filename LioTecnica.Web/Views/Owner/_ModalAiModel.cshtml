<div class="modal fade" id="modalAiModel" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content" style="border-radius: 18px; border: 1px solid var(--lt-border);">
      <div class="modal-header">
        <div>
          <h5 class="modal-title fw-bold" id="modalAiModelTitle">Novo modelo</h5>
          <div class="text-muted small">Vincule a uma chave e escolha o tipo (ex.: GPT-4o mini, Claude 3.5, Gemini 1.5).</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="aiModelId" />

        <div class="row g-2">
          <div class="col-12">
            <label class="form-label small text-muted">Chave (provedor) *</label>
            <select class="form-select" id="aiModelKeyId">
              <option value="">Selecione uma chave...</option>
            </select>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label small text-muted">Tipo / ModelId *</label>
            <select class="form-select" id="aiModelTypeSuggest">
              <option value="">Outro (digite abaixo)</option>
              <optgroup label="GPT (OpenAI)" data-provider="Gpt">
                <option value="gpt-4o">gpt-4o</option>
                <option value="gpt-4o-mini">gpt-4o-mini</option>
                <option value="gpt-4-turbo">gpt-4-turbo</option>
                <option value="gpt-3.5-turbo">gpt-3.5-turbo</option>
              </optgroup>
              <optgroup label="Gemini (Google)" data-provider="Gemini">
                <option value="gemini-1.5-pro">gemini-1.5-pro</option>
                <option value="gemini-1.5-flash">gemini-1.5-flash</option>
                <option value="gemini-1.0-pro">gemini-1.0-pro</option>
              </optgroup>
              <optgroup label="Claude (Anthropic)" data-provider="Claude">
                <option value="claude-3-5-sonnet-20241022">claude-3-5-sonnet</option>
                <option value="claude-3-opus-20240229">claude-3-opus</option>
                <option value="claude-3-haiku-20240307">claude-3-haiku</option>
              </optgroup>
            </select>
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label small text-muted">ModelId (se outro)</label>
            <input type="text" class="form-control" id="aiModelModelId" placeholder="Ex.: gpt-4o-mini" maxlength="120" />
          </div>

          <div class="col-12">
            <label class="form-label small text-muted">Nome para exibição *</label>
            <input type="text" class="form-control" id="aiModelDisplayName" placeholder="Ex.: GPT-4o Mini" maxlength="160" />
          </div>

          <div class="col-12">
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="aiModelIsDefault" />
              <label class="form-check-label small" for="aiModelIsDefault">Modelo padrão (para esta chave)</label>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" type="button" data-bs-dismiss="modal">
          <i class="bi bi-x-lg me-1"></i>Cancelar
        </button>
        <button class="btn btn-brand" type="button" id="btnSaveAiModel">
          <i class="bi bi-check2 me-1"></i>Salvar
        </button>
      </div>
    </div>
  </div>
</div>
