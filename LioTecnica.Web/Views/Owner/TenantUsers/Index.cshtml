@model LioTecnica.Web.ViewModels.Admin.UsersPageViewModel
@{
    var tenantId = ViewData["TenantId"] as string ?? "";
    ViewData["Title"] = $"OWNER • Usuários • {tenantId}";
    ViewData["SidebarSubtitle"] = "Proprietário";
}

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", $"OWNER • Usuários • {tenantId}")
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Tenants" asp-controller="Owner">
            <i class="bi bi-arrow-left me-1"></i>Voltar aos tenants
        </a>
        <a class="btn btn-primary btn-sm" asp-action="NewTenantUser" asp-controller="Owner" asp-route-tenantId="@tenantId">
            <i class="bi bi-plus-lg me-1"></i>Novo usuário
        </a>
        @await Html.PartialAsync("_TopbarUserActions", "Owner")
    </div>
}

<section class="content">
    <div class="page-title d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4>Usuários do tenant <code>@tenantId</code></h4>
            <div class="subtitle">Criar, editar e gerenciar usuários deste tenant.</div>
        </div>
    </div>

    @if (TempData["OwnerError"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }
    @if (TempData["OwnerSuccess"] is string ok)
    {
        <div class="alert alert-success">@ok</div>
    }

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Perfis</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model?.Users ?? Array.Empty<LioTecnica.Web.ViewModels.Admin.UserListItemViewModel>())
                    {
                        <tr>
                            <td>@u.FullName</td>
                            <td class="text-muted small">@u.Email</td>
                            <td>
                                @if (u.Roles?.Count > 0)
                                {
                                    @string.Join(", ", u.Roles)
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (u.IsActive)
                                { <span class="badge bg-success">Ativo</span> }
                                else
                                { <span class="badge bg-secondary">Inativo</span> }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="EditTenantUser" asp-controller="Owner" asp-route-tenantId="@tenantId" asp-route-id="@u.Id">Editar</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="SetTenantUserPassword" asp-controller="Owner" asp-route-tenantId="@tenantId" asp-route-id="@u.Id">Alterar senha</a>
                                    <form asp-action="DeleteTenantUser" asp-controller="Owner" asp-route-tenantId="@tenantId" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Remover este usuário?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model?.Users?.Count == 0)
        {
            <div class="card-body">
                <p class="text-muted mb-2">Nenhum usuário neste tenant.</p>
                <p class="small text-muted mb-3">Se o tenant foi criado pela tela Owner e ainda não tem usuários, execute o seed para criar o usuário admin inicial (admin@dev.local). Caso contrário, crie um novo usuário manualmente.</p>
                <div class="d-flex flex-wrap gap-2">
                    <form asp-action="SeedTenant" asp-controller="Owner" asp-route-tenantId="@tenantId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-database-add me-1"></i>Executar seed (criar admin inicial)
                        </button>
                    </form>
                    <a class="btn btn-primary btn-sm" asp-action="NewTenantUser" asp-controller="Owner" asp-route-tenantId="@tenantId">
                        <i class="bi bi-person-plus me-1"></i>Criar usuário manualmente
                    </a>
                </div>
            </div>
        }
    </div>
</section>

@section Footer {
    @await Html.PartialAsync("_Footer", Array.Empty<object>())
}
