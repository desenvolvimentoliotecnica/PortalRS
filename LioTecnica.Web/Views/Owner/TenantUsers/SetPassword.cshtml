@{
    var tenantId = ViewData["TenantId"] as string ?? "";
    var userId = ViewData["UserId"];
    ViewData["Title"] = "Alterar senha";
}

@section Topbar {
    <div class="d-flex align-items-center justify-content-between w-100">
        <div>
            <div class="h5 mb-0">Alterar senha do usuário</div>
            <div class="text-muted small">Tenant: @tenantId</div>
        </div>
        <a class="btn btn-outline-secondary" asp-action="TenantUsers" asp-controller="Owner" asp-route-tenantId="@tenantId">Voltar</a>
    </div>
}

<div class="container-fluid py-3">
    <div class="card shadow-sm" style="max-width: 420px;">
        <div class="card-body">
            <form method="post" action="@Url.Action("SetTenantUserPassword", "Owner", new { tenantId, id = userId })">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label" for="newPassword">Nova senha</label>
                    <input class="form-control" id="newPassword" name="newPassword" type="password" required minlength="8" placeholder="Mínimo 8 caracteres" />
                    <span class="text-muted small">Mínimo 8 caracteres (letras, números e símbolos recomendados).</span>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="confirmPassword">Confirmar nova senha</label>
                    <input class="form-control" id="confirmPassword" type="password" placeholder="Repita a senha" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Alterar senha</button>
                    <a class="btn btn-outline-secondary" asp-action="TenantUsers" asp-controller="Owner" asp-route-tenantId="@tenantId">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            var p = document.getElementById('newPassword').value;
            var c = document.getElementById('confirmPassword').value;
            if (p !== c) {
                e.preventDefault();
                alert('A confirmação da senha não confere.');
            }
        });
    </script>
}

@section Footer {
    @await Html.PartialAsync("_Footer", Array.Empty<object>())
}
