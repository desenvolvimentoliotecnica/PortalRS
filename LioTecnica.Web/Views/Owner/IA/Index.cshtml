@{
    ViewData["Title"] = "OWNER • IA";
    ViewData["SidebarSubtitle"] = "Proprietário";
}

@await Html.PartialAsync("_ModalAiKey")
@await Html.PartialAsync("_ModalAiModel")
@await Html.PartialAsync("_Toast")

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", "OWNER • IA")
    <div class="d-flex align-items-center gap-2">
        @await Html.PartialAsync("_TopbarUserActions", "Owner")
    </div>
}

<section class="content">
    <div class="page-title">
        <h4>IA</h4>
        <div class="subtitle">Configuração de chaves e modelos, relatórios e detalhes de uso por tenant e usuário.</div>
    </div>

    @if (TempData["OwnerError"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }
    @if (TempData["OwnerSuccess"] is string ok)
    {
        <div class="alert alert-success">@ok</div>
    }

    <ul class="nav nav-tabs mb-3" id="ownerIaTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="config-tab" data-bs-toggle="tab" data-bs-target="#config" type="button" role="tab">Configuração</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard" type="button" role="tab">Dashboard (relatórios e detalhes)</button>
        </li>
    </ul>

    <div class="tab-content" id="ownerIaTabContent">
        <div class="tab-pane fade show active" id="config" role="tabpanel">
            <div class="row g-3">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Chaves de API</h5>
                            <button type="button" class="btn btn-sm btn-brand" id="btnAddKey">
                                <i class="bi bi-plus me-1"></i>Nova chave
                            </button>
                        </div>
                        <div class="card-body">
                            <div id="keysListContainer">
                                <p class="text-muted mb-0">Carregando...</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Modelos</h5>
                            <button type="button" class="btn btn-sm btn-brand" id="btnAddModel">
                                <i class="bi bi-plus me-1"></i>Novo modelo
                            </button>
                        </div>
                        <div class="card-body">
                            <div id="modelsListContainer">
                                <p class="text-muted mb-0">Carregando...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="dashboard" role="tabpanel">
            <div class="card mb-3">
                <div class="card-header">Filtros</div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label class="form-label small">De</label>
                            <input type="datetime-local" id="filterFrom" class="form-control form-control-sm" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small">Até</label>
                            <input type="datetime-local" id="filterTo" class="form-control form-control-sm" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small">Tenant</label>
                            <input type="text" id="filterTenantId" class="form-control form-control-sm" placeholder="Opcional" />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small">Módulo</label>
                            <input type="text" id="filterModule" class="form-control form-control-sm" placeholder="Opcional" />
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-sm btn-primary" id="btnApplyFilters">
                                <i class="bi bi-funnel me-1"></i>Aplicar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-lg-6">
                    <div class="card">
                        <div class="card-header">Resumo por tenant</div>
                        <div class="card-body">
                            <div id="summaryByTenantContainer">
                                <p class="text-muted mb-0">Selecione período e clique em Aplicar.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="card">
                        <div class="card-header">Resumo por usuário</div>
                        <div class="card-body">
                            <div id="summaryByUserContainer">
                                <p class="text-muted mb-0">Selecione período e clique em Aplicar.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">Detalhes por linhas (uso, usuário solicitante, mensagem enviada à IA)</div>
                <div class="card-body">
                    <div id="detailContainer">
                        <p class="text-muted mb-0">Selecione período e clique em Aplicar.</p>
                    </div>
                    <nav id="detailPagination" class="mt-2"></nav>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @if (ViewData["OwnerConfigApiBase"] != null)
    {
        <script>window.__ownerIaApiBase = "@ViewData["OwnerConfigApiBase"]/_api";</script>
    }
    <script src="~/js/views/owner-ia.js" asp-append-version="true"></script>
}
