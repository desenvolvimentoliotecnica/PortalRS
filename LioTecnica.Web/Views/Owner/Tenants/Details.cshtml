@model LioTecnica.Web.Infrastructure.ApiClients.TenantDetailDto
@{
    ViewData["Title"] = "OWNER • Detalhes do tenant";
    ViewData["SidebarSubtitle"] = "Proprietário";
    var migrationStatus = ViewData["MigrationStatus"] as LioTecnica.Web.Infrastructure.ApiClients.TenantMigrationStatusDto;
    var tenantId = Model.TenantId?.Trim().ToLowerInvariant() ?? "";
}

@section Topbar {
    @await Html.PartialAsync("_TopbarBrand", "OWNER • Detalhes do tenant")
    <div class="d-flex align-items-center gap-2">
        @await Html.PartialAsync("_TopbarUserActions", "Owner")
    </div>
}

<section class="content">
    <div class="page-title d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h4>Detalhes do tenant</h4>
            <div class="subtitle">TenantId: <code>@Model.TenantId</code></div>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Tenants" asp-controller="Owner">
            <i class="bi bi-arrow-left me-1"></i>Voltar à lista
        </a>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" asp-action="Details" asp-controller="Owner" asp-route-tenantId="@tenantId" aria-current="page">Geral</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="TenantUsers" asp-controller="Owner" asp-route-tenantId="@tenantId">Usuários</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="ConfigAcessos" asp-controller="Owner" asp-route-tenantId="@tenantId">Acessos</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="ConfigMenus" asp-controller="Owner" asp-route-tenantId="@tenantId">Menus</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="ConfigLogs" asp-controller="Owner" asp-route-tenantId="@tenantId">Logs transacionais</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="ConfigOperationalLogs" asp-controller="Owner" asp-route-tenantId="@tenantId">Logs operacionais</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="ConfigEmailTemplates" asp-controller="Owner" asp-route-tenantId="@tenantId">Templates de email</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="ConfigEmails" asp-controller="Owner" asp-route-tenantId="@tenantId">Emails</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="ConfigEmailConfig" asp-controller="Owner" asp-route-tenantId="@tenantId">Config email</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="ConfigEntraIdConfig" asp-controller="Owner" asp-route-tenantId="@tenantId">Config Entra ID</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" asp-action="ConfigLocalizationConfig" asp-controller="Owner" asp-route-tenantId="@tenantId">Idioma</a>
        </li>
    </ul>

    @if (TempData["OwnerError"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }
    @if (TempData["OwnerSuccess"] is string ok)
    {
        <div class="alert alert-success">@ok</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">TenantId</dt>
                <dd class="col-sm-9"><code>@Model.TenantId</code></dd>

                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Ativo</dt>
                <dd class="col-sm-9">@(Model.IsActive ? "Sim" : "Não")</dd>

                <dt class="col-sm-3">Criado em</dt>
                <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") (UTC)</dd>

                <dt class="col-sm-3">Atualizado em</dt>
                <dd class="col-sm-9">@Model.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm") (UTC)</dd>

                <dt class="col-sm-3">Criado por</dt>
                <dd class="col-sm-9">@(Model.CreatedByOwnerEmail ?? "—")</dd>

                @if (migrationStatus != null)
                {
                    <dt class="col-sm-3">Schema (Migrações)</dt>
                    <dd class="col-sm-9">
                        @if (migrationStatus.ErrorMessage != null)
                        {
                            <span class="badge bg-danger" title="@migrationStatus.ErrorMessage">Erro</span>
                        }
                        else if (migrationStatus.IsUpToDate)
                        {
                            <span class="badge bg-success">Ok</span>
                        }
                        else if (migrationStatus.PendingCount > 0)
                        {
                            <span class="badge bg-warning text-dark">Pendente (@migrationStatus.PendingCount)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">—</span>
                        }
                    </dd>
                }
            </dl>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Ações</div>
        <div class="card-body d-flex flex-wrap gap-2">
            <a class="btn btn-success" asp-action="TenantUsers" asp-controller="Owner" asp-route-tenantId="@Model.TenantId">
                <i class="bi bi-people me-1"></i>Usuários do tenant
            </a>
            @if (migrationStatus is { IsUpToDate: false, PendingCount: > 0, ErrorMessage: null })
            {
                <form asp-action="ApplyMigrations" asp-controller="Owner" asp-route-tenantId="@Model.TenantId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-primary">Aplicar migrações</button>
                </form>
            }
            <form asp-action="SeedTenant" asp-controller="Owner" asp-route-tenantId="@Model.TenantId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">Executar seed</button>
            </form>
        </div>
    </div>

    @if (Model.IsActive)
    {
        <div class="card border-danger">
            <div class="card-body">
                <h6 class="text-danger">Eliminar tenant</h6>
                <p class="mb-2 small text-muted">O tenant ficará inativo e todos os usuários deixarão de poder acessá-lo. Os dados não são removidos.</p>
                <form asp-action="DeleteTenant" asp-controller="Owner" asp-route-tenantId="@Model.TenantId" method="post" class="d-inline" onsubmit="return confirm('Tem certeza? O tenant ficará inativo e os usuários não poderão acessá-lo.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Eliminar tenant
                    </button>
                </form>
            </div>
        </div>
    }
</section>

@section Footer {
    @await Html.PartialAsync("_Footer", Array.Empty<object>())
}
