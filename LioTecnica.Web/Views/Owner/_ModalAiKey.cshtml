<div class="modal fade" id="modalAiKey" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content" style="border-radius: 18px; border: 1px solid var(--lt-border);">
      <div class="modal-header">
        <div>
          <h5 class="modal-title fw-bold" id="modalAiKeyTitle">Nova chave de API</h5>
          <div class="text-muted small">Configure provedor (Gemini, GPT ou Claude), nome e chave. Marque ativo e padrão conforme necessário.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="aiKeyId" />

        <div class="row g-2">
          <div class="col-12 col-md-6">
            <label class="form-label small text-muted">Provedor *</label>
            <select class="form-select" id="aiKeyProvider">
              <option value="">Selecione...</option>
              <option value="Gpt">GPT (OpenAI / Azure)</option>
              <option value="Gemini">Gemini (Google)</option>
              <option value="Claude">Claude (Anthropic)</option>
            </select>
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label small text-muted">Nome da chave *</label>
            <input type="text" class="form-control" id="aiKeyName" placeholder="Ex.: Chave produção OpenAI" maxlength="120" />
          </div>

          <div class="col-12">
            <label class="form-label small text-muted">Chave (API Key) *</label>
            <input type="password" class="form-control" id="aiKeyValue" placeholder="Deixe em branco ao editar para não alterar" autocomplete="off" />
            <div class="form-text">Ao editar, deixe em branco para manter a chave atual.</div>
          </div>

          <div class="col-12 col-md-6">
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="aiKeyIsActive" checked />
              <label class="form-check-label small" for="aiKeyIsActive">Ativo</label>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="aiKeyIsDefault" />
              <label class="form-check-label small" for="aiKeyIsDefault">Chave padrão (para este provedor)</label>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" type="button" data-bs-dismiss="modal">
          <i class="bi bi-x-lg me-1"></i>Cancelar
        </button>
        <button class="btn btn-brand" type="button" id="btnSaveAiKey">
          <i class="bi bi-check2 me-1"></i>Salvar
        </button>
      </div>
    </div>
  </div>
</div>
