@model LioTecnica.Web.ViewModels.Admin.RoleFormModel
@{
    ViewData["Title"] = Model.Id is null ? "New Role" : "Edit Role";
}
@section Topbar {
    <div class="d-flex align-items-center justify-content-between w-100">
        <div>
            <div class="h5 mb-0">@ViewData["Title"]</div>
            <div class="text-muted small">Role details.</div>
        </div>
        <a class="btn btn-outline-secondary" href="/Admin/Roles">Back</a>
    </div>
}

<div class="container-fluid py-3">
    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post" action="@(Model.Id is null ? "/Admin/Roles/New" : $"/Admin/Roles/Edit/{Model.Id}")">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="Name">Name</label>
                        <input class="form-control" id="Name" name="Name" value="@Model.Name" />
                        <span class="text-danger small">@Html.ValidationMessage("Name")</span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="IsActive">Status</label>
                        <select class="form-select" id="IsActive" name="IsActive">
                            <option value="true" selected="@(Model.IsActive ? "selected" : null)">Active</option>
                            <option value="false" selected="@(!Model.IsActive ? "selected" : null)">Inactive</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="Description">Description</label>
                        <textarea class="form-control" id="Description" name="Description" rows="3">@Model.Description</textarea>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="VisibilityScope">Visão na estrutura</label>
                        <select class="form-select" id="VisibilityScope" name="VisibilityScope">
                            <option value="0" selected="@(Model.VisibilityScope == 0)">Completa</option>
                            <option value="1" selected="@(Model.VisibilityScope == 1)">Restrita (área/recrutador)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="VagasDataScope">Escopo de vagas</label>
                        <select class="form-select" id="VagasDataScope" name="VagasDataScope">
                            <option value="0" selected="@(Model.VagasDataScope == 0)">Todas</option>
                            <option value="1" selected="@(Model.VagasDataScope == 1)">Por área</option>
                            <option value="2" selected="@(Model.VagasDataScope == 2)">Por recrutador</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="AccessMode">Modo de acesso</label>
                        <select class="form-select" id="AccessMode" name="AccessMode">
                            <option value="0" selected="@(Model.AccessMode == 0)">Completo</option>
                            <option value="1" selected="@(Model.AccessMode == 1)">Somente leitura</option>
                        </select>
                    </div>
                </div>

                @if (Model.Id.HasValue)
                {
                    <div class="mt-4 pt-4 border-top">
                        <h6 class="fw-semibold text-muted mb-3">O que este perfil acessa</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <div class="small text-muted">Visão na estrutura</div>
                                <div class="fw-semibold" id="summaryVisibility">
                                    @(Model.VisibilityScope == 0 ? "Completa" : "Restrita (área/recrutador)")
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="small text-muted">Escopo de vagas</div>
                                <div class="fw-semibold" id="summaryVagas">
                                    @(Model.VagasDataScope == 0 ? "Todas" : Model.VagasDataScope == 1 ? "Por área" : "Por recrutador")
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="small text-muted">Modo de acesso</div>
                                <div class="fw-semibold" id="summaryAccess">
                                    @(Model.AccessMode == 0 ? "Completo" : "Somente leitura")
                                </div>
                            </div>
                        </div>
                        <div class="small text-muted mb-2">Menus e permissões atribuídos a este perfil</div>
                        <div id="roleMenusContainer" class="bg-light rounded p-3" style="max-height: 280px; overflow-y: auto;">
                            <div id="roleMenusLoading" class="text-muted small">Carregando...</div>
                            <ul id="roleMenusList" class="list-unstyled mb-0 small"></ul>
                        </div>
                    </div>
                }

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a class="btn btn-outline-secondary ms-2" href="/Admin/Roles">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Footer {
    @await Html.PartialAsync("_Footer", new[] { new { Text = "Roles", Class = "muted" } })
}

@section Scripts {
    @if (Model.Id.HasValue)
    {
        <script>
            (function() {
                var visibilityLabels = ['Completa', 'Restrita (área/recrutador)'];
                var vagasLabels = ['Todas', 'Por área', 'Por recrutador'];
                var accessLabels = ['Completo', 'Somente leitura'];
                function updateSummary() {
                    var vis = document.getElementById("VisibilityScope");
                    var vagas = document.getElementById("VagasDataScope");
                    var access = document.getElementById("AccessMode");
                    var sumVis = document.getElementById("summaryVisibility");
                    var sumVagas = document.getElementById("summaryVagas");
                    var sumAccess = document.getElementById("summaryAccess");
                    if (sumVis && vis) sumVis.textContent = visibilityLabels[parseInt(vis.value, 10)] || vis.value;
                    if (sumVagas && vagas) sumVagas.textContent = vagasLabels[parseInt(vagas.value, 10)] || vagas.value;
                    if (sumAccess && access) sumAccess.textContent = accessLabels[parseInt(access.value, 10)] || access.value;
                }
                ['VisibilityScope', 'VagasDataScope', 'AccessMode'].forEach(function(id) {
                    var el = document.getElementById(id);
                    if (el) el.addEventListener('change', updateSummary);
                });

                var loading = document.getElementById("roleMenusLoading");
                var list = document.getElementById("roleMenusList");
                if (!loading || !list) return;
                fetch('/UsuariosPerfis/_api/roles/@Model.Id/menus', { headers: { 'Accept': 'application/json' } })
                    .then(function(r) { return r.ok ? r.json() : []; })
                    .then(function(menus) {
                        loading.remove();
                        if (!menus || menus.length === 0) {
                            var li = document.createElement('li');
                            li.className = 'text-muted';
                            li.textContent = 'Nenhum menu atribuído. A atribuição de menus é feita em Admin \u00BB Menus ou pelo seed do sistema.';
                            list.appendChild(li);
                        } else {
                            menus.forEach(function(m) {
                                var li = document.createElement('li');
                                li.className = 'py-1';
                                var code = document.createElement('code');
                                code.className = 'small';
                                code.textContent = m.permissionKey || '-';
                                li.appendChild(code);
                                list.appendChild(li);
                            });
                        }
                    })
                    .catch(function() {
                        loading.textContent = 'Erro ao carregar a lista de menus.';
                    });
            })();
        </script>
    }
}
