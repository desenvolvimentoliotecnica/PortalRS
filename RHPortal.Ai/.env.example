# Copie para .env e preencha
# Conexão com o mesmo PostgreSQL do RHPortal (banco default: owner/system)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/dev_render

# Template para banco por tenant (igual à API). Ex.: dev_render_{0} -> dev_render_liotecnica
# TENANT_DATABASE_TEMPLATE=postgresql://usuario:senha@localhost:5432/dev_render_{0}

# Chave OpenAI (para embeddings e LLM)
OPENAI_API_KEY=sk-...

# Opcional: tenant para filtrar (deixe vazio para usar header/body)
# TENANT_ID=dev
