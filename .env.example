# =============================================================================
# Template de ambiente para Docker Compose - Render RH (servidor real)
# Copie para .env e preencha com valores reais: cp .env.example .env
# NUNCA commite o arquivo .env - contém credenciais
# =============================================================================

# --- ECR / Imagens Docker ---
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
IMAGE_TAG=latest

# --- API (.NET) - ConnectionStrings (formato Npgsql) ---
ConnectionStrings__Default=Host=SEU_HOST;Port=5432;Database=SEU_DB;Username=SEU_USER;Password=SEU_PASSWORD
ConnectionStrings__Master=Host=SEU_HOST;Port=5432;Database=dev_render;Username=SEU_USER;Password=SEU_PASSWORD
ConnectionStrings__TenantTemplate=Host=SEU_HOST;Port=5432;Database=dev_render_{0};Username=SEU_USER;Password=SEU_PASSWORD

# --- AI (Python) - PostgreSQL ---
DATABASE_URL=postgresql://SEU_USER:SEU_PASSWORD@SEU_HOST:5432/dev_render
TENANT_DATABASE_TEMPLATE=postgresql://SEU_USER:SEU_PASSWORD@SEU_HOST:5432/dev_render_{0}

# --- OpenAI (obrigatório para o serviço AI) ---
OPENAI_API_KEY=sk-...

# --- Web Next (frontend) ---
# URL do backend API (acessível pelo browser)
NEXT_PUBLIC_API_URL=http://localhost:5000
# URL do sistema legado (se houver)
LEGACY_ORIGIN=

# --- Opcional: CORS, JWT, etc. ---
# Cors__WebOrigin=https://seu-dominio.com
# Jwt__SigningKey=CHANGE_THIS_SIGNING_KEY
# Ops__ResetKey=CHANGE_THIS_RESET_KEY
