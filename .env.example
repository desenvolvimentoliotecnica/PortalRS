# ==============================================================================
# .env.example — Template de variáveis de ambiente para deploy via pipeline
# Copie este arquivo para .env.qa ou .env.prod e preencha com valores reais.
# ==============================================================================

# ── Deploy / AWS ──────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
IMAGE_TAG=latest

# ── RHPortal.Api — Connection Strings ─────────────────────────────────────────
ConnectionStrings__Default=Host=localhost;Port=5432;Database=bddev;Username=sysdba;Password=CHANGE_ME
ConnectionStrings__Master=Host=localhost;Port=5432;Database=dev_render;Username=sysdba;Password=CHANGE_ME
ConnectionStrings__TenantTemplate=Host=localhost;Port=5432;Database=dev_render_{0};Username=sysdba;Password=CHANGE_ME

# ── RHPortal.Api — Database ───────────────────────────────────────────────────
Database__Environment=qa
Database__SystemName=render

# ── RHPortal.Api — JWT ────────────────────────────────────────────────────────
Jwt__SigningKey=CHANGE_THIS_TO_A_STRONG_RANDOM_KEY_64_CHARS_MIN
Jwt__Issuer=RhPortal
Jwt__Audience=RhPortal
Jwt__AccessTokenExpirationMinutes=30

# ── RHPortal.Api — CORS ──────────────────────────────────────────────────────
Cors__AllowAny=true
Cors__WebOrigin=https://your-domain.com

# ── RHPortal.Api — Seed ──────────────────────────────────────────────────────
Seed__OwnerEmail=owner@your-domain.com
Seed__OwnerPassword=CHANGE_ME
Seed__Enabled=false
Seed__ResetDatabase=false

# ── RHPortal.Api — Ops ───────────────────────────────────────────────────────
Ops__ResetKey=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_RESET_KEY

# ── RHPortal.Api — Email ─────────────────────────────────────────────────────
EmailConfig__EncryptionKey=CHANGE_THIS_TO_A_64_HEX_CHAR_KEY

# ── RHPortal.Api — InboxFolder ───────────────────────────────────────────────
InboxFolder__RootPath=/app/inbox
InboxFolder__IncomingFolderName=incoming
InboxFolder__ProcessedFolderName=processado
InboxFolder__ErrorFolderName=erro

# ── RHPortal.Api — SLA Vaga ──────────────────────────────────────────────────
SlaVaga__DiasMetaFechamento=30
SlaVaga__DiasMetaUrgente=15

# ── RHPortal.Ai — Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://sysdba:CHANGE_ME@localhost:5432/dev_render
TENANT_DATABASE_TEMPLATE=postgresql://sysdba:CHANGE_ME@localhost:5432/dev_render_{0}

# ── RHPortal.Ai — OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── RHPortal.Ai — Matching ───────────────────────────────────────────────────
MATCH_TOP_K=100
DEFAULT_RANKING_SIZE=20
ENABLE_PGVECTOR=true

# ── LioTecnica.Web.Next (build-time args) ────────────────────────────────────
# ⚠️ Essas variáveis são injetadas no BUILD, não no runtime.
# No pipeline, passe como --build-arg ao docker build.
NEXT_PUBLIC_API_BASE=https://api.your-domain.com
NEXT_PUBLIC_PORTAL_ORIGIN=https://your-domain.com
