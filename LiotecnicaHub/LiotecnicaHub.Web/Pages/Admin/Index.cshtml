@page
@model LiotecnicaHub.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Administração";
    ViewData["ShowHubTopbar"] = false;
}

<section class="page-header">
    <h1>Painel administrativo</h1>
    <p>Gerencie quem abre quais aplicativos no launcher. Perfis internos ficam em cada sistema.</p>
</section>

<div class="admin-grid">
    <a class="admin-card" asp-page="/Admin/Users/Index">
        <h2>Usuários</h2>
        <p class="admin-stat">@Model.UserCount usuário(s)</p>
        <span class="admin-link">Acessos a aplicativos →</span>
    </a>
    <a class="admin-card" asp-page="/Admin/Applications/Index">
        <h2>Aplicativos</h2>
        <p class="admin-stat">@Model.ApplicationCount cadastrado(s)</p>
        <span class="admin-link">Gerenciar →</span>
    </a>
    <a class="admin-card" asp-page="/Admin/Access/Index">
        <h2>Controle de Acessos</h2>
        <p class="admin-stat">Visão consolidada</p>
        <span class="admin-link">Consultar →</span>
    </a>
    <a class="admin-card" asp-page="/Admin/Audit/Index">
        <h2>Auditoria</h2>
        <p class="admin-stat">Histórico de alterações</p>
        <span class="admin-link">Ver registros →</span>
    </a>
    <a class="admin-card" asp-page="/Admin/EntraConfig">
        <h2>Microsoft Entra ID</h2>
        <p class="admin-stat">@(Model.EntraConfigured ? "Habilitado" : "Pendente de configuração")</p>
        <span class="admin-link">Configurar →</span>
    </a>
    <a class="admin-card" asp-page="/Admin/LdapConfig">
        <h2>Active Directory / LDAP</h2>
        <p class="admin-stat">@(Model.LdapConfigured ? "Habilitado" : "Pendente de configuração")</p>
        <span class="admin-link">Configurar →</span>
    </a>
    <div class="admin-card admin-card-static">
        <h2>Administradores Hub</h2>
        <p class="admin-stat">@Model.AdminCount e-mail(s) com acesso admin</p>
        <small>Admins veem todos os apps e configuram o Hub via variável de ambiente no deploy.</small>
    </div>
</div>
