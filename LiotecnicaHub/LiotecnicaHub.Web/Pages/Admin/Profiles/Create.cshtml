@page
@model LiotecnicaHub.Web.Pages.Admin.Profiles.CreateModel
@{
    ViewData["Title"] = "Novo perfil";
}

<section class="page-header">
    <h1>Novo perfil</h1>
</section>

<form method="post" class="form-card form-card-wide">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <label asp-for="Input.Name">Nome</label>
    <input asp-for="Input.Name" class="form-control" />

    <label asp-for="Input.Code">Código</label>
    <input asp-for="Input.Code" class="form-control" placeholder="ex.: consultor-externo (opcional — gerado do nome)" />

    <label asp-for="Input.Description">Descrição</label>
    <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>

    <label class="checkbox-row">
        <input asp-for="Input.IsActive" type="checkbox" />
        Perfil ativo
    </label>

    <h2 class="form-section-title">Sistemas liberados</h2>
    <p class="hub-access-muted">Marque os sistemas que usuários com este perfil podem abrir no launcher.</p>
    @{
        ViewData["FieldName"] = "Input.SelectedSystemIds";
        ViewData["SelectedIds"] = Model.Input.SelectedSystemIds;
    }
    <partial name="../Shared/_CheckboxGrid" model="Model.SystemOptions" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-page="Index">Cancelar</a>
    </div>
</form>

<p><a asp-page="Index">← Voltar à lista</a></p>
