@page "{id:guid}"
@model LiotecnicaHub.Web.Pages.Admin.Profiles.DeleteModel
@{
    ViewData["Title"] = "Excluir perfil";
}

<section class="page-header">
    <h1>Excluir perfil</h1>
</section>

@if (Model.Profile is null)
{
    <p>Perfil não encontrado.</p>
}
else
{
    <div class="form-card">
        <p>Confirma a exclusão do perfil <strong>@Model.Profile.Name</strong> (<code>@Model.Profile.Code</code>)?</p>

        @if (Model.IsBuiltIn)
        {
            <p class="alert alert-error">Este é um perfil padrão e não pode ser excluído.</p>
        }
        else
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">Excluir</button>
                    <a asp-page="Index">Cancelar</a>
                </div>
            </form>
        }
    </div>
}

<p><a asp-page="Index">← Voltar à lista</a></p>
