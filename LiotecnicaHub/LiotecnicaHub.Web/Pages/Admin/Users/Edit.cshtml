@page "{id:guid}"
@model LiotecnicaHub.Web.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Editar usuário";
}

<section class="page-header">
    <h1>Editar usuário</h1>
    <p>Perfis e permissões dentro de cada app (ex.: Portal RH) são gerenciados no próprio sistema.</p>
</section>

<form method="post" class="form-card form-card-wide">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <label asp-for="Input.Name">Nome</label>
    <input asp-for="Input.Name" class="form-control" />

    <label asp-for="Input.Email">E-mail</label>
    <input asp-for="Input.Email" class="form-control" type="email" />

    <label class="checkbox-row">
        <input asp-for="Input.IsActive" type="checkbox" />
        Usuário ativo
    </label>

    <h2 class="form-section-title">Senha local</h2>
    <p class="hub-access-muted">
        Login por e-mail e senha <strong>no Hub</strong> (independente do AD/LDAP).
        @if (Model.Input.HasLocalPassword)
        {
            <span>Este usuário possui senha local — o login LDAP/AD <strong>não</strong> será usado enquanto ela existir.</span>
        }
        else
        {
            <span>Sem senha local: login por e-mail usa LDAP (se habilitado) ou Microsoft SSO.</span>
        }
    </p>

    @if (Model.Input.HasLocalPassword)
    {
        <label class="checkbox-row">
            <input asp-for="Input.ClearLocalPassword" type="checkbox" />
            Remover senha local (passar a autenticar via LDAP/AD)
        </label>
    }

    <label asp-for="Input.NewPassword">Nova senha</label>
    <input asp-for="Input.NewPassword" class="form-control" type="password" autocomplete="new-password" />

    <label class="checkbox-row">
        <input asp-for="Input.ResetPasswordToDefault" type="checkbox" />
        Resetar para senha padrão (@Model.DefaultPasswordHint)
    </label>

    <h2 class="form-section-title">Aplicativos liberados</h2>
    @{
        ViewData["FieldName"] = "Input.SelectedApplicationIds";
        ViewData["SelectedIds"] = Model.Input.SelectedApplicationIds;
    }
    <partial name="../Shared/_CheckboxGrid" model="Model.ApplicationOptions" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-page="Index">Cancelar</a>
    </div>
</form>

<p><a asp-page="Index">← Voltar à lista</a></p>
