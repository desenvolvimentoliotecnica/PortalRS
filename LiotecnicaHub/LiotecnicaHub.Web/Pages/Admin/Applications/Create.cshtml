@page
@model LiotecnicaHub.Web.Pages.Admin.Applications.CreateModel
@{
    ViewData["Title"] = "Novo aplicativo";
}

<section class="page-header">
    <h1>Novo aplicativo</h1>
</section>

<form method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <label asp-for="Input.Name">Nome</label>
    <input asp-for="Input.Name" class="form-control" />
    <span asp-validation-for="Input.Name" class="field-error"></span>

    <label asp-for="Input.Description">Descrição</label>
    <textarea asp-for="Input.Description" class="form-control" rows="2"></textarea>

    <label asp-for="Input.LaunchUrl">URL de abertura</label>
    <input asp-for="Input.LaunchUrl" class="form-control" />
    <span asp-validation-for="Input.LaunchUrl" class="field-error"></span>

    <label asp-for="Input.IconUrl">URL do ícone (opcional)</label>
    <input asp-for="Input.IconUrl" class="form-control" />

    <label asp-for="Input.Environment">Ambiente</label>
    <select asp-for="Input.Environment" asp-items="Model.EnvironmentOptions" class="form-control"></select>

    <label asp-for="Input.SortOrder">Ordem</label>
    <input asp-for="Input.SortOrder" class="form-control" type="number" />

    <label class="checkbox-row">
        <input asp-for="Input.IsActive" type="checkbox" />
        Ativo
    </label>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-page="Index">Cancelar</a>
    </div>
</form>
