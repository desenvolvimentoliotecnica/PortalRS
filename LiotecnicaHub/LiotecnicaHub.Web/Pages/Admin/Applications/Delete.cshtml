@page "{id:guid}"
@model LiotecnicaHub.Web.Pages.Admin.Applications.DeleteModel
@{
    ViewData["Title"] = "Excluir aplicativo";
}

<section class="page-header">
    <h1>Excluir aplicativo</h1>
</section>

@if (Model.Application is not null)
{
    <div class="form-card">
        <p>Confirma a exclusão de <strong>@Model.Application.Name</strong>?</p>
        <form method="post">
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Excluir</button>
                <a asp-page="Index">Cancelar</a>
            </div>
        </form>
    </div>
}
