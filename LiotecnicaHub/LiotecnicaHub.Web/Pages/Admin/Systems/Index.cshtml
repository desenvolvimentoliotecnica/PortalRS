@page
@model LiotecnicaHub.Web.Pages.Admin.Systems.IndexModel
@{
    ViewData["Title"] = "Sistemas IAM";
}

<section class="page-header row-between">
    <div>
        <h1>Sistemas IAM</h1>
        <p>Catálogo de sistemas que perfis podem liberar no launcher. Aplicativos são vinculados a um sistema.</p>
    </div>
    <a class="btn btn-primary" asp-page="Create">Novo sistema</a>
</section>

<table class="data-table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Código</th>
            <th>Apps</th>
            <th>Perfis</th>
            <th>Ativo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var system in Model.Systems)
        {
            <tr>
                <td>
                    <strong>@system.Name</strong>
                    @if (system.IsBuiltIn)
                    {
                        <div class="hub-access-muted">Sistema padrão</div>
                    }
                </td>
                <td><code>@system.Code</code></td>
                <td>@system.ApplicationCount</td>
                <td>@system.ProfileAccessCount</td>
                <td>@(system.IsActive ? "Sim" : "Não")</td>
                <td class="table-actions">
                    <a asp-page="Edit" asp-route-id="@system.Id">Editar</a>
                    @if (!system.IsBuiltIn && system.ApplicationCount == 0)
                    {
                        <a asp-page="Delete" asp-route-id="@system.Id">Excluir</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<p><a asp-page="/Admin/Index">← Voltar ao painel</a></p>
