@page
@model LiotecnicaHub.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Entrar";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar — Liotecnica Hub</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <h1>Liotecnica Hub</h1>
            <p>Acesse os aplicativos corporativos com sua conta.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        @if (Model.PasswordLoginEnabled)
        {
            <form method="post" asp-page-handler="Password" class="dev-login-form">
                <label for="LoginEmail">E-mail</label>
                <input type="email" id="LoginEmail" name="LoginEmail" asp-for="LoginEmail"
                       placeholder="seu.email@liotecnica.com.br" required autocomplete="username" />

                <label for="LoginPassword">Senha</label>
                <input type="password" id="LoginPassword" name="LoginPassword" asp-for="LoginPassword"
                       required autocomplete="current-password" />

                <button type="submit" class="btn btn-primary btn-block">Entrar</button>
            </form>
        }

        @if (Model.EntraEnabled)
        {
            @if (Model.PasswordLoginEnabled)
            {
                <p class="login-divider">ou</p>
            }
            <a class="btn btn-microsoft" asp-page-handler="Microsoft">
                <span class="ms-icon" aria-hidden="true"></span>
                Entrar com Microsoft
            </a>
        }
        else if (!Model.PasswordLoginEnabled)
        {
            <div class="alert alert-warn">
                O login ainda não foi habilitado. Contate o administrador.
            </div>
        }
    </div>
</body>
</html>
