@using LiotecnicaHub.Web.Domain.Entities
@model HubApplication

@if (!string.IsNullOrWhiteSpace(Model.IconUrl))
{
    <img class="hub-card-icon-img" src="@Model.IconUrl" alt="" />
}
else
{
    var key = HubUiHelpers.ResolveAppIconKey(Model.Name);
    @switch (key)
    {
        case "portal-rh":
            <svg class="hub-card-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
            break;
        case "totvs":
            <svg class="hub-card-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="12" cy="12" r="4"/></svg>
            break;
        case "intranet":
            <svg class="hub-card-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20"/></svg>
            break;
        case "ti":
            <svg class="hub-card-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 11h2l2-7h10l2 7h2"/><path d="M7 18a2 2 0 104 0M13 18a2 2 0 104 0"/></svg>
            break;
        case "docs":
            <svg class="hub-card-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8M8 9h2"/></svg>
            break;
        case "bi":
            <svg class="hub-card-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 19V5M10 19V9M16 19v-6M22 19H2"/></svg>
            break;
        case "finance":
            <svg class="hub-card-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 10h4.5a2.5 2.5 0 010 5H9"/></svg>
            break;
        case "training":
            <svg class="hub-card-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M22 10l-10-5L2 10l10 5 10-5z"/><path d="M6 12v5c0 2 12 3 12 3s12-1 12-3v-5"/></svg>
            break;
        default:
            <svg class="hub-card-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h6v6H9z"/></svg>
            break;
    }
}
