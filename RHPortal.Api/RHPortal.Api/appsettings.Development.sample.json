{
  "_comment": "Template de desenvolvimento — copie para appsettings.Development.json e preencha os valores locais. NUNCA commite o arquivo real (está no .gitignore).",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=dev_render;Username=postgres;Password=__POSTGRES_PASSWORD__",
    "Master": "Host=localhost;Port=5432;Database=dev_render_master;Username=postgres;Password=__POSTGRES_PASSWORD__",
    "TenantTemplate": "Host=localhost;Port=5432;Database=dev_render_{0};Username=postgres;Password=__POSTGRES_PASSWORD__"
  },
  "Database": {
    "Environment": "dev",
    "SystemName": "render"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Information",
      "RhPortal.Api.Infrastructure.Tenancy": "Debug",
      "RhPortal.Api.Auditing": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Ops": {
    "ResetKey": "__CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_RESET_KEY__"
  },
  "Seed": {
    "ResetDatabase": false,
    "AdminPassword": "__ADMIN_PASSWORD__",
    "OwnerEmail": "owner@dev.local",
    "OwnerPassword": "__OWNER_PASSWORD__",
    "Enabled": true,
    "RandomSeed": 42,
    "Managers": {
      "Count": 10
    },
    "AgendaEvents": {
      "Count": 10
    },
    "EmailMessages": {
      "Count": 40
    },
    "Vagas": {
      "Enabled": false,
      "Count": 50,
      "PatternsFile": "Infrastructure/Data/SeedData/vaga-patterns.json",
      "RequirementsFile": "Infrastructure/Data/SeedData/vaga-requisitos.json"
    },
    "Candidatos": {
      "Enabled": false,
      "Count": 50,
      "PerVaga": 1
    },
    "InboxItems": {
      "Enabled": false,
      "Count": 3
    },
    "Tenants": {
      "liotecnica": {
        "InboxItems": {
          "Enabled": false,
          "Count": 3
        }
      },
      "dev": {
        "InboxItems": {
          "Enabled": false,
          "Count": 3
        }
      }
    }
  },
  "Jwt": {
    "Issuer": "RhPortal",
    "Audience": "RhPortal",
    "SigningKey": "__CHANGE_THIS_TO_A_STRONG_SIGNING_KEY_AT_LEAST_32_CHARS__",
    "AccessTokenExpirationMinutes": 1440
  },
  "InboxFolder": {
    "RootPath": "App_Data/Inbox",
    "IncomingFolderName": "incoming",
    "ProcessedFolderName": "processado",
    "ErrorFolderName": "erro",
    "RetryDelayMs": 800,
    "RetryCount": 6
  },
  "Cors": {
    "WebOrigin": "http://localhost:5051,http://localhost:3005"
  },
  "EmailConfig": {
    "EncryptionKey": "__GENERATE_WITH_openssl_rand_hex_32__"
  },
  "RhAi": {
    "BaseUrl": "http://localhost:8000",
    "DefaultRuleVersion": "v1_80_20",
    "TenantRuleVersions": {
      "liotecnica": "v2_65_35_strict"
    }
  },
  "SlaVaga": {
    "DiasMetaFechamento": 30,
    "DiasMetaUrgente": 15,
    "DiasMetaPrioridadeBaixa": 45,
    "DiasMetaPrioridadeMedia": 30,
    "DiasMetaPrioridadeAlta": 20,
    "DiasMetaPrioridadeCritica": 10
  },
  "Ai": {
    "OpenAI": {
      "ApiKey": "__OPENAI_API_KEY__",
      "DefaultModel": "gpt-4o-mini"
    }
  }
}
