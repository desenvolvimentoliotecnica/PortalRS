-- Steps (grade percentual 80-120% em incrementos de 10)
INSERT INTO "CategoriaSalarialSteps" ("Id","TenantId","CategoriaSalarialId","Percentual","Ordem","CreatedAtUtc","UpdatedAtUtc")
SELECT gen_random_uuid(),'liotecnica', cs."Id", p::numeric, ROW_NUMBER() OVER (PARTITION BY cs."Id" ORDER BY p), now(), now()
FROM "CategoriasSalariais" cs
CROSS JOIN (VALUES (80),(90),(100),(110),(120)) AS steps(p)
WHERE cs."Id"::text LIKE 'aaaaaaaa-8%';

