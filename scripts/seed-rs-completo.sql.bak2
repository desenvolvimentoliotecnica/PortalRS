        'Liotecnica Comercial SP', true,
        '04551-065','Av. Juscelino Kubitschek','1909','Vila Nova Conceição','São Paulo','SP',
        -23.5896, -46.6848, now(),
        now(), now())
ON CONFLICT DO NOTHING;

