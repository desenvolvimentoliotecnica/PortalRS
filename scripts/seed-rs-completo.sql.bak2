-- ═══════════════════════════════════════════════════════════════════════════
-- RESUMO DO QUE FOI CRIADO
-- ═══════════════════════════════════════════════════════════════════════════
SELECT 'Empresas (total)'     AS entidade, COUNT(*) FROM "Empresas"
UNION ALL SELECT 'CentrosCusto', COUNT(*) FROM "CentrosCusto"
UNION ALL SELECT 'Turnos', COUNT(*) FROM "Turnos"
UNION ALL SELECT 'CategoriasSalariais', COUNT(*) FROM "CategoriasSalariais"
UNION ALL SELECT 'CategoriaSalarialSteps', COUNT(*) FROM "CategoriaSalarialSteps"
UNION ALL SELECT 'DescricoesCargo', COUNT(*) FROM "DescricoesCargo"
UNION ALL SELECT 'DescricaoCargoItens', COUNT(*) FROM "DescricaoCargoItens"
UNION ALL SELECT 'NotificacoesTemplates', COUNT(*) FROM "NotificacoesTemplates"
UNION ALL SELECT 'Vagas', COUNT(*) FROM "Vagas"
UNION ALL SELECT 'Pessoas', COUNT(*) FROM "Pessoas"
UNION ALL SELECT 'Talentos', COUNT(*) FROM "Talentos"
UNION ALL SELECT 'Candidatos', COUNT(*) FROM "Candidatos"
UNION ALL SELECT 'Candidaturas', COUNT(*) FROM "Candidaturas"
UNION ALL SELECT 'PropostasVaga', COUNT(*) FROM "PropostasVaga";
