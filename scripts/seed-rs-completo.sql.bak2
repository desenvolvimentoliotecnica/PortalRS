-- ═══════════════════════════════════════════════════════════════════════════
-- 10. TALENTOS (1:1 com Pessoa)
-- ═══════════════════════════════════════════════════════════════════════════
INSERT INTO "Talentos" ("Id","TenantId","PessoaId","Origem","Versao","CreatedAtUtc","UpdatedAtUtc")
SELECT REPLACE(p."Id"::text, '-1', '-2')::uuid, p."TenantId", p."Id", 2, 1, now(), now()
FROM "Pessoas" p
WHERE p."Id"::text LIKE 'bbbbbbbb-1%' OR p."Id"::text LIKE 'cccccccc-1%' OR p."Id"::text LIKE 'dddddddd-1%';

-- ═══════════════════════════════════════════════════════════════════════════
-- 11. CANDIDATOS (vinculados a vagas específicas)
-- ═══════════════════════════════════════════════════════════════════════════
INSERT INTO "Candidatos" ("Id","TenantId","Nome","Email","Fone","Cidade","Uf",
                          "Fonte","Status","VagaId","TalentoId",
                          "CvText","ResumoProfissional",
                          "PretensaoSalarial","TrabalhandoAtualmente",
                          "CreatedAtUtc","UpdatedAtUtc")
SELECT REPLACE(p."Id"::text, '-1', '-3')::uuid, p."TenantId", p."Nome", p."Email", p."Fone", p."Cidade", p."Uf",
       4 /* Site */,
       CASE
         WHEN p."Id"::text LIKE '%-1001-%' THEN 2 /* Aprovado */
         WHEN p."Id"::text LIKE '%-1002-%' THEN 1 /* Triagem */
         ELSE 0 /* Novo */
       END,
       CASE
         WHEN p."Id"::text LIKE 'bbbbbbbb-%' THEN 'bbbbbbbb-aaaa-4000-8000-000000000001'::uuid
         WHEN p."Id"::text LIKE 'cccccccc-%' THEN 'cccccccc-aaaa-4000-8000-000000000001'::uuid
         WHEN p."Id"::text LIKE 'dddddddd-%' THEN 'dddddddd-aaaa-4000-8000-000000000001'::uuid
       END AS vagaId,
       REPLACE(p."Id"::text, '-1', '-2')::uuid AS talentoId,
       p."ResumoProfissional" AS cvText,
       LEFT(p."ResumoProfissional", 150) AS resumo,
       CASE
         WHEN p."Id"::text LIKE 'bbbbbbbb-%' THEN 4400
         WHEN p."Id"::text LIKE 'cccccccc-%' THEN 7000
         ELSE 2600
       END,
       false,
       now(), now()
FROM "Pessoas" p
WHERE p."Id"::text LIKE 'bbbbbbbb-1%' OR p."Id"::text LIKE 'cccccccc-1%' OR p."Id"::text LIKE 'dddddddd-1%';

