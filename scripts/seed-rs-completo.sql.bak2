-- ═══════════════════════════════════════════════════════════════════════════
-- SEED COMPLETO — Recrutamento & Seleção + Matching por IA
-- ═══════════════════════════════════════════════════════════════════════════
-- Popula tudo necessário para testar 100% das features do módulo R&S:
--   • 2 Empresas geocodificadas (Embu + Alphaville)
--   • 4 Centros de Custo (TI/Financeiro/Produção/RH)
--   • 3 Turnos (Comercial + 2 turnos de produção)
--   • 4 Categorias Salariais com grade percentual (Steps 80-120%)
--   • 4 Descrições de Cargo DNALIO completas (36+ itens cada)
--   • 5 Templates de Notificação (uma por etapa macro)
--   • 5 Vagas em estados diferentes (Aberta/Triagem/Entrevistas/Rascunho/Preenchida)
--   • 12 Pessoas/Candidatos com CVs diversificados (4 perfis por vaga)
--   • 15 Candidaturas cobrindo TODAS as etapas macro do funil
--   • 3 Propostas de Vaga (Pendente/Aceita/Recusada)
--
-- CENÁRIOS COBERTOS:
--   ✓ Matching léxico + híbrido IA (bge-m3 + Qwen 2.5)
--   ✓ Kanban com SLA semáforo (verde/amarelo/vermelho)
--   ✓ Funil de conversão (todas as etapas populadas)
--   ✓ Bulk actions (múltiplos cards em cada coluna)
--   ✓ Sugestão salarial via IA (vagas similares + categorias internas)
--   ✓ Gerador de DescCargo (contexto-rico com histórico)
--   ✓ Chatbot RAG (4 descrições indexáveis)
--
-- IDEMPOTENTE: DELETE + INSERT por IDs determinísticos. Pode rodar N vezes.
--
-- CONVENÇÃO DE IDs:
--   aaaaaaaa-*  → Vaga Assistente Suporte Técnico (já existia)
--   bbbbbbbb-*  → Vaga Analista Financeiro
--   cccccccc-*  → Vaga Analista RH
--   dddddddd-*  → Vaga Operador Produção
--   eeeeeeee-*  → Vaga Analista Suporte Sênior (Rascunho)
--   ffffffff-*  → Vaga 5 encerrada (pra funil histórico)
--
-- Pré-requisito: seed-vaga-simulacao.sql já rodado (cria Vaga Assistente + 4 cands)
-- ═══════════════════════════════════════════════════════════════════════════

BEGIN;

SET client_min_messages TO WARNING;

-- ═══════════════════════════════════════════════════════════════════════════
-- 1. LIMPEZA IDEMPOTENTE (ordem reversa de FK)
-- ═══════════════════════════════════════════════════════════════════════════

-- Candidaturas primeiro (FK Candidatos + Vagas)
DELETE FROM "CandidaturaEtapaHistoricos" WHERE "CandidaturaId" IN (
  SELECT "Id" FROM "Candidaturas" WHERE "Id"::text LIKE 'bbbbbbbb-%' OR "Id"::text LIKE 'cccccccc-%' OR "Id"::text LIKE 'dddddddd-%');
DELETE FROM "PropostasVaga"     WHERE "Id"::text LIKE 'bbbbbbbb-%' OR "Id"::text LIKE 'cccccccc-%' OR "Id"::text LIKE 'dddddddd-%';
DELETE FROM "Candidaturas"      WHERE "Id"::text LIKE 'bbbbbbbb-%' OR "Id"::text LIKE 'cccccccc-%' OR "Id"::text LIKE 'dddddddd-%';
DELETE FROM "CandidatoCompetencias" WHERE "CandidatoId" IN (
  SELECT "Id" FROM "Candidatos" WHERE "Id"::text LIKE 'bbbbbbbb-%' OR "Id"::text LIKE 'cccccccc-%' OR "Id"::text LIKE 'dddddddd-%');
DELETE FROM "Candidatos"        WHERE "Id"::text LIKE 'bbbbbbbb-%' OR "Id"::text LIKE 'cccccccc-%' OR "Id"::text LIKE 'dddddddd-%';
DELETE FROM "Talentos"          WHERE "Id"::text LIKE 'bbbbbbbb-%' OR "Id"::text LIKE 'cccccccc-%' OR "Id"::text LIKE 'dddddddd-%';
DELETE FROM "Pessoas"           WHERE "Id"::text LIKE 'bbbbbbbb-%' OR "Id"::text LIKE 'cccccccc-%' OR "Id"::text LIKE 'dddddddd-%';

-- Vagas
DELETE FROM "Vagas" WHERE "Id"::text LIKE 'bbbbbbbb-%' OR "Id"::text LIKE 'cccccccc-%'
                       OR "Id"::text LIKE 'dddddddd-%' OR "Id"::text LIKE 'eeeeeeee-%'
                       OR "Id"::text LIKE 'ffffffff-%';

-- Descrições de Cargo (+ itens cascade)
DELETE FROM "DescricoesCargo" WHERE "Id"::text LIKE 'bbbbbbbb-%' OR "Id"::text LIKE 'cccccccc-%' OR "Id"::text LIKE 'dddddddd-%';

-- Infra (só adiciona o que não existe)
DELETE FROM "CategoriaSalarialSteps" WHERE "CategoriaSalarialId" IN (
  SELECT "Id" FROM "CategoriasSalariais" WHERE "Id"::text LIKE 'aaaaaaaa-8%');
DELETE FROM "CategoriasSalariais"   WHERE "Id"::text LIKE 'aaaaaaaa-8%';
DELETE FROM "Turnos"                WHERE "Id"::text LIKE 'aaaaaaaa-7%';
DELETE FROM "CentrosCusto"          WHERE "Id"::text LIKE 'aaaaaaaa-cc%' AND "Id" != 'aaaaaaaa-cc01-4000-8000-000000000001';
DELETE FROM "Empresas"              WHERE "Code" = 'LIO-002';
DELETE FROM "NotificacoesTemplates" WHERE "Id"::text LIKE 'aaaaaaaa-9%';

-- ═══════════════════════════════════════════════════════════════════════════
-- 2. EMPRESAS
-- ═══════════════════════════════════════════════════════════════════════════
