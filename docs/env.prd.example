# Copiar para o servidor como ~/.env.prd e preencher valores reais.
# Usado por docker-compose.prd.yml para API + RHPortal.Ai.
# Nao commitar o arquivo real com segredos.

# --- RHPortal.Api ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# Multi-tenant PortalRH PRD.
ConnectionStrings__Master=Host=10.0.0.88;Port=5434;Database=portalrh_prd_master;Username=usr_portalrh_prd;Password=__PREENCHER__
ConnectionStrings__Default=Host=10.0.0.88;Port=5434;Database=portalrh_prd;Username=usr_portalrh_prd;Password=__PREENCHER__
ConnectionStrings__TenantTemplate=Host=10.0.0.88;Port=5434;Database=portalrh_prd_{0};Username=usr_portalrh_prd;Password=__PREENCHER__

Database__Environment=prd
Database__SystemName=render

AllowedHosts=*
Cors__WebOrigin=http://10.0.0.88:3000,http://10.0.0.88:3050
Navegacao__PortalVagasPublicUrl=http://10.0.0.88:3050
Frontend__BaseUrl=http://10.0.0.88:3000
Authentication__ApiBaseUrl=http://10.0.0.88:5000
RhAi__BaseUrl=http://rhportal-prd-ai:8000

Jwt__Issuer=RhPortal
Jwt__Audience=RhPortal
Jwt__SigningKey=__GERAR_CHAVE_FORTE_COM_32+_CARACTERES__
Jwt__AccessTokenExpirationMinutes=1440

Ops__ResetKey=__GERAR_SEGREDO_LONGO__

Seed__Enabled=true
Seed__ResetDatabase=false
Seed__OwnerEmail=owner@dev.local
Seed__OwnerPassword=__PREENCHER__
Seed__AdminPassword=__PREENCHER__
Seed__ApiKeys__0__TenantId=liotecnica
Seed__ApiKeys__0__Name=Integrador RM PRD
Seed__ApiKeys__0__Key=__PREENCHER__
Seed__ApiKeys__0__Description=Chave PRD para Liotecnica.Integration.RM
Seed__ApiKeys__0__IsActive=true

BootstrapTenants__0__TenantId=liotecnica
BootstrapTenants__0__Name=LioTecnica
BootstrapTenants__0__Enabled=true

InboxFolder__RootPath=/app/App_Data/Inbox
InboxFolder__IncomingFolderName=incoming
InboxFolder__ProcessedFolderName=processado
InboxFolder__ErrorFolderName=erro

Rm__ConnectionString=__CONNECTION_STRING_RM_SQLSERVER__
Portal__ApiKey=__MESMA_CHAVE_DE_Seed__ApiKeys__0__Key__
RmSolicitacaoStatusSync__Enabled=false
RmSolicitacaoStatusSync__IntervalMinutes=15
RmSolicitacaoStatusSync__MaxPerRun=50

BootstrapRmSync__Enabled=true
BootstrapRmSync__InitialDelaySeconds=120
BootstrapRmSync__RunOnlyWhenNoRmRuns=true
BootstrapRmSync__RmSyncTimeoutMinutes=240
BootstrapRmSync__Tenants__0__Enabled=true
BootstrapRmSync__Tenants__0__TenantId=liotecnica
BootstrapRmSync__Tenants__0__RunImport=true
BootstrapRmSync__Tenants__0__ForceFullImport=true
BootstrapRmSync__Tenants__0__RunGestoresRm=true
BootstrapRmSync__Tenants__0__GestoresRmUrlTemplate=http://172.19.30.37:8051/api/framework/v1/consultaSQLServer/RealizaConsulta/KNG.P.017/0/P/?parameters=CODCOLIGADA={CODCOLIGADA};CHAPA={CHAPA}
BootstrapRmSync__Tenants__0__GestoresRmUser=mestre
BootstrapRmSync__Tenants__0__GestoresRmPassword=__PREENCHER__
BootstrapRmSync__Tenants__0__GestoresRmDefaultCodColigada=1
BootstrapRmSync__Tenants__0__GestoresRmDelayMsBetweenRequests=250

BootstrapUsers__Enabled=true
BootstrapUsers__DefaultPassword=__PREENCHER__
BootstrapUsers__ResetPassword=true
BootstrapUsers__InitialDelaySeconds=180
BootstrapUsers__RetryDelaySeconds=60
BootstrapUsers__MaxAttempts=60

Ai__DefaultProvider=gemini
Ai__Gemini__ApiKey=__PREENCHER_SE_USAR_GEMINI__
Ai__Gemini__DefaultModel=gemini-2.5-flash
Ai__OpenAI__ApiKey=__PREENCHER_SE_USAR_OPENAI__

EmailConfig__EncryptionKey=__GERAR_HEX_64_CHARS__

# --- RHPortal.Ai ---
DATABASE_URL=postgresql://usr_portalrh_prd:__PREENCHER__@10.0.0.88:5434/portalrh_prd_liotecnica
TENANT_ID=liotecnica
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=__PREENCHER_SE_USAR_GEMINI__
OPENAI_API_KEY=__PREENCHER_SE_USAR_OPENAI__
