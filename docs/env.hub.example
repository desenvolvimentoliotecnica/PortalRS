# Liotecnica Hub — variáveis de ambiente (exemplo)
# Copie para .env.hub na raiz do repositório ao usar docker-compose.hub.yml

# PostgreSQL
HUB_POSTGRES_DB=liotecnica_hub
HUB_POSTGRES_USER=postgres
HUB_POSTGRES_PASSWORD=postgres
HUB_DB_PORT=5433

# Aplicação
HUB_HTTP_PORT=3010
HUB_ASPNETCORE_ENVIRONMENT=Production
HUB_BASE_URL=http://10.0.0.80:3010

# Segurança OAuth state (mín. 32 caracteres; use valor aleatório em produção)
HUB_STATE_SIGNING_KEY=troque-por-chave-secreta-longa-e-aleatoria

# E-mails com acesso admin (separados por vírgula; seed na primeira subida)
HUB_SEED_ADMIN_EMAILS=admin@liotecnica.com.br,seu.email@liotecnica.com.br

# Connection string alternativa (fora do compose)
# HUB_DB_CONNECTION=Host=localhost;Port=5433;Database=liotecnica_hub;Username=postgres;Password=postgres
