# Copiar para o servidor como ~/.env.hmg e preencher valores reais.
# Usado por docker-compose.hmg.yml para API + RHPortal.Ai (mesmo ficheiro nas duas — cada serviço só lê o que precisa).

# --- RHPortal.Api (prefixos ASP.NET Core — exemplo; alinhar ao teu ambiente) ---
# ASPNETCORE_ENVIRONMENT=Production
# ConnectionStrings__Master=...
# ConnectionStrings__Default=...
# (outras chaves conforme appsettings)

# --- RHPortal.Ai ---
# DATABASE_URL=postgresql://...
# OPENAI_API_KEY=
# TENANT_ID=
# LLM_PROVIDER=openai
